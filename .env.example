# =============================================================================
# Supabase — lead capture backend
# =============================================================================
# Get these from: Supabase dashboard → your project → Settings → API
# - SUPABASE_URL: the "Project URL"
# - SUPABASE_SERVICE_ROLE_KEY: the "service_role" secret (NOT the anon key)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# =============================================================================
# Resend — fallback email when Supabase is down (optional but recommended)
# =============================================================================
# RESEND_API_KEY: https://resend.com/api-keys
# LEAD_NOTIFY_EMAIL: where leads that could not be saved are emailed
# RESEND_FROM: verified sender (defaults to onboarding@resend.dev for testing)
# =============================================================================
RESEND_API_KEY=re_your_key
LEAD_NOTIFY_EMAIL=you@example.com
RESEND_FROM=Website <onboarding@resend.dev>
