---
import MorphIcon from "morphicons/astro";
import { Menu } from "lucide";

const currentPath = Astro.url.pathname;
const links = [
  { href: "/", label: "home" },
  { href: "/store", label: "store" },
  { href: "/wellness", label: "wellness" },
  { href: "/aboutme", label: "about me" },
];
---

<header
  data-nav-hider
  class="fixed inset-x-0 top-0 z-999 md:top-2 md:inset-auto md:left-1/2 md:-translate-x-1/2 md:w-max md:grid md:place-content-center transition-transform duration-300"
>
  <button
    id="menu-btn"
    type="button"
    class="lg:hidden absolute top-3 right-3 z-60 p-2 cursor-pointer inline-flex items-center justify-center w-11 h-11 rounded-full bg-angie-noir/60 backdrop-blur-md border border-white/20 text-white shadow-lg"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <MorphIcon icon={Menu} id="menu-icon" size={24} strokeWidth={2.5} />
  </button>

  <nav
    class="md:flex lg:max-w-200 font-Frauce relative text-white md:justify-center md:gap-1 md:px-4 md:rounded-full md:bg-angie-noir/40 md:backdrop-blur-xl md:border md:border-white/10 md:shadow-2xl md:shadow-black/30"
    aria-label="main navigation"
  >
    <ul
      id="mobile-menu"
      data-open="false"
      class="hidden md:flex flex-col items-center py-6 px-6 *:py-2 justify-center gap-3 fixed inset-0 bg-pink-nav-soft z-40
                   md:flex-row md:static md:justify-center md:gap-5 md:py-1 md:px-2 md:bg-transparent md:z-auto md:w-auto md:h-auto md:inset-auto
                   data-[open=true]:flex data-[open=true]:bg-pink-950
                    "
    >
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={currentPath === href ? "page" : undefined}
              class:list={["text-sm px-3 py-2 rounded-full transition",
              "text-white  hover:bg-white/5",
              currentPath === href && " bg-white/10",]}
            >
              {label}
            </a>
          </li>
        ))
      }

      <li id="Services" class="relative group/services rounded-full">
        <button
          type="button"
          id="services-btn"
          class="text-sm px-3 py-2 rounded-full transition cursor-pointer flex items-center gap-1 hover:bg-white/10"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="services-menu"
        >
          services
        </button>
        <div
          id="services-menu"
          role="menu"
          tabindex="-1"
          class="invisible opacity-0 -translate-y-1 flex flex-col items-stretch px-1.5 py-1.5 gap-1 rounded-2xl
                 absolute top-full left-1/2 -translate-x-1/2 mt-2 z-50
                 bg-angie-noir/95 backdrop-blur-xl border border-white/10 shadow-2xl text-white
                 transition-all duration-200
                 group-hover/services:visible group-hover/services:opacity-100 group-hover/services:translate-y-0 group-hover/services:translate-x-[-50%]
                 group-focus-within/services:visible group-focus-within/services:opacity-100 group-focus-within/services:translate-y-0 group-focus-within/services:translate-x-[-50%]
                 data-[services-open=true]:visible data-[services-open=true]:opacity-100 data-[services-open=true]:translate-y-0 data-[services-open=true]:translate-x-[-50%]
                 md:flex-row md:items-center md:rounded-full
                 *:text-sm *:px-3 *:py-2 *:rounded-full *:hover:bg-white/10 *:transition *:whitespace-nowrap *:text-center"
        >
          <a href="/services/coaching" role="menuitem">coaching</a>
          <a href="/services/keynote-speaking" role="menuitem">keynote</a>
          <a href="/services/podcast-guest" role="menuitem" class="text-balance">podcast guest</a>
        </div>
      </li>
    </ul>
  </nav>
</header>
<style>
    /* El control de visibilidad del mobile menu y del dropdown de services
       se hace 100% con data-attribute selectors de Tailwind v4 en el markup.
       No se necesita CSS adicional aquí. */
</style>

<script>
  import { Menu, X } from "lucide";
  import type { MorphIconElement } from "morphicons/element";

  // Astro usa <ClientRouter /> (View Transitions) en MainLayout.
  // Eso significa que al navegar entre paginas NO se recarga la pagina:
  // el DOM se actualiza in-place. Por eso envolvemos toda la logica
  // en initNav() y la re-ejecutamos en cada navegacion via
  // el evento "astro:page-load". Si no, los event listeners se
  // quedan atados al DOM viejo y desaparecen al navegar.
  //
  // Tambien guardamos la referencia del scroll handler a nivel de
  // modulo para poder removerlo en cada re-init (sino se acumulan
  // listeners duplicados en window cada vez que cambia la pagina).
  let scrollHandler: (() => void) | null = null;

  function initNav() {
    const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconEl = document.querySelector<MorphIconElement>("#menu-icon");
    const servicesBtn = document.getElementById("services-btn");
    const servicesMenu = document.getElementById("services-menu");
    const servicesLi = document.getElementById("Services");
    const header = document.querySelector<HTMLElement>("[data-nav-hider]");

    // Si los elementos requeridos no existen en esta pagina, salir.
    // (Todos deberian existir porque el NavBar esta en MainLayout, pero
    // es defensivo por si el NavBar se reusa sin la <ul> mobile-menu.)
    if (!btn || !menu || !iconEl || !servicesBtn || !servicesMenu || !servicesLi || !header) {
      return;
    }

    // Limpiar scroll handler previo (importante en View Transitions)
    if (scrollHandler) {
      window.removeEventListener("scroll", scrollHandler);
      scrollHandler = null;
    }
    // Siempre arrancar visible al cargar / cambiar de pagina
    header.classList.remove("nav-hidden");

    let open = false;
    let servicesToggled = false;
    // Detectar si el dispositivo soporta hover real (mouse/trackpad).
    // En touch puro (mobile/tablet) el :hover no aplica de forma persistente,
    // asi que el click en services-btn debe actuar como toggle.
    const hasHover = window.matchMedia("(hover: hover)").matches;

    const setOpen = (next: boolean) => {
      open = next;
      menu.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
      iconEl.morphTo(open ? X : Menu);
      if (!next) {
        // Al cerrar el menu principal, reseteamos tambien el dropdown de services
        servicesToggled = false;
        syncServicesExpanded();
      }
    };

    btn.addEventListener("click", () => setOpen(!open));

    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        if (open) setOpen(false);
      });
    });

    const syncServicesExpanded = () => {
      const hovered =
        servicesMenu.matches(":hover") || servicesBtn.matches(":hover");
      const focused =
        servicesBtn.matches(":focus") || servicesMenu.matches(":focus-within");
      const opened = hovered || focused || servicesToggled;
      servicesBtn.setAttribute("aria-expanded", String(opened));
      servicesMenu.dataset.servicesOpen = String(opened);
    };

    // Click en services-btn: en desktop el hover ya abre el menu,
    // asi que el click es no-op. En mobile (sin hover) toggle persistente.
    servicesBtn.addEventListener("click", (e) => {
      if (hasHover) return;
      e.preventDefault();
      e.stopPropagation();
      servicesToggled = !servicesToggled;
      syncServicesExpanded();
    });

    servicesBtn.addEventListener("focus", syncServicesExpanded);
    servicesBtn.addEventListener("blur", () =>
      queueMicrotask(syncServicesExpanded),
    );
    servicesMenu.addEventListener("mouseenter", syncServicesExpanded);
    servicesMenu.addEventListener("mouseleave", syncServicesExpanded);
    servicesMenu.addEventListener("focusin", syncServicesExpanded);
    servicesMenu.addEventListener("focusout", () =>
      queueMicrotask(syncServicesExpanded),
    );

    // Click fuera del LI de services cierra el dropdown (mobile)
    document.addEventListener("click", (e) => {
      if (!servicesLi.contains(e.target as Node)) {
        servicesToggled = false;
        syncServicesExpanded();
      }
    });

    // Click en un link del menu de services cierra el dropdown
    servicesMenu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        servicesToggled = false;
        syncServicesExpanded();
      });
    });

  
    const SCROLL_HIDE_THRESHOLD = 10; // solo ocultar despues de 10px de scroll
    const SHOW_AT_TOP = 10; // siempre visible cerca del top
    const SCROLL_DELTA = 2; // minimo delta para considerar scroll "intencional"

    let lastScrollY = window.scrollY;

    scrollHandler = () => {
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;

      // Siempre visible cerca del top de la pagina
      if (currentY < SHOW_AT_TOP) {
        header.classList.remove("nav-hidden");
        lastScrollY = currentY;
        return;
      }

      // Si el menu mobile esta abierto, no ocultar (sino el X
      // desaparece y el usuario no puede cerrar el menu)
      if (open) {
        lastScrollY = currentY;
        return;
      }

      // Scrolleando hacia abajo → ocultar
      if (delta > SCROLL_DELTA && currentY > SCROLL_HIDE_THRESHOLD) {
        header.classList.add("nav-hidden");
      }
      // Scrolleando hacia arriba → mostrar
      else if (delta < -SCROLL_DELTA) {
        header.classList.remove("nav-hidden");
      }

      lastScrollY = currentY;
    };

    window.addEventListener("scroll", scrollHandler, { passive: true });
  }

  // Carga inicial
  initNav();
  // Re-init en cada navegacion SPA (Astro View Transitions)
  document.addEventListener("astro:page-load", initNav);
</script>

<style is:global>
  #menu-btn morph-icon {
    color: white;
  }
  /* morphicons puede renderizar un <span> con el label del icono
     (aunque la prop label="" evite el texto, el span vacio se ve
     como una barrita arriba del icono). Lo ocultamos por defensa. */
  #menu-btn morph-icon > span {
    display: none !important;
  }
  /* CRÍTICO: backdrop-filter en el nav crea un nuevo containing block
     para position:fixed de sus hijos. Eso hace que el UL mobile-menu
     con fixed inset-0 se posicione relativo al nav (chiquito) y no
     al viewport. Cuando el menu está abierto, quitamos el backdrop
     del nav para que el UL pueda cubrir toda la pantalla. */
  nav[aria-label="main navigation"]:has(> #mobile-menu[data-open="true"]) {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  [data-nav-hider] {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-nav-hider].nav-hidden {
    transform: translateY(-100%);
    will-change: transform;
    pointer-events: none;
  }
  /* Accesibilidad: si el usuario pide reduced-motion, no animamos */
  @media (prefers-reduced-motion: reduce) {
    [data-nav-hider] {
      transition: none;
    }
  }
</style>
