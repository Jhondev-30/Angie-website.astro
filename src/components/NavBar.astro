---
import MorphIcon from "morphicons/astro";
import { Menu } from "lucide";

const currentPath = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/store", label: "Store" },
  { href: "/wellness", label: "Wellness" },
  { href: "/aboutme", label: "About me" },
  { href: "/resources", label: "Resources" },
];
const serviceLinks = [
  { href: "/services/coaching", label: "Coaching" },
  { href: "/services/keynote-speaking", label: "Keynote" },
  { href: "/services/podcast-guest", label: "Podcast guest" },
];
const bookUrl = "https://tidycal.com/angiepspeaks/30min-purpose-discoverycall";

const focus =
  "focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-angie-rose";
const item =
  "flex min-h-14 w-full items-center text-2xl font-Frauce font-semibold text-angie-cream " +
  "md:min-h-11 md:w-auto md:rounded-md md:px-3 md:font-Grotesk md:text-[0.95rem] md:font-medium " +
  "md:text-angie-cream/85 md:hover:text-angie-cream md:underline-offset-[0.55rem] " +
  "md:decoration-2 md:decoration-angie-rose md:aria-[current=page]:underline md:aria-[current=page]:text-angie-cream";
---

<header
  data-nav-hider
  class="fixed inset-x-0 top-0 z-999 border-b border-angie-cream/15 bg-angie-noir text-angie-cream"
>
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-6 px-5 md:px-8">
    <a
      href="/"
      class:list={["inline-flex min-h-11 items-center gap-3 rounded-md font-Frauce text-lg font-semibold", focus]}
    >
      <span
        aria-hidden="true"
        class="grid size-9 place-items-center rounded-md bg-angie-cream font-Frauce text-base font-bold text-angie-noir"
        >AP</span
      >
      <span>Angie Pichardo</span>
    </a>

    <button
      id="menu-btn"
      type="button"
      class:list={[
        "md:hidden inline-flex size-12 cursor-pointer items-center justify-center rounded-md border border-angie-cream/30 text-angie-cream transition-colors hover:bg-angie-cream/10",
        focus,
      ]}
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <MorphIcon icon={Menu} id="menu-icon" size={24} strokeWidth={2} />
    </button>

    <nav aria-label="main navigation" class="md:ml-auto">
      <ul
        id="mobile-menu"
        data-open="false"
        class="hidden data-[open=true]:flex fixed inset-x-0 top-16 bottom-0 z-40 flex-col overflow-y-auto bg-angie-noir px-5 pt-2 pb-10
               md:static md:flex md:flex-row md:items-center md:gap-1 md:overflow-visible md:bg-transparent md:p-0"
      >
        {
          links.map(({ href, label }) => (
            <li class="border-b border-angie-cream/15 md:border-0">
              <a
                href={href}
                aria-current={currentPath === href ? "page" : undefined}
                class:list={[item, focus]}
              >
                {label}
              </a>
            </li>
          ))
        }

        <li
          id="Services"
          class="group/services relative border-b border-angie-cream/15 md:flex md:h-16 md:items-center md:border-0"
        >
          <button
            type="button"
            id="services-btn"
            class:list={[item, "group/sb cursor-pointer justify-between gap-2 md:justify-start", focus]}
            aria-expanded="false"
            aria-controls="services-menu"
          >
            <span>Services</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="shrink-0 transition-transform duration-200 group-aria-expanded/sb:rotate-180"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div
            id="services-menu"
            class="hidden data-[services-open=true]:flex flex-col pb-3 pl-4
                   md:absolute md:top-full md:left-0 md:flex md:min-w-52 md:invisible md:translate-y-1 md:rounded-md md:border md:border-angie-cream/15 md:bg-angie-noir md:p-1.5 md:opacity-0 md:transition md:duration-150
                   md:group-hover/services:visible md:group-hover/services:translate-y-0 md:group-hover/services:opacity-100
                   md:group-focus-within/services:visible md:group-focus-within/services:translate-y-0 md:group-focus-within/services:opacity-100
                   md:data-[services-open=true]:visible md:data-[services-open=true]:translate-y-0 md:data-[services-open=true]:opacity-100"
          >
            {
              serviceLinks.map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={currentPath === href ? "page" : undefined}
                  class:list={[
                    "flex min-h-12 items-center rounded-md text-lg text-angie-cream/85 hover:text-angie-cream md:min-h-11 md:px-3 md:text-[0.95rem] md:hover:bg-angie-cream/10 aria-[current=page]:text-angie-cream aria-[current=page]:underline aria-[current=page]:decoration-angie-rose aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-4",
                    focus,
                  ]}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </li>

        <li class="pt-6 md:hidden">
          <a
            href={bookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["btn btn-light w-full", focus]}
          >
            Book a call
          </a>
        </li>
      </ul>
    </nav>

    <a
      href={bookUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={["btn btn-light hidden md:inline-flex min-h-11! py-2! px-5! text-sm", focus]}
    >
      Book a call
    </a>
  </div>
</header>

<script>
  import { Menu, X } from "lucide";
  import type { MorphIconElement } from "morphicons/element";

  // Astro uses <ClientRouter /> (View Transitions): the DOM is swapped
  // in-place, so the nav logic is re-run on every "astro:page-load".
  // Document/window level listeners share one AbortController so they
  // never stack up between navigations.
  let controller: AbortController | null = null;
  let scrollHandler: (() => void) | null = null;

  function initNav() {
    controller?.abort();
    controller = null;
    if (scrollHandler) {
      window.removeEventListener("scroll", scrollHandler);
      scrollHandler = null;
    }
    // Always release a scroll lock left over from a previous page.
    document.documentElement.style.overflow = "";

    const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconEl = document.querySelector<MorphIconElement>("#menu-icon");
    const servicesBtn = document.getElementById("services-btn");
    const servicesMenu = document.getElementById("services-menu");
    const servicesLi = document.getElementById("Services");
    const header = document.querySelector<HTMLElement>("[data-nav-hider]");

    if (!btn || !menu || !iconEl || !servicesBtn || !servicesMenu || !servicesLi || !header) {
      return;
    }

    const ac = new AbortController();
    controller = ac;
    const { signal } = ac;

    header.classList.remove("nav-hidden");

    let open = false;
    let servicesToggled = false;
    const hasHover = window.matchMedia("(hover: hover)").matches;
    const desktop = window.matchMedia("(min-width: 768px)");

    const syncServicesExpanded = () => {
      const hovered = servicesMenu.matches(":hover") || servicesBtn.matches(":hover");
      const focused = servicesBtn.matches(":focus") || servicesMenu.matches(":focus-within");
      const opened = hovered || focused || servicesToggled;
      servicesBtn.setAttribute("aria-expanded", String(opened));
      servicesMenu.dataset.servicesOpen = String(opened);
    };

    const setOpen = (next: boolean) => {
      open = next;
      menu.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      iconEl.morphTo(open ? X : Menu);
      // Scroll lock while the full-screen menu is open
      document.documentElement.style.overflow = open ? "hidden" : "";
      if (!open) {
        servicesToggled = false;
        syncServicesExpanded();
      }
    };

    btn.addEventListener("click", () => setOpen(!open), { signal });

    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener(
        "click",
        () => {
          if (open) setOpen(false);
        },
        { signal },
      );
    });

    // Services: on hover devices hover/focus opens it; on touch it toggles.
    servicesBtn.addEventListener(
      "click",
      (e) => {
        if (hasHover && desktop.matches) return;
        e.preventDefault();
        e.stopPropagation();
        servicesToggled = !servicesToggled;
        syncServicesExpanded();
      },
      { signal },
    );
    servicesBtn.addEventListener("focus", syncServicesExpanded, { signal });
    servicesBtn.addEventListener("blur", () => queueMicrotask(syncServicesExpanded), { signal });
    servicesMenu.addEventListener("mouseenter", syncServicesExpanded, { signal });
    servicesMenu.addEventListener("mouseleave", syncServicesExpanded, { signal });
    servicesMenu.addEventListener("focusin", syncServicesExpanded, { signal });
    servicesMenu.addEventListener("focusout", () => queueMicrotask(syncServicesExpanded), { signal });

    document.addEventListener(
      "click",
      (e) => {
        if (!servicesLi.contains(e.target as Node)) {
          servicesToggled = false;
          syncServicesExpanded();
        }
      },
      { signal },
    );

    servicesMenu.querySelectorAll("a").forEach((a) => {
      a.addEventListener(
        "click",
        () => {
          servicesToggled = false;
          syncServicesExpanded();
        },
        { signal },
      );
    });

    // Escape closes the menu (and returns focus to the toggle button)
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key !== "Escape") return;
        if (open) {
          setOpen(false);
          btn.focus();
        } else if (servicesToggled || servicesLi.contains(document.activeElement)) {
          servicesToggled = false;
          (document.activeElement as HTMLElement | null)?.blur();
          syncServicesExpanded();
        }
      },
      { signal },
    );

    // Leaving the mobile layout while open: release the lock
    desktop.addEventListener(
      "change",
      () => {
        if (desktop.matches && open) setOpen(false);
      },
      { signal },
    );

    // Auto-hide on scroll only where there is a real pointer
    const SCROLL_DELTA = 2;
    const SHOW_AT_TOP = 10;
    let lastScrollY = window.scrollY;

    scrollHandler = () => {
      const currentY = window.scrollY;
      if (!hasHover || open || currentY < SHOW_AT_TOP) {
        header.classList.remove("nav-hidden");
        lastScrollY = currentY;
        return;
      }
      const delta = currentY - lastScrollY;
      if (delta > SCROLL_DELTA) header.classList.add("nav-hidden");
      else if (delta < -SCROLL_DELTA) header.classList.remove("nav-hidden");
      lastScrollY = currentY;
    };

    window.addEventListener("scroll", scrollHandler, { passive: true });
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>

<style is:global>
  #menu-btn morph-icon {
    color: currentColor;
  }
  /* morphicons may render an empty <span> label above the icon */
  #menu-btn morph-icon > span {
    display: none !important;
  }

  [data-nav-hider] {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-nav-hider].nav-hidden {
    transform: translateY(-100%);
    will-change: transform;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-nav-hider] {
      transition: none;
    }
  }
</style>
