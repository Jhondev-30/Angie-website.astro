---
const currentYear = new Date().getFullYear();

const resources = [
  { href: "/", label: "home" },
  { href: "/aboutme", label: "about me" },
  { href: "/store", label: "store" },
  { href: "/services/coaching", label: "coaching" },
  { href: "/services/keynote-speaking", label: "keynote speaking" },
  { href: "/services/podcast-guest", label: "podcast guest" },
  { href: "/yoga", label: "yoga" },
];

const repoUrl = "https://github.com/Jhondev-30/Angie-website.astro.git";
const githubUrl = "https://github.com/Jhondev-30";
const linkedinUrl = "https://www.linkedin.com/in/jhon-cordero/";

// Angie's real social profiles (verified public URLs)
const angieInstagram = "https://www.instagram.com/angie.p.speaks";
const angieFacebook = "https://www.facebook.com/people/Angie-Pichardo/61579911753681/";
const angieLinkedin = "https://www.linkedin.com/in/angie-pichardo";
const angieYoutube = "https://www.youtube.com/@angie.p.speaks";
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden">
  <symbol id="icon-github" viewBox="0 0 24 24">
    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/>
  </symbol>
  <symbol id="icon-linkedin" viewBox="0 0 24 24">
    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
  </symbol>
  <symbol id="icon-instagram" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
  </symbol>
  <symbol id="icon-facebook" viewBox="0 0 24 24">
    <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
  </symbol>
  <symbol id="icon-youtube" viewBox="0 0 24 24" fill="currentColor">
    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
  </symbol>
</svg>

<footer
  class="font-Frauce w-full bg-linear-to-br from-angie-noir via-angie-wine to-angie-burgundy text-angie-cream"
>
  <div class="mx-auto w-full max-w-7xl px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <h2 class="text-2xl lg:text-3xl font-semibold leading-tight">
          Designed with care, built with love.
        </h2>
        <p class="mt-4 text-sm text-angie-cream/80 leading-relaxed">
          A space dedicated to wellbeing, balance and inner growth.
        </p>
        <p class="mt-6 text-sm text-angie-cream/90">
          Developed by 
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold underline decoration-angie-rose/60 underline-offset-4 hover:text-angie-rose transition-colors"
          >
            Jhon Cordero
          </a>
        </p>
      </div>

      <div>
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-widest text-angie-rose">
          Resources
        </h2>
        <ul class="space-y-3 text-sm font-medium">
          {
            resources.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-angie-cream/90 hover:text-angie-rose transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-widest text-angie-rose">
          Follow up
        </h2>
        <ul class="space-y-3 text-sm font-medium">
          <li>
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-angie-cream/90 hover:text-angie-rose transition-colors inline-flex items-center gap-2 break-all"
            >
              <svg width="16" height="16" aria-hidden="true" class="shrink-0"><use href="#icon-github" /></svg>
              <span>Source repository</span>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-widest text-angie-rose">
          Connect
        </h2>
        <ul class="space-y-3 text-sm font-medium">
          <li>
            <a
              href={angieInstagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-angie-cream/90 hover:text-angie-rose transition-colors inline-flex items-center gap-2"
            >
              <svg width="16" height="16" aria-hidden="true" class="shrink-0"><use href="#icon-instagram" /></svg>
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a
              href={angieFacebook}
              target="_blank"
              rel="noopener noreferrer"
              class="text-angie-cream/90 hover:text-angie-rose transition-colors inline-flex items-center gap-2"
            >
              <svg width="16" height="16" aria-hidden="true" class="shrink-0"><use href="#icon-facebook" /></svg>
              <span>Facebook</span>
            </a>
          </li>
          <li>
            <a
              href={angieLinkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-angie-cream/90 hover:text-angie-rose transition-colors inline-flex items-center gap-2"
            >
              <svg width="16" height="16" aria-hidden="true" class="shrink-0"><use href="#icon-linkedin" /></svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href={angieYoutube}
              target="_blank"
              rel="noopener noreferrer"
              class="text-angie-cream/90 hover:text-angie-rose transition-colors inline-flex items-center gap-2"
            >
              <svg width="16" height="16" aria-hidden="true" class="shrink-0"><use href="#icon-youtube" /></svg>
              <span>YouTube</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="my-10 border-angie-cream/15" />

    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <span class="text-xs sm:text-sm text-angie-cream/80 text-center sm:text-left">
        © {currentYear} · Built by   
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-angie-cream hover:text-angie-rose transition-colors"
        >
          Jhon Cordero
        </a>
      </span>

      <div class="flex items-center gap-3">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="grid place-items-center w-10 h-10 rounded-full border border-angie-cream/20 text-angie-cream/90 hover:bg-angie-cream/10 hover:text-angie-rose transition-colors"
        >
          <svg width="18" height="18" aria-hidden="true"><use href="#icon-github" /></svg>
        </a>
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="grid place-items-center w-10 h-10 rounded-full border border-angie-cream/20 text-angie-cream/90 hover:bg-angie-cream/10 hover:text-angie-rose transition-colors"
        >
          <svg width="18" height="18" aria-hidden="true"><use href="#icon-linkedin" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>