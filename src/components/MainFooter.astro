---
const currentYear = new Date().getFullYear();

const siteLinks = [
  { href: "/", label: "home" },
  { href: "/aboutme", label: "about me" },
  { href: "/store", label: "store" },
  { href: "/wellness", label: "wellness" },
  { href: "/resources", label: "free resources" },
];

const workLinks = [
  { href: "/services/coaching", label: "coaching" },
  { href: "/services/keynote-speaking", label: "keynote speaking" },
  { href: "/services/podcast-guest", label: "podcast guest" },
];

const repoUrl = "https://github.com/Jhondev-30/Angie-website.astro.git";
const githubUrl = "https://github.com/Jhondev-30";
const linkedinUrl = "https://www.linkedin.com/in/jhon-cordero/";
const bookUrl = "https://tidycal.com/angiepspeaks/30min-purpose-discoverycall";

// Angie's real social profiles (verified public URLs)
const socials = [
  { href: "https://www.instagram.com/angie.p.speaks", label: "Angie on Instagram", icon: "icon-instagram" },
  { href: "https://www.facebook.com/people/Angie-Pichardo/61579911753681/", label: "Angie on Facebook", icon: "icon-facebook" },
  { href: "https://www.linkedin.com/in/angie-pichardo", label: "Angie on LinkedIn", icon: "icon-linkedin" },
  { href: "https://www.youtube.com/@angie.p.speaks", label: "Angie on YouTube", icon: "icon-youtube" },
];

const focus =
  "focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-angie-rose";
const link =
  "inline-flex min-h-11 items-center text-angie-cream/85 transition-colors hover:text-angie-cream hover:underline underline-offset-4 decoration-angie-rose decoration-2";
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden" aria-hidden="true">
  <symbol id="icon-github" viewBox="0 0 24 24">
    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/>
  </symbol>
  <symbol id="icon-linkedin" viewBox="0 0 24 24">
    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
  </symbol>
  <symbol id="icon-instagram" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
  </symbol>
  <symbol id="icon-facebook" viewBox="0 0 24 24">
    <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
  </symbol>
  <symbol id="icon-youtube" viewBox="0 0 24 24" fill="currentColor">
    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
  </symbol>
</svg>

<footer class="w-full border-t border-angie-cream/15 bg-angie-noir font-Grotesk text-angie-cream">
  <div class="mx-auto w-full max-w-7xl px-5 pt-14 pb-8 md:px-8 lg:pt-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-6 lg:col-span-5">
        <p class="font-Frauce text-3xl font-semibold leading-tight lg:text-4xl">Angie Pichardo</p>
        <p class="mt-4 max-w-[34ch] text-[1.0625rem] leading-relaxed text-angie-cream/85">
          Christian motivational speaker and life coach. Keynotes, coaching and mobile wellness.
        </p>
        <a href={bookUrl} target="_blank" rel="noopener noreferrer" class:list={["btn btn-outline-light mt-7", focus]}>
          Book a call
        </a>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            socials.map(({ href, label, icon }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={label}
                  class:list={[
                    "grid size-12 place-items-center rounded-md border border-angie-cream/25 text-angie-cream transition-colors hover:bg-angie-cream hover:text-angie-noir",
                    focus,
                  ]}
                >
                  <svg width="20" height="20" aria-hidden="true">
                    <use href={`#${icon}`} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Site" class="md:col-span-3 lg:col-start-7 lg:col-span-3">
        <h2 class="font-Grotesk-bold text-base text-angie-rose">Explore</h2>
        <ul class="mt-3 border-t border-angie-cream/15 pt-2">
          {
            siteLinks.map(({ href, label }) => (
              <li>
                <a href={href} class:list={[link, focus]}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Work with Angie" class="md:col-span-3 lg:col-span-3">
        <h2 class="font-Grotesk-bold text-base text-angie-rose">Work with Angie</h2>
        <ul class="mt-3 border-t border-angie-cream/15 pt-2">
          {
            workLinks.map(({ href, label }) => (
              <li>
                <a href={href} class:list={[link, focus]}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-angie-cream/15 pt-6 text-sm text-angie-cream/80 md:flex-row md:items-center md:justify-between">
      <p>
        © {currentYear} Angie Pichardo · Built by
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["font-Grotesk-bold text-angie-cream underline underline-offset-4 decoration-angie-rose decoration-2 hover:text-angie-rose", focus]}
        >
          Jhon Cordero
        </a>
      </p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <li>
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["inline-flex min-h-11 items-center gap-2 hover:text-angie-cream hover:underline underline-offset-4", focus]}
          >
            <svg width="16" height="16" aria-hidden="true" class="shrink-0"><use href="#icon-github"></use></svg>
            Source repository
          </a>
        </li>
        <li>
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Jhon Cordero on GitHub"
            class:list={["grid size-11 place-items-center rounded-md hover:text-angie-cream", focus]}
          >
            <svg width="18" height="18" aria-hidden="true"><use href="#icon-github"></use></svg>
          </a>
        </li>
        <li>
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Jhon Cordero on LinkedIn"
            class:list={["grid size-11 place-items-center rounded-md hover:text-angie-cream", focus]}
          >
            <svg width="18" height="18" aria-hidden="true"><use href="#icon-linkedin"></use></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
