---
import MainLayout from "../layout/MainLayout.astro";

// =============================================================================
// /resources/ — Free A.L.I.G.N. Framework downloads
//
// Visual rules:
// - Editorial luxury: oversized type, hairlines, magazine-style numbering,
//   asymmetric layout on the "two ways in" section.
// - Each section is its own page: full-bleed (w-full lg:w-screen) with a
//   distinct solid background (noir / wine / zion) so the page reads like
//   a stack of editorial spreads, not one continuous gradient.
// - Content stays at max-w-5xl inside each section.
// - All IDs and form wiring preserved for the modal + /api/subscribe.
// =============================================================================

const PDF_URL  = "/pdfs/ALIGN_Free_Summit_PDF.pdf";
const DOCX_URL = "/pdfs/ALIGN_Free_Summit_Guide_EDITABLE...docx";
const HERO_IMG = "/images/popups/popup-mockup-1-wooden.webp";

const steps = [
  { roman: "I",   letter: "A", name: "Awareness",          blurb: "Recognizing what is keeping you stuck." },
  { roman: "II",  letter: "L", name: "Love Yourself",      blurb: "Breaking the cycle of shame and self-sabotage." },
  { roman: "III", letter: "I", name: "Invite God In",      blurb: "Surrendering control and seeking divine guidance." },
  { roman: "IV",  letter: "G", name: "Gratitude",          blurb: "Shifting your perspective from lack to blessing." },
  { roman: "V",   letter: "N", name: "Nurture Positivity", blurb: "Protecting your mindset and environment." },
];

const faqs = [
  {
    q: "What is the A.L.I.G.N. Framework?",
    a: "A.L.I.G.N. is Angie Pichardo's 5-step framework for Christian life coaching: Awareness, Love Yourself, Invite God In, Gratitude, and Nurture Positivity. It is now available as a free download in two formats (PDF and editable DOCX).",
  },
  {
    q: "Is it really free?",
    a: "Yes. Both the PDF and the editable DOCX are 100% free. We only ask for your email so we can send you the download links and any future updates to the guide. No spam, unsubscribe anytime.",
  },
  {
    q: "What is the difference between the PDF and the editable version?",
    a: "The PDF is the final, print-ready version — no setup, just print and hand out. The editable version is the same content delivered as a Word document (.docx) you can fully customize: drop in your ministry or organization logo, swap colors, adapt the language for your community.",
  },
  {
    q: "Can I share it at my event or in my small group?",
    a: "Absolutely. The PDF works well as an event handout or retreat workbook. The editable version is built for ministries who want to rebrand it for their own community.",
  },
  {
    q: "Do you have A.L.I.G.N. resources in Spanish?",
    a: "Angie serves in both English and Spanish. The A.L.I.G.N. framework is currently available in English only.",
  },
];

const SITE_URL = "https://graceafterthegrave.com";
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  name: "A.L.I.G.N. Framework — Free PDF & Editable Guide",
  description: "Free download of the A.L.I.G.N. Christian life coaching framework by Angie Pichardo.",
  price: "0",
  priceCurrency: "USD",
  category: "Digital Download",
  availability: "https://schema.org/InStock",
  url: new URL("/resources/", SITE_URL).toString(),
  seller: { "@type": "Person", name: "Angie Pichardo", url: new URL("/aboutme", SITE_URL).toString() },
};
---

<MainLayout
  title="Free A.L.I.G.N. Framework Download"
  description="The A.L.I.G.N. framework is Angie's 5-step Christian life coaching method — free PDF and editable DOCX download. Built for event organizers and faith-rooted personal growth."
  canonicalPath="/resources/"
  keywords={[
    "A.L.I.G.N. framework free",
    "A.L.I.G.N. framework PDF",
    "A.L.I.G.N. framework editable",
    "Christian life coaching framework",
    "Free Christian event handout",
    "Women's ministry event resource",
    "Faith-based coaching framework",
    "Free Christian women's framework",
    "Editable Christian framework DOCX",
  ]}
>

  {/* ============================================================
      HERO — split layout (copy + product mockup), mobile-first.
      Headline carries the promise; one primary CTA; trust line.
  ============================================================ */}
  <section class="relative isolate overflow-hidden w-full text-angie-cream bg-angie-noir">
    <div aria-hidden="true" class="absolute -top-32 -right-24 w-[26rem] h-[26rem] rounded-full bg-angie-rose/25 blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute -bottom-40 -left-24 w-[28rem] h-[28rem] rounded-full bg-angie-wine/50 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-28 md:pt-40 pb-16 md:pb-28 grid md:grid-cols-12 gap-12 md:gap-10 items-center">
      <div class="md:col-span-7 text-center md:text-left">
        <p class="inline-flex items-center gap-2 text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold animate-rise">
          <span aria-hidden="true" class="hidden md:block h-px w-8 bg-angie-rose"></span>
          Free field guide
        </p>

        <h1 class="mt-5 font-Frauce font-bold leading-[0.95] text-[clamp(2.75rem,9vw,5.5rem)] tracking-tight text-balance animate-rise" style="animation-delay:120ms">
          Move from stuck <span class="text-angie-rose">to purpose.</span>
        </h1>

        <p class="mt-6 max-w-xl mx-auto md:mx-0 text-angie-cream/85 text-base md:text-xl leading-relaxed animate-rise" style="animation-delay:240ms">
          The A.L.I.G.N. framework: the 5-step method Angie uses in 1:1 coaching and on every keynote stage. Yours free, in two formats.
        </p>

        <div class="mt-9 flex flex-col items-center md:items-start gap-3 animate-rise" style="animation-delay:360ms">
          <button
            type="button"
            id="open-modal"
            class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold text-base shadow-xl shadow-black/30 transition-all duration-300 hover:bg-white hover:scale-[1.03] active:scale-[0.98]"
          >
            <span>Send me the field guide</span>
            <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
          </button>
          <p class="text-xs text-angie-cream/60 italic">
            No drip. No spam. One download, then we let you be.
          </p>
        </div>
      </div>

      <div class="md:col-span-5 animate-zoom-in" style="animation-delay:200ms">
        <div class="relative mx-auto max-w-sm md:max-w-none">
          <div aria-hidden="true" class="absolute inset-4 rounded-[2rem] bg-angie-rose/40 blur-2xl"></div>
          <img
            src={HERO_IMG}
            alt="The A.L.I.G.N. framework field guide laid out on a warm wooden table"
            width="560"
            height="300"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative w-full aspect-[4/3] object-cover rounded-[2rem] border border-white/15 shadow-2xl shadow-black/50 animate-float-soft"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      FACT STRIP — quick proof, speaker-site style
  ============================================================ */}
  <section class="w-full bg-angie-cream text-angie-noir border-y border-angie-noir/10">
    <ul class="max-w-6xl mx-auto px-6 py-8 md:py-10 grid grid-cols-3 gap-4 text-center">
      {[
        { n: "5", l: "Steps in the framework" },
        { n: "2", l: "Formats: PDF + editable" },
        { n: "$0", l: "Always free" },
      ].map((f) => (
        <li>
          <p class="font-Frauce font-bold text-3xl md:text-5xl text-angie-burgundy leading-none">{f.n}</p>
          <p class="mt-2 text-[11px] md:text-sm uppercase tracking-[0.15em] font-Grotesk-bold text-angie-noir/70">{f.l}</p>
        </li>
      ))}
    </ul>
  </section>

  {/* ============================================================
      STATEMENT — one big line (reference flow: statement block)
  ============================================================ */}
  <section class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-4xl mx-auto px-6 py-20 md:py-28 text-center timeline-view animate-range-entry animate-rise">
      <p class="font-Frauce text-3xl md:text-5xl leading-[1.15] text-balance">
        Most of us don't need more information. We need a <span class="text-angie-burgundy">clear order</span> to walk it in.
      </p>
      <p class="mt-6 text-angie-noir/70 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
        Skim the names now. Then work them one at a time. The order is the point.
      </p>
    </div>
  </section>

  {/* ============================================================
      THE 5 STEPS — numbered cards
  ============================================================ */}
  <section class="w-full bg-angie-wine text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-2xl timeline-view animate-range-entry animate-rise">
        <p class="text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">The framework</p>
        <h2 class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-tight">Five movements, walked in order.</h2>
      </div>

      <ol class="mt-12 grid gap-4 md:gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {steps.map((s, i) => (
          <li class="group relative rounded-3xl border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:-translate-y-1 hover:bg-white/10 hover:border-angie-rose/50 timeline-view animate-range-entry animate-rise">
            <span class="text-angie-rose/80 text-xs font-Grotesk-bold tracking-[0.25em]">0{i + 1}</span>
            <p class="mt-3 font-Frauce italic font-bold text-6xl leading-none text-angie-cream transition-transform duration-300 group-hover:scale-110 origin-left">{s.letter}</p>
            <h3 class="mt-4 font-Frauce text-xl leading-snug">{s.name}</h3>
            <p class="mt-2 text-angie-cream/70 text-sm leading-relaxed">{s.blurb}</p>
          </li>
        ))}
      </ol>

      <div class="mt-12 text-center md:text-left">
        <button
          type="button"
          id="open-modal-2"
          class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-angie-cream/40 text-angie-cream font-Grotesk-bold text-sm transition-all duration-300 hover:bg-angie-cream hover:text-angie-noir"
        >
          Send me all five
          <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-0.5">→</span>
        </button>
      </div>
    </div>
  </section>

  {/* ============================================================
      TWO WAYS IN — two cards (host / seeker)
  ============================================================ */}
  <section class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-2xl timeline-view animate-range-entry animate-rise">
        <p class="text-angie-burgundy uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">Two ways in</p>
        <h2 class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-[1.05]">
          A guide for the host. <span class="text-angie-burgundy">A guide for the seeker.</span>
        </h2>
        <p class="mt-4 text-angie-noir/70 text-base md:text-lg leading-relaxed">
          The same five movements, used very differently depending on whether you're standing in front of a room or sitting alone with your journal.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-5 md:gap-6">
        <article class="rounded-3xl bg-white p-7 md:p-9 shadow-xl shadow-angie-burgundy/10 border border-angie-burgundy/10 timeline-view animate-range-entry animate-rise">
          <p class="text-angie-burgundy uppercase tracking-[0.25em] text-xs font-Grotesk-bold">01 · For the host</p>
          <h3 class="mt-3 font-Frauce text-2xl md:text-3xl leading-snug">Print the PDF as-is. Customize the DOCX.</h3>
          <ul class="mt-6 space-y-4 text-angie-noir/80 text-sm md:text-base leading-relaxed">
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-burgundy shrink-0">→</span><span><strong class="text-angie-noir">The PDF</strong> is a complete, print-ready reflection guide with built-in journal space. Print and hand it out at your event, retreat, or small group with no setup.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-burgundy shrink-0">→</span><span><strong class="text-angie-noir">The DOCX</strong> is the editable version: swap in your church or ministry logo, change the colors, and adapt the language for your community.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-burgundy shrink-0">→</span><span>Use the built-in reflection questions as small-group prompts, plus three ready-to-go practices: <em>Flip It</em>, <em>3 &amp; 1</em>, and a <em>One-week challenge</em>.</span></li>
          </ul>
        </article>

        <article class="rounded-3xl bg-angie-noir text-angie-cream p-7 md:p-9 shadow-xl shadow-black/20 timeline-view animate-range-entry animate-rise">
          <p class="text-angie-rose uppercase tracking-[0.25em] text-xs font-Grotesk-bold">02 · For the seeker</p>
          <h3 class="mt-3 font-Frauce text-2xl md:text-3xl leading-snug">Pick your format. Take your time.</h3>
          <ul class="mt-6 space-y-4 text-angie-cream/80 text-sm md:text-base leading-relaxed">
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-rose shrink-0">→</span><span><strong class="text-angie-cream">PDF</strong>: print-ready, fixed layout. Write in the margins and journal spaces by hand.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-rose shrink-0">→</span><span><strong class="text-angie-cream">DOCX</strong>: fully editable. Type your answers, add your name, your church, your prayer routine.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-rose shrink-0">→</span><span>Don't rush. The guide itself says: “Transformation does not require every answer today.” One letter per week if that works.</span></li>
            <li class="flex gap-3"><span aria-hidden="true" class="text-angie-rose shrink-0">→</span><span>Try the practices in order: <em>Flip It</em> (rewrite one old thought), then <em>3 &amp; 1</em> (3 gratitudes + 1 growth step), then the <em>One-week challenge</em>.</span></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================
      HOW IT WORKS — numbered 3-step process
  ============================================================ */}
  <section class="w-full bg-angie-burgundy text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <h2 class="font-Frauce font-bold text-3xl md:text-5xl leading-tight text-center timeline-view animate-range-entry animate-rise">Three steps. Two minutes.</h2>
      <ol class="mt-12 grid md:grid-cols-3 gap-8 md:gap-10">
        {[
          { n: "01", t: "Enter your email", d: "One field. No account, no password." },
          { n: "02", t: "Choose your format", d: "Print-ready PDF or the editable DOCX. Take both if you like." },
          { n: "03", t: "Walk the sequence", d: "Start with A. Take one letter per week, or all five in a sitting." },
        ].map((s) => (
          <li class="text-center md:text-left timeline-view animate-range-entry animate-rise">
            <p class="font-Frauce italic font-bold text-6xl md:text-7xl text-angie-cream/30 leading-none">{s.n}</p>
            <h3 class="mt-3 font-Frauce text-2xl">{s.t}</h3>
            <p class="mt-2 text-angie-cream/80 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 text-center">
        <button
          type="button"
          id="open-modal-3"
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold text-base transition-all duration-300 hover:bg-white hover:scale-[1.03] active:scale-[0.98]"
        >
          Get the free guide
          <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </button>
      </div>
    </div>
  </section>

  {/* ============================================================
      FAQ
  ============================================================ */}
  <section class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-3xl mx-auto px-6 py-20 md:py-28">
      <div class="mb-10 timeline-view animate-range-entry animate-rise">
        <p class="text-angie-burgundy uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">Before you download</p>
        <h2 class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-tight">Questions people ask first.</h2>
      </div>

      <div>
        {faqs.map((f, i) => (
          <details class="group/bg border-b border-angie-noir/15 py-5">
            <summary class="font-Frauce text-lg md:text-xl cursor-pointer list-none flex justify-between items-center gap-4 [&::-webkit-details-marker]:hidden">
              <span class="flex items-baseline gap-3 md:gap-4">
                <span class="text-angie-burgundy text-[10px] md:text-xs font-Grotesk-bold tracking-[0.25em] shrink-0">Q.{String(i + 1).padStart(2, "0")}</span>
                <span>{f.q}</span>
              </span>
              <span aria-hidden="true" class="shrink-0 text-angie-burgundy text-2xl leading-none transition-transform duration-300 group-open/bg:rotate-45">+</span>
            </summary>
            <p class="mt-4 md:ml-12 text-angie-noir/75 text-sm md:text-base leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      FINAL CTA
  ============================================================ */}
  <section class="w-full py-20 md:py-28 text-angie-cream text-center bg-gradient-zion">
    <div class="max-w-3xl mx-auto px-6 timeline-view animate-range-entry animate-rise">
      <h2 class="font-Frauce font-bold text-3xl md:text-5xl leading-[1.1] text-balance">
        The free guide is the start.
        <span class="block text-angie-cream/85">The 30-minute call is where the fit-check happens.</span>
      </h2>
      <p class="mt-5 text-base md:text-lg text-angie-cream/85 leading-relaxed max-w-xl mx-auto">
        If the framework resonated and you want someone to walk the sequence with you, the discovery call is the next honest move.
      </p>
      <a
        href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
        rel="noopener"
        class="group/cta mt-10 inline-flex items-center gap-2 px-8 py-4 bg-angie-cream text-angie-noir font-Grotesk-bold rounded-full transition-all duration-300 hover:bg-white hover:scale-[1.03]"
      >
        Book a Free Discovery Call
        <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/cta:translate-x-1">→</span>
      </a>
    </div>
  </section>


  {/* ============================================================
      DOWNLOAD MODAL — same MailerLite pop-up look, in our code
      Two states: "form" (email) and "success" (2 download buttons).
      All IDs and the form wiring below MUST stay intact.
  ============================================================ */}
  <div
    id="download-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="download-modal-title"
    data-state="closed"
    class="fixed inset-0 z-[1000] hidden items-center justify-center p-4 sm:p-6"
  >
    <div data-close-modal aria-hidden="true" class="absolute inset-0 bg-angie-noir/65 backdrop-blur-sm"></div>

    <div class="relative w-full max-w-[560px] bg-white rounded-3xl shadow-2xl shadow-black/30 overflow-hidden">
      <button
        type="button"
        data-close-modal
        aria-label="Close"
        class="absolute top-3 right-3 z-10 w-9 h-9 grid place-items-center rounded-full text-angie-noir/60 hover:text-angie-noir hover:bg-angie-cream transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="aspect-[560/300] w-full overflow-hidden bg-angie-cream">
        <img
          src={HERO_IMG}
          alt="A flat lay of the A.L.I.G.N. framework guide on a warm wooden table"
          width="560" height="300"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      {/* STATE 1: form */}
      <div id="panel-form" class="px-7 md:px-10 pt-7 pb-8 md:pt-9 md:pb-10 text-center" style="font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;">
        <h2 id="download-modal-title" class="text-angie-noir text-2xl md:text-3xl font-semibold leading-snug">
          Get the A.L.I.G.N. Framework — free 💗
        </h2>
        <p class="mt-3 text-angie-noir/70 text-sm md:text-base leading-relaxed">
          Move from stuck to purpose with the same framework Angie's 1:1 clients use. Free PDF + editable guide, delivered instantly.
        </p>

        <form id="download-form" novalidate class="mt-7 space-y-3">
          <label class="block">
            <span class="sr-only">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="Email"
              class="w-full px-4 py-3 rounded-xl bg-white border border-angie-noir/20 text-angie-noir placeholder-angie-noir/40 text-sm focus:outline-none focus:ring-2 focus:ring-angie-burgundy/40 focus:border-angie-burgundy/60 transition"
            />
          </label>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button
            type="submit"
            id="submit-btn"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-angie-burgundy text-white font-semibold text-sm hover:bg-angie-wine active:scale-[0.99] transition-all duration-200 shadow-sm"
          >
            <span id="btn-label">Download</span>
            <span id="btn-arrow" aria-hidden="true">→</span>
          </button>
          <p id="form-status" role="status" class="hidden text-xs text-red-600"></p>
        </form>

        <p class="mt-4 text-[11px] text-angie-noir/45">
          No spam. One-click unsubscribe. Your email stays with Angie.
        </p>
      </div>

      {/* STATE 2: success */}
      <div id="panel-success" class="hidden px-7 md:px-10 pt-7 pb-8 md:pt-9 md:pb-10 text-center" style="font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;">
        <h2 class="text-angie-noir text-2xl md:text-3xl font-semibold leading-snug">
          You're in! 🎉
        </h2>
        <p class="mt-3 text-angie-noir/70 text-sm md:text-base leading-relaxed">
          Your A.L.I.G.N. framework is ready. Pick the version that fits what you need.
        </p>

        <div class="mt-7 flex flex-col sm:flex-row gap-3">
          <a href={PDF_URL} download class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-angie-burgundy text-white font-semibold text-sm hover:bg-angie-wine transition-colors">
            Download PDF version
          </a>
          <a href={DOCX_URL} download class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-angie-burgundy text-white font-semibold text-sm hover:bg-angie-wine transition-colors">
            Download Editable Version
          </a>
        </div>

        <p class="mt-5 text-[11px] text-angie-noir/45">
          Save both versions somewhere handy so you can come back to them anytime.
        </p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
</MainLayout>

<script is:inline>
  (function () {
    var modal = document.getElementById("download-modal");
    if (!modal) return;
    var formPanel = document.getElementById("panel-form");
    var successPanel = document.getElementById("panel-success");
    var form = document.getElementById("download-form");
    var status = document.getElementById("form-status");
    var submitBtn = document.getElementById("submit-btn");
    var btnLabel = document.getElementById("btn-label");
    var btnArrow = document.getElementById("btn-arrow");
    var lastFocus = null;

    function open() {
      lastFocus = document.activeElement;
      modal.setAttribute("data-state", "open");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      var input = form && form.querySelector('input[type="email"]');
      if (input) input.focus();
    }

    function close() {
      modal.setAttribute("data-state", "closed");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      if (formPanel) formPanel.classList.remove("hidden");
      if (successPanel) successPanel.classList.add("hidden");
      if (status) { status.classList.add("hidden"); status.textContent = ""; }
      if (submitBtn) submitBtn.disabled = false;
      if (btnLabel) btnLabel.textContent = "Download";
      if (btnArrow) btnArrow.textContent = "→";
      if (form) form.reset();
      if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
    }

    function showSuccess() {
      if (formPanel) formPanel.classList.add("hidden");
      if (successPanel) successPanel.classList.remove("hidden");
    }

    function setLoading(loading) {
      if (!submitBtn || !btnLabel || !btnArrow) return;
      submitBtn.disabled = loading;
      btnLabel.textContent = loading ? "Sending…" : "Download";
      btnArrow.textContent = loading ? "…" : "→";
    }

    function showError(msg) {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("hidden");
    }

    function bindOpeners() {
      var ids = ["open-modal", "open-modal-2", "open-modal-3"];
      ids.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener("click", open);
      });
    }

    function bindClosers() {
      var closers = modal.querySelectorAll("[data-close-modal]");
      for (var i = 0; i < closers.length; i++) {
        closers[i].addEventListener("click", close);
      }
    }

    function bindEscape() {
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.getAttribute("data-state") === "open") close();
      });
    }

    function bindForm() {
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var data = new FormData(form);
        var email = ((data.get("email") || "") + "").trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError("Please enter a valid email address.");
          return;
        }
        setLoading(true);
        fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, company: data.get("company") })
        })
          .then(function (r) {
            // Only an invalid email blocks the download. Server/DB problems
            // are handled silently so the user always gets the file.
            if (r.status === 400) {
              showError("Please enter a valid email address.");
              setLoading(false);
              return;
            }
            showSuccess();
          })
          .catch(function () {
            showSuccess();
          });
      });
    }

    bindOpeners();
    bindClosers();
    bindEscape();
    bindForm();

    // Re-bind after Astro view transitions
    document.addEventListener("astro:page-load", function () {
      modal = document.getElementById("download-modal");
      if (!modal) return;
      formPanel = document.getElementById("panel-form");
      successPanel = document.getElementById("panel-success");
      form = document.getElementById("download-form");
      status = document.getElementById("form-status");
      submitBtn = document.getElementById("submit-btn");
      btnLabel = document.getElementById("btn-label");
      btnArrow = document.getElementById("btn-arrow");
      bindOpeners();
      bindClosers();
      bindForm();
    });
  })();
</script>
