---
import MainLayout from "../layout/MainLayout.astro";

// =============================================================================
// /resources/ — Free A.L.I.G.N. Framework downloads
//
// Visual rules:
// - Editorial luxury: oversized type, hairlines, magazine-style numbering,
//   asymmetric layout on the "two ways in" section.
// - Each section is its own page: full-bleed (w-full lg:w-screen) with a
//   distinct solid background (noir / wine / zion) so the page reads like
//   a stack of editorial spreads, not one continuous gradient.
// - Content stays at max-w-5xl inside each section.
// - All IDs and form wiring preserved for the modal + /api/subscribe.
// =============================================================================

const PDF_URL  = "/pdfs/ALIGN_Free_Summit_PDF.pdf";
const DOCX_URL = "/pdfs/ALIGN_Free_Summit_Guide_EDITABLE...docx";
const HERO_IMG = "/images/popups/popup-mockup-1-wooden.webp";

const steps = [
  { roman: "I",   letter: "A", name: "Awareness",          blurb: "Recognizing what is keeping you stuck." },
  { roman: "II",  letter: "L", name: "Love Yourself",      blurb: "Breaking the cycle of shame and self-sabotage." },
  { roman: "III", letter: "I", name: "Invite God In",      blurb: "Surrendering control and seeking divine guidance." },
  { roman: "IV",  letter: "G", name: "Gratitude",          blurb: "Shifting your perspective from lack to blessing." },
  { roman: "V",   letter: "N", name: "Nurture Positivity", blurb: "Protecting your mindset and environment." },
];

const faqs = [
  {
    q: "What is the A.L.I.G.N. Framework?",
    a: "A.L.I.G.N. is Angie Pichardo's 5-step framework for Christian life coaching: Awareness, Love Yourself, Invite God In, Gratitude, and Nurture Positivity. It is now available as a free download in two formats (PDF and editable DOCX).",
  },
  {
    q: "Is it really free?",
    a: "Yes. Both the PDF and the editable DOCX are 100% free. We only ask for your email so we can send you the download links and any future updates to the guide. No spam, unsubscribe anytime.",
  },
  {
    q: "What is the difference between the PDF and the editable version?",
    a: "The PDF is the final, print-ready version — no setup, just print and hand out. The editable version is the same content delivered as a Word document (.docx) you can fully customize: drop in your ministry or organization logo, swap colors, adapt the language for your community.",
  },
  {
    q: "Can I share it at my event or in my small group?",
    a: "Absolutely. The PDF works well as an event handout or retreat workbook. The editable version is built for ministries who want to rebrand it for their own community.",
  },
  {
    q: "Do you have A.L.I.G.N. resources in Spanish?",
    a: "Angie serves in both English and Spanish. The A.L.I.G.N. framework is currently available in English only.",
  },
];

const SITE_URL = "https://graceafterthegrave.com";
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  name: "A.L.I.G.N. Framework — Free PDF & Editable Guide",
  description: "Free download of the A.L.I.G.N. Christian life coaching framework by Angie Pichardo.",
  price: "0",
  priceCurrency: "USD",
  category: "Digital Download",
  availability: "https://schema.org/InStock",
  url: new URL("/resources/", SITE_URL).toString(),
  seller: { "@type": "Person", name: "Angie Pichardo", url: new URL("/aboutme", SITE_URL).toString() },
};
---

<MainLayout
  title="Free A.L.I.G.N. Framework Download"
  description="The A.L.I.G.N. framework is Angie's 5-step Christian life coaching method — free PDF and editable DOCX download. Built for event organizers and faith-rooted personal growth."
  canonicalPath="/resources/"
  keywords={[
    "A.L.I.G.N. framework free",
    "A.L.I.G.N. framework PDF",
    "A.L.I.G.N. framework editable",
    "Christian life coaching framework",
    "Free Christian event handout",
    "Women's ministry event resource",
    "Faith-based coaching framework",
    "Free Christian women's framework",
    "Editable Christian framework DOCX",
  ]}
>

  {/* ============================================================
      HERO — editorial opener: top rule with "Issue 01" mark,
      then A.L.I.G.N. as the visual hook.
  ============================================================ */}
  <section class="relative isolate overflow-hidden text-angie-cream w-full lg:w-screen bg-angie-noir">
    <div aria-hidden="true" class="absolute -top-32 -right-24 w-[28rem] h-[28rem] rounded-full bg-angie-rose/30 blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute -bottom-40 -left-24 w-[32rem] h-[32rem] rounded-full bg-angie-wine/40 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto px-6 pt-27 md:pt-44 pb-24 md:pb-32 text-center">
      {/* Editorial top mark: hairline + issue number + byline */}
  

      <h1 class="mt-10 md:mt-14 font-Frauce italic font-bold leading-[0.85] text-[clamp(5rem,16vw,11rem)] tracking-tight motion-safe:animate-fade-in-up motion-safe:animate-delay-300 motion-safe:animate-duration-1000 motion-safe:animate-bezier-quint-out">
        A.L.I.G.N.
      </h1>

      <p class="mt-8 max-w-2xl mx-auto text-angie-cream/90 text-lg md:text-2xl font-Grotesk leading-snug motion-safe:animate-fade-in-up motion-safe:animate-delay-500">
        A 5-step framework for moving from stuck to purpose.
      </p>

      <p class="mt-4 max-w-xl mx-auto text-angie-cream/65 text-sm md:text-base font-Grotesk italic leading-relaxed motion-safe:animate-fade-in-up motion-safe:animate-delay-700">
        What Angie uses in 1:1 work and on every keynote stage. Yours free, in two formats.
      </p>

      <div class="mt-12 flex flex-col items-center gap-4">
        <button
          type="button"
          id="open-modal"
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold text-base shadow-xl shadow-black/20 hover:bg-white hover:scale-[1.02] active:scale-[0.99] transition-all duration-300 motion-safe:animate-fade-in-up motion-safe:animate-delay-900"
        >
          <span>Send me the field guide</span>
          <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
        </button>

        <p class="text-xs text-angie-cream/55 font-Grotesk italic motion-safe:animate-fade-in-up motion-safe:animate-delay-1000">
          No drip. No spam. One download, then we let you be.
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================
      THE 5 STEPS — typographic sequence with Roman numerals
      on top of the existing A.L.I.G.N. letters.
  ============================================================ */}
  <section class="text-angie-cream py-24 md:py-32 w-full lg:w-screen bg-angie-wine">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up">
      
        <h2 class="mt-4 font-Frauce text-3xl md:text-5xl text-angie-cream leading-tight">
          Five movements, walked in order.
        </h2>
        <p class="mt-4 text-angie-cream/75 font-Grotesk text-base md:text-lg leading-relaxed">
          Skim the names now. Then work them one at a time later — the order is the point.
        </p>
      </div>

      {/* Typographic sequence. Hairline rule across the top on md+. */}
      <div class="relative mt-20">
        <div aria-hidden="true" class="hidden md:block absolute top-7 left-0 right-0 h-px bg-angie-cream/20"></div>

        <ol class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-10 md:gap-4">
          {steps.map((s, i) => (
            <li class:list={[
              "text-center relative motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry",
              [
                "",
                "motion-safe:animate-delay-100",
                "motion-safe:animate-delay-200",
                "motion-safe:animate-delay-300",
                "motion-safe:animate-delay-400",
              ][i],
            ]}>
              <div class="relative mx-auto w-14 h-14 grid place-items-center bg-transparent">
                <span class="font-Frauce italic font-bold text-6xl md:text-7xl text-angie-cream leading-none">
                  {s.letter}
                </span>
              </div>
              <h3 class="mt-2 font-Frauce text-xl md:text-2xl text-angie-cream leading-snug">
                {s.name}
              </h3>
              <p class="mt-2 text-angie-cream/65 font-Grotesk text-sm leading-relaxed px-2">
                {s.blurb}
              </p>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-16 text-center motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up">
        <button
          type="button"
          id="open-modal-2"
          class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-angie-cream/30 text-angie-cream font-Grotesk-bold text-sm hover:bg-angie-cream/10 transition-colors duration-300"
        >
          Send me all five
          <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-0.5">→</span>
        </button>
      </div>
    </div>
  </section>

  {/* ============================================================
      TWO WAYS IN — asymmetric 7/5 grid with a left hairline
      on the second column. Replaces the old "How to use it".
  ============================================================ */}
  <section class="text-angie-cream py-20 md:py-28 w-full lg:w-screen bg-angie-noir">
    <div class="max-w-5xl mx-auto px-6">
      <div class="flex items-end justify-between gap-6 flex-wrap motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up">
        <div class="max-w-2xl">
          <p class="text-angie-rose/90 uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">
            Two ways in
          </p>
          <h2 class="mt-3 font-Frauce text-3xl md:text-5xl text-angie-cream leading-[1.05]">
            A guide for the host.<br/>
            <span class="text-angie-cream/70">A guide for the seeker.</span>
          </h2>
        </div>
        <p class="text-angie-cream/70 font-Grotesk italic text-sm md:text-base max-w-sm leading-relaxed">
          The same five movements — used very differently depending on whether you’re standing in front of a room, or sitting alone with your journal.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-12 md:gap-12 lg:gap-16">
        <div class="md:col-span-7 motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up">
          <p class="text-angie-rose/90 uppercase tracking-[0.25em] text-[10px] md:text-xs font-Grotesk-bold motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-100">
            01 &nbsp;·&nbsp; For the host
          </p>
          <h3 class="mt-3 font-Frauce text-2xl md:text-3xl text-angie-cream leading-snug motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-200">
            Print the PDF as-is. Customize the DOCX.
          </h3>
          <ul class="mt-6 space-y-3 text-angie-cream/80 font-Grotesk text-sm md:text-base leading-relaxed">
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-300"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span><strong class="text-angie-cream font-Grotesk-bold">The PDF</strong> is a complete, print-ready reflection guide with built-in journal space — print and hand it out at your event, retreat, or small group with no setup required.</span></li>
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-400"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span><strong class="text-angie-cream font-Grotesk-bold">The DOCX</strong> is the editable version — swap in your church or ministry logo, change the colors, and adapt the language for your community. Built to be rebranded.</span></li>
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-500"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span>Use the built-in reflection questions as small-group prompts — each of the 5 letters has its own set, plus three ready-to-go practices: the <em>Flip It Practice</em>, the <em>3 &amp; 1 Practice</em>, and a <em>One-week challenge</em>.</span></li>
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-700"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span>Pick the format that matches your event. <strong class="text-angie-cream font-Grotesk-bold">PDF</strong> = fast, no setup. <strong class="text-angie-cream font-Grotesk-bold">DOCX</strong> = you’re putting your brand on it.</span></li>
          </ul>
        </div>

        <div class="mt-10 md:mt-0 md:col-span-5 md:pl-10 md:border-l md:border-angie-cream/15 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-200">
          <p class="text-angie-rose/90 uppercase tracking-[0.25em] text-[10px] md:text-xs font-Grotesk-bold motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-300">
            02 &nbsp;·&nbsp; For the seeker
          </p>
          <h3 class="mt-3 font-Frauce text-2xl md:text-3xl text-angie-cream leading-snug motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-400">
            Pick your format. Take your time.
          </h3>
          <ul class="mt-6 space-y-3 text-angie-cream/80 font-Grotesk text-sm md:text-base leading-relaxed">
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-500"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span><strong class="text-angie-cream font-Grotesk-bold">PDF</strong> — print-ready, fixed layout. Print it, then write in the margins and the journal spaces by hand.</span></li>
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-700"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span><strong class="text-angie-cream font-Grotesk-bold">DOCX</strong> — fully editable. Type your answers directly, add your name, your church, your prayer routine — anything that makes it yours.</span></li>
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-900"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span>Don’t rush. The guide itself says: “Transformation does not require every answer today.” One letter per week if that works — come back to the sections that challenge you.</span></li>
            <li class="flex gap-3 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry motion-safe:animate-delay-1000"><span aria-hidden="true" class="text-angie-rose shrink-0 mt-0.5">→</span><span>Try the practices in order: <em>Flip It</em> (rewrite one old thought), then <em>3 &amp; 1</em> (3 gratitudes + 1 growth step), then the <em>One-week challenge</em>.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      FAQ — re-titled to drop the "Common questions" AI-tell.
      Each item gets a Q.01 / Q.02 index for editorial feel.
  ============================================================ */}
  <section class="text-angie-cream py-20 md:py-28 w-full lg:w-screen bg-angie-wine">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-12 motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up">
        <p class="text-angie-rose/90 uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">
          Before you download
        </p>
        <h2 class="mt-3 font-Frauce text-3xl md:text-5xl text-angie-cream leading-tight">
          Questions people ask first.
        </h2>
        <p class="mt-3 text-angie-cream/70 font-Grotesk italic text-sm md:text-base">
          The honest answers, before you give us your email.
        </p>
      </div>

      <div class="space-y-1">
        {faqs.map((f, i) => (
          <details class:list={[
            "group/bg border-b border-angie-cream/15 py-5 motion-safe:timeline-view motion-safe:animate-fade-in-up motion-safe:animate-range-entry",
            [
              "",
              "motion-safe:animate-delay-100",
              "motion-safe:animate-delay-200",
              "motion-safe:animate-delay-300",
              "motion-safe:animate-delay-400",
            ][i],
          ]}>
            <summary class="font-Frauce text-lg md:text-xl text-angie-cream cursor-pointer list-none flex justify-between items-center gap-4 [&::-webkit-details-marker]:hidden">
              <span class="flex items-baseline gap-3 md:gap-4">
                <span class="text-angie-rose/80 text-[10px] md:text-xs font-Grotesk-bold tracking-[0.25em] shrink-0 mt-1">
                  Q.{String(i + 1).padStart(2, "0")}
                </span>
                <span>{f.q}</span>
              </span>
              <span aria-hidden="true" class="shrink-0 text-angie-rose text-2xl leading-none transition-transform duration-300 group-open/bg:rotate-45">+</span>
            </summary>
            <p class="mt-4 md:ml-12 text-angie-cream/80 font-Grotesk text-sm md:text-base leading-relaxed">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      FINAL CTA — drop the "Ready to go deeper" AI-tell.
      Hairline + kicker + conversational copy.
  ============================================================ */}
  <section class="py-20 md:py-28 text-angie-cream text-center w-full lg:w-screen bg-gradient-zion">
    <div class="max-w-3xl mx-auto px-6">
      <div aria-hidden="true" class="flex items-center justify-center gap-4 mb-8 motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in">
        <span class="h-px w-12 md:w-16 bg-angie-cream/30"></span>
        <span class="text-angie-rose/85 text-[10px] md:text-xs uppercase tracking-[0.35em] font-Grotesk-bold">
          If you want a guide, not just a guide
        </span>
        <span class="h-px w-12 md:w-16 bg-angie-cream/30"></span>
      </div>

      <h2 class="font-Frauce text-3xl md:text-5xl leading-[1.1] motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up">
        The free field guide is the start.<br class="hidden md:block"/>
        <span class="text-angie-cream/85">The 30-minute call is where the fit-check happens.</span>
      </h2>
      <p class="mt-5 font-Grotesk text-base md:text-lg text-angie-cream/80 leading-relaxed max-w-xl mx-auto motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up motion-safe:animate-delay-200">
        If the framework resonated and you want someone to walk the sequence with you, the discovery call is the next honest move.
      </p>

      <a
        href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
        rel="noopener"
        class="group/cta mt-10 inline-flex items-center gap-2 px-8 py-4 bg-angie-cream text-angie-noir font-Grotesk-bold rounded-full hover:bg-white transition-colors duration-300 motion-safe:timeline-view motion-safe:animate-range-entry motion-safe:animate-fade-in-up motion-safe:animate-delay-500"
      >
        Book a Free Discovery Call
        <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/cta:translate-x-1">→</span>
      </a>
    </div>
  </section>

  {/* ============================================================
      DOWNLOAD MODAL — same MailerLite pop-up look, in our code
      Two states: "form" (email) and "success" (2 download buttons).
      All IDs and the form wiring below MUST stay intact.
  ============================================================ */}
  <div
    id="download-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="download-modal-title"
    data-state="closed"
    class="fixed inset-0 z-[1000] hidden items-center justify-center p-4 sm:p-6"
  >
    <div data-close-modal aria-hidden="true" class="absolute inset-0 bg-angie-noir/65 backdrop-blur-sm"></div>

    <div class="relative w-full max-w-[560px] bg-white rounded-3xl shadow-2xl shadow-black/30 overflow-hidden">
      <button
        type="button"
        data-close-modal
        aria-label="Close"
        class="absolute top-3 right-3 z-10 w-9 h-9 grid place-items-center rounded-full text-angie-noir/60 hover:text-angie-noir hover:bg-angie-cream transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="aspect-[560/300] w-full overflow-hidden bg-angie-cream">
        <img
          src={HERO_IMG}
          alt="A flat lay of the A.L.I.G.N. framework guide on a warm wooden table"
          width="560" height="300"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      {/* STATE 1: form */}
      <div id="panel-form" class="px-7 md:px-10 pt-7 pb-8 md:pt-9 md:pb-10 text-center" style="font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;">
        <h2 id="download-modal-title" class="text-angie-noir text-2xl md:text-3xl font-semibold leading-snug">
          Get the A.L.I.G.N. Framework — free 💗
        </h2>
        <p class="mt-3 text-angie-noir/70 text-sm md:text-base leading-relaxed">
          Move from stuck to purpose with the same framework Angie's 1:1 clients use. Free PDF + editable guide, delivered instantly.
        </p>

        <form id="download-form" novalidate class="mt-7 space-y-3">
          <label class="block">
            <span class="sr-only">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="Email"
              class="w-full px-4 py-3 rounded-xl bg-white border border-angie-noir/20 text-angie-noir placeholder-angie-noir/40 text-sm focus:outline-none focus:ring-2 focus:ring-angie-burgundy/40 focus:border-angie-burgundy/60 transition"
            />
          </label>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button
            type="submit"
            id="submit-btn"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-teal-600 text-white font-semibold text-sm hover:bg-teal-700 active:scale-[0.99] transition-all duration-200 shadow-sm"
          >
            <span id="btn-label">Download</span>
            <span id="btn-arrow" aria-hidden="true">→</span>
          </button>
          <p id="form-status" role="status" class="hidden text-xs text-red-600"></p>
        </form>

        <p class="mt-4 text-[11px] text-angie-noir/45">
          No spam. One-click unsubscribe. Your email stays with Angie.
        </p>
      </div>

      {/* STATE 2: success */}
      <div id="panel-success" class="hidden px-7 md:px-10 pt-7 pb-8 md:pt-9 md:pb-10 text-center" style="font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;">
        <h2 class="text-angie-noir text-2xl md:text-3xl font-semibold leading-snug">
          You're in! 🎉
        </h2>
        <p class="mt-3 text-angie-noir/70 text-sm md:text-base leading-relaxed">
          Your A.L.I.G.N. framework is ready. Pick the version that fits what you need.
        </p>

        <div class="mt-7 flex flex-col sm:flex-row gap-3">
          <a href={PDF_URL} download class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-teal-600 text-white font-semibold text-sm hover:bg-teal-700 transition-colors">
            Download PDF version
          </a>
          <a href={DOCX_URL} download class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-teal-600 text-white font-semibold text-sm hover:bg-teal-700 transition-colors">
            Download Editable Version
          </a>
        </div>

        <p class="mt-5 text-[11px] text-angie-noir/45">
          Both versions are also in your inbox if you need them later.
        </p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
</MainLayout>

<script is:inline>
  (function () {
    var modal = document.getElementById("download-modal");
    if (!modal) return;
    var formPanel = document.getElementById("panel-form");
    var successPanel = document.getElementById("panel-success");
    var form = document.getElementById("download-form");
    var status = document.getElementById("form-status");
    var submitBtn = document.getElementById("submit-btn");
    var btnLabel = document.getElementById("btn-label");
    var btnArrow = document.getElementById("btn-arrow");
    var lastFocus = null;

    function open() {
      lastFocus = document.activeElement;
      modal.setAttribute("data-state", "open");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      var input = form && form.querySelector('input[type="email"]');
      if (input) input.focus();
    }

    function close() {
      modal.setAttribute("data-state", "closed");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      if (formPanel) formPanel.classList.remove("hidden");
      if (successPanel) successPanel.classList.add("hidden");
      if (status) { status.classList.add("hidden"); status.textContent = ""; }
      if (submitBtn) submitBtn.disabled = false;
      if (btnLabel) btnLabel.textContent = "Download";
      if (btnArrow) btnArrow.textContent = "→";
      if (form) form.reset();
      if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
    }

    function showSuccess() {
      if (formPanel) formPanel.classList.add("hidden");
      if (successPanel) successPanel.classList.remove("hidden");
    }

    function setLoading(loading) {
      if (!submitBtn || !btnLabel || !btnArrow) return;
      submitBtn.disabled = loading;
      btnLabel.textContent = loading ? "Sending…" : "Download";
      btnArrow.textContent = loading ? "…" : "→";
    }

    function showError(msg) {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("hidden");
    }

    function bindOpeners() {
      var ids = ["open-modal", "open-modal-2"];
      ids.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener("click", open);
      });
    }

    function bindClosers() {
      var closers = modal.querySelectorAll("[data-close-modal]");
      for (var i = 0; i < closers.length; i++) {
        closers[i].addEventListener("click", close);
      }
    }

    function bindEscape() {
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.getAttribute("data-state") === "open") close();
      });
    }

    function bindForm() {
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var data = new FormData(form);
        var email = ((data.get("email") || "") + "").trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError("Please enter a valid email address.");
          return;
        }
        setLoading(true);
        fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, company: data.get("company") })
        })
          .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (res.ok && res.j && res.j.ok) {
              showSuccess();
            } else {
              showError((res.j && res.j.error) || "Something went wrong. Try again.");
              setLoading(false);
            }
          })
          .catch(function () {
            showError("Network error. Check your connection and try again.");
            setLoading(false);
          });
      });
    }

    bindOpeners();
    bindClosers();
    bindEscape();
    bindForm();

    // Re-bind after Astro view transitions
    document.addEventListener("astro:page-load", function () {
      modal = document.getElementById("download-modal");
      if (!modal) return;
      formPanel = document.getElementById("panel-form");
      successPanel = document.getElementById("panel-success");
      form = document.getElementById("download-form");
      status = document.getElementById("form-status");
      submitBtn = document.getElementById("submit-btn");
      btnLabel = document.getElementById("btn-label");
      btnArrow = document.getElementById("btn-arrow");
      bindOpeners();
      bindClosers();
      bindForm();
    });
  })();
</script>
