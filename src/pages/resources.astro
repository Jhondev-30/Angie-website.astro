---
import MainLayout from "../layout/MainLayout.astro";

// =============================================================================
// /resources/ — Free A.L.I.G.N. Framework downloads
//
// Layout: photo-led hero, hairline lists for the five steps, two asymmetric
// columns for host / seeker, plain-text process, FAQ rows, solid CTA band.
// All IDs and form wiring preserved for the modal + /api/subscribe.
// =============================================================================

const PDF_URL  = "/pdfs/ALIGN_Free_Summit_PDF.pdf";
const DOCX_URL = "/pdfs/ALIGN_Free_Summit_Guide_EDITABLE...docx";
const HERO_IMG = "/images/popups/popup-mockup-1-wooden.webp";
const HOST_IMG = "/images/popups/popup-mockup-2-marble.webp";
const SEEKER_IMG = "/images/popups/popup-mockup-3-darkwood.webp";

const steps = [
  { roman: "I",   letter: "A", name: "Awareness",          blurb: "Recognizing what is keeping you stuck." },
  { roman: "II",  letter: "L", name: "Love Yourself",      blurb: "Breaking the cycle of shame and self-sabotage." },
  { roman: "III", letter: "I", name: "Invite God In",      blurb: "Surrendering control and seeking divine guidance." },
  { roman: "IV",  letter: "G", name: "Gratitude",          blurb: "Shifting your perspective from lack to blessing." },
  { roman: "V",   letter: "N", name: "Nurture Positivity", blurb: "Protecting your mindset and environment." },
];

const faqs = [
  {
    q: "What is the A.L.I.G.N. Framework?",
    a: "A.L.I.G.N. is Angie Pichardo's 5-step framework for Christian life coaching: Awareness, Love Yourself, Invite God In, Gratitude, and Nurture Positivity. It is now available as a free download in two formats (PDF and editable DOCX).",
  },
  {
    q: "Is it really free?",
    a: "Yes. Both the PDF and the editable DOCX are 100% free. We only ask for your email so we can send you the download links and any future updates to the guide. No spam, unsubscribe anytime.",
  },
  {
    q: "What is the difference between the PDF and the editable version?",
    a: "The PDF is the final, print-ready version — no setup, just print and hand out. The editable version is the same content delivered as a Word document (.docx) you can fully customize: drop in your ministry or organization logo, swap colors, adapt the language for your community.",
  },
  {
    q: "Can I share it at my event or in my small group?",
    a: "Absolutely. The PDF works well as an event handout or retreat workbook. The editable version is built for ministries who want to rebrand it for their own community.",
  },
  {
    q: "Do you have A.L.I.G.N. resources in Spanish?",
    a: "Angie serves in both English and Spanish. The A.L.I.G.N. framework is currently available in English only.",
  },
];

const SITE_URL = "https://graceafterthegrave.com";
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  name: "A.L.I.G.N. Framework — Free PDF & Editable Guide",
  description: "Free download of the A.L.I.G.N. Christian life coaching framework by Angie Pichardo.",
  price: "0",
  priceCurrency: "USD",
  category: "Digital Download",
  availability: "https://schema.org/InStock",
  url: new URL("/resources/", SITE_URL).toString(),
  seller: { "@type": "Person", name: "Angie Pichardo", url: new URL("/aboutme", SITE_URL).toString() },
};

const hostPoints = [
  { lead: "The PDF", text: "is a complete, print-ready reflection guide with built-in journal space. Print and hand it out at your event, retreat, or small group with no setup." },
  { lead: "The DOCX", text: "is the editable version: swap in your church or ministry logo, change the colors, and adapt the language for your community." },
];
const seekerPoints = [
  { lead: "PDF:", text: "print-ready, fixed layout. Write in the margins and journal spaces by hand." },
  { lead: "DOCX:", text: "fully editable. Type your answers, add your name, your church, your prayer routine." },
];

const howSteps = [
  { t: "Enter your email", d: "One field. No account, no password." },
  { t: "Choose your format", d: "Print-ready PDF or the editable DOCX. Take both if you like." },
  { t: "Walk the sequence", d: "Start with A. Take one letter per week, or all five in a sitting." },
];
---

<MainLayout
  title="Free A.L.I.G.N. Framework Download"
  description="The A.L.I.G.N. framework is Angie's 5-step Christian life coaching method — free PDF and editable DOCX download. Built for event organizers and faith-rooted personal growth."
  canonicalPath="/resources/"
  keywords={[
    "A.L.I.G.N. framework free",
    "A.L.I.G.N. framework PDF",
    "A.L.I.G.N. framework editable",
    "Christian life coaching framework",
    "Free Christian event handout",
    "Women's ministry event resource",
    "Faith-based coaching framework",
    "Free Christian women's framework",
    "Editable Christian framework DOCX",
  ]}
>

  {/* HERO — copy 5/12, product photo 7/12, one primary CTA */}
  <section class="w-full bg-angie-noir text-angie-cream">
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-28 md:pt-40 pb-14 md:pb-24 grid md:grid-cols-12 gap-x-12 gap-y-10 items-center">
      <div class="md:col-span-5">
        <h1 class="font-Frauce font-bold leading-[1] text-[clamp(2.5rem,6vw,4.75rem)] tracking-tight text-balance animate-rise">
          Move from stuck to purpose.
        </h1>

        <p class="mt-6 measure text-angie-cream/90 text-lg md:text-xl leading-relaxed animate-rise" style="animation-delay:120ms">
          The A.L.I.G.N. framework: the 5-step method Angie uses in 1:1 coaching and on every keynote stage. Yours free, in two formats.
        </p>

        <div class="mt-8 animate-rise" style="animation-delay:240ms">
          <button type="button" id="open-modal" class="btn btn-light hover:animate-tada">
            Send me the field guide
          </button>
          <p class="mt-4 text-sm text-angie-cream/80 max-w-sm">
            We only ask for your email so we can send you the download links.
          </p>
        </div>
      </div>

      <div class="md:col-span-7 animate-zoom-in" style="animation-delay:160ms">
        <img
          src={HERO_IMG}
          alt="The A.L.I.G.N. framework field guide laid out on a warm wooden table"
          width="1120"
          height="630"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full aspect-[16/10] object-cover rounded-lg"
        />
      </div>
    </div>
  </section>

  {/* THE FIVE STEPS — narrow heading, hairline rows */}
  <section class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 pt-16 md:pt-24 pb-16 md:pb-20 grid md:grid-cols-12 gap-x-12 gap-y-8">
      <div class="md:col-span-4">
        <h2 class="font-Frauce font-bold text-[clamp(2rem,4vw,3rem)] leading-[1.08] text-balance">The five steps of the A.L.I.G.N. framework</h2>
      </div>

      <div class="md:col-span-8">
        <ol class="border-t border-angie-noir/20">
          {steps.map((s) => (
            <li class="grid sm:grid-cols-12 gap-x-6 gap-y-1 py-5 md:py-6 border-b border-angie-noir/15">
              <h3 class="sm:col-span-5 font-Frauce font-bold text-2xl leading-snug">{s.name}</h3>
              <p class="sm:col-span-7 text-angie-noir/80 text-lg leading-relaxed">{s.blurb}</p>
            </li>
          ))}
        </ol>

        <button type="button" id="open-modal-2" class="btn btn-dark mt-9">
          Send me all five
        </button>
      </div>
    </div>
  </section>

  {/* TWO WAYS IN — host (wide, marble) / seeker (narrow, offset, dark wood) */}
  <section class="w-full bg-angie-wine text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
      <div class="max-w-3xl">
        <h2 class="font-Frauce font-bold text-[clamp(2rem,4.4vw,3.5rem)] leading-[1.05] text-balance">
          A guide for the host. A guide for the seeker.
        </h2>
        <p class="mt-5 measure text-angie-cream/90 text-lg leading-relaxed">
          The same five movements, used very differently depending on whether you're standing in front of a room or sitting alone with your journal.
        </p>
      </div>

      <div class="mt-12 md:mt-16 grid md:grid-cols-12 gap-x-12 gap-y-14">
        <article class="md:col-span-7 timeline-view animate-range-entry animate-rise">
          <img
            src={HOST_IMG}
            alt="A blank embossed guide on a marble desk with a pen, glasses and linen"
            width="1120"
            height="630"
            loading="lazy"
            decoding="async"
            class="w-full aspect-[16/10] object-cover object-[50%_40%] rounded-lg"
          />
          <h3 class="mt-7 font-Frauce font-bold text-3xl">For the host</h3>
          <p class="mt-2 font-Frauce text-xl text-angie-cream/90">Print the PDF as-is. Customize the DOCX.</p>
          <ul class="mt-6 border-t border-angie-cream/25">
            {hostPoints.map((p) => (
              <li class="py-4 border-b border-angie-cream/15 text-angie-cream/90 text-lg leading-relaxed">
                <strong class="text-angie-cream">{p.lead}</strong> {p.text}
              </li>
            ))}
            <li class="py-4 border-b border-angie-cream/15 text-angie-cream/90 text-lg leading-relaxed">
              Use the built-in reflection questions as small-group prompts, plus three ready-to-go practices: <em>Flip It</em>, <em>3 &amp; 1</em>, and a <em>One-week challenge</em>.
            </li>
          </ul>
        </article>

        <article class="md:col-span-5 md:mt-28 timeline-view animate-range-entry animate-rise">
          <img
            src={SEEKER_IMG}
            alt="A burgundy guide on dark wood beside a candle, olive leaves and an old key"
            width="1120"
            height="630"
            loading="lazy"
            decoding="async"
            class="w-full aspect-[4/3] object-cover object-[50%_45%] rounded-lg"
          />
          <h3 class="mt-7 font-Frauce font-bold text-3xl">For the seeker</h3>
          <p class="mt-2 font-Frauce text-xl text-angie-cream/90">Pick your format. Take your time.</p>
          <ul class="mt-6 border-t border-angie-cream/25">
            {seekerPoints.map((p) => (
              <li class="py-4 border-b border-angie-cream/15 text-angie-cream/90 text-lg leading-relaxed">
                <strong class="text-angie-cream">{p.lead}</strong> {p.text}
              </li>
            ))}
            <li class="py-4 border-b border-angie-cream/15 text-angie-cream/90 text-lg leading-relaxed">
              The guide itself says: “Transformation does not require every answer today.” One letter per week if that works.
            </li>
            <li class="py-4 border-b border-angie-cream/15 text-angie-cream/90 text-lg leading-relaxed">
              Try the practices in order: <em>Flip It</em> (rewrite one old thought), then <em>3 &amp; 1</em> (3 gratitudes + 1 growth step), then the <em>One-week challenge</em>.
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  {/* HOW TO GET IT + FAQ — one cream spread */}
  <section class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 pt-14 md:pt-20 pb-12 md:pb-16">
      <h2 class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1]">How to get the guide</h2>
      <ol class="mt-8 grid md:grid-cols-3 gap-x-10">
        {howSteps.map((s, i) => (
          <li class="py-5 border-t border-angie-noir/25">
            <p class="font-Grotesk-bold text-lg"><span class="text-angie-burgundy tabular-nums">{i + 1}.</span> {s.t}</p>
            <p class="mt-1 text-angie-noir/80 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
      <button type="button" id="open-modal-3" class="btn btn-burgundy mt-6">
        Get the free guide
      </button>
    </div>

    <div class="max-w-3xl mx-auto px-6 pt-8 md:pt-12 pb-16 md:pb-24">
      <h2 class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1]">Before you download</h2>
      <div class="mt-8 border-t border-angie-noir/20">
        {faqs.map((f) => (
          <details class="group/faq border-b border-angie-noir/15">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4 min-h-14 py-4 font-Frauce font-bold text-lg md:text-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-angie-burgundy [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <svg aria-hidden="true" class="shrink-0 w-5 h-5 text-angie-burgundy transition-transform duration-300 group-open/faq:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </summary>
            <p class="pb-5 pr-9 measure text-angie-noir/80 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* FINAL CTA — solid burgundy plane, left-aligned */}
  <section class="w-full bg-angie-burgundy text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-14 md:py-20 grid md:grid-cols-12 gap-x-12 gap-y-8 items-end">
      <div class="md:col-span-8">
        <h2 class="font-Frauce font-bold text-[clamp(2rem,4.6vw,3.5rem)] leading-[1.05] text-balance">
          Want someone to walk the sequence with you?
        </h2>
        <p class="mt-5 measure text-angie-cream/90 text-lg leading-relaxed">
          If the framework resonated, the free 30-minute discovery call is the next step.
        </p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a
          href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
          rel="noopener"
          class="btn btn-light"
        >
          Book a Free Discovery Call
        </a>
      </div>
    </div>
  </section>


  {/* ============================================================
      DOWNLOAD MODAL — same MailerLite pop-up look, in our code
      Two states: "form" (email) and "success" (2 download buttons).
      All IDs and the form wiring below MUST stay intact.
  ============================================================ */}
  <div
    id="download-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="download-modal-title"
    data-state="closed"
    class="fixed inset-0 z-[1000] hidden items-center justify-center p-4 sm:p-6"
  >
    <div data-close-modal aria-hidden="true" class="absolute inset-0 bg-angie-noir/75"></div>

    <div class="relative w-full max-w-[560px] max-h-[calc(100dvh-2rem)] overflow-y-auto bg-angie-cream text-angie-noir rounded-lg shadow-2xl shadow-black/40">
      <button
        type="button"
        data-close-modal
        aria-label="Close"
        class="absolute top-2 right-2 z-10 w-11 h-11 grid place-items-center rounded-md bg-angie-cream/90 text-angie-noir hover:bg-white focus-visible:outline-2 focus-visible:outline-angie-burgundy transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="aspect-[560/300] w-full overflow-hidden bg-angie-cream">
        <img
          src={HERO_IMG}
          alt="A flat lay of the A.L.I.G.N. framework guide on a warm wooden table"
          width="560" height="300"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      {/* STATE 1: form */}
      <div id="panel-form" class="px-6 md:px-10 pt-7 pb-8 md:pt-9 md:pb-10">
        <h2 id="download-modal-title" class="font-Frauce font-bold text-angie-noir text-2xl md:text-3xl leading-snug">
          Get the A.L.I.G.N. Framework, free
        </h2>
        <p class="mt-3 text-angie-noir/80 leading-relaxed">
          Move from stuck to purpose with the same framework Angie's 1:1 clients use. Free PDF + editable guide, delivered instantly.
        </p>

        <form id="download-form" novalidate class="mt-6">
          <label class="block">
            <span class="block font-Grotesk-bold text-sm">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              aria-describedby="form-status"
              placeholder="you@example.com"
              class="mt-1.5 w-full min-h-12 px-4 py-3 rounded-md bg-white border border-angie-noir/50 text-angie-noir placeholder-angie-noir/65 focus:outline-none focus:ring-2 focus:ring-angie-burgundy focus:border-angie-burgundy transition"
            />
          </label>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <p id="form-status" role="status" class="hidden mt-2 text-sm font-Grotesk-bold text-angie-burgundy"></p>
          <button type="submit" id="submit-btn" class="btn btn-burgundy w-full mt-4 disabled:opacity-70">
            <span id="btn-label">Download</span>
            <span id="btn-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <p class="mt-4 text-sm text-angie-noir/70">
          No spam. One-click unsubscribe. Your email stays with Angie.
        </p>
      </div>

      {/* STATE 2: success */}
      <div id="panel-success" class="hidden px-6 md:px-10 pt-7 pb-8 md:pt-9 md:pb-10">
        <h2 tabindex="-1" class="font-Frauce font-bold text-angie-noir text-2xl md:text-3xl leading-snug outline-none">
          You're in.
        </h2>
        <p class="mt-3 text-angie-noir/80 leading-relaxed">
          Your A.L.I.G.N. framework is ready. Pick the version that fits what you need.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href={PDF_URL} download class="btn btn-burgundy flex-1">
            Download PDF version
          </a>
          <a href={DOCX_URL} download class="btn btn-burgundy flex-1">
            Download Editable Version
          </a>
        </div>

        <p class="mt-5 text-sm text-angie-noir/70">
          Save both versions somewhere handy so you can come back to them anytime.
        </p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
</MainLayout>

<script is:inline>
  (function () {
    var modal = document.getElementById("download-modal");
    if (!modal) return;
    var formPanel = document.getElementById("panel-form");
    var successPanel = document.getElementById("panel-success");
    var form = document.getElementById("download-form");
    var status = document.getElementById("form-status");
    var submitBtn = document.getElementById("submit-btn");
    var btnLabel = document.getElementById("btn-label");
    var btnArrow = document.getElementById("btn-arrow");
    var lastFocus = null;

    function open() {
      lastFocus = document.activeElement;
      modal.setAttribute("data-state", "open");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      var input = form && form.querySelector('input[type="email"]');
      if (input) input.focus();
    }

    function close() {
      modal.setAttribute("data-state", "closed");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      if (formPanel) formPanel.classList.remove("hidden");
      if (successPanel) successPanel.classList.add("hidden");
      if (status) { status.classList.add("hidden"); status.textContent = ""; }
      if (submitBtn) submitBtn.disabled = false;
      if (btnLabel) btnLabel.textContent = "Download";
      if (btnArrow) btnArrow.textContent = "→";
      if (form) {
        form.reset();
        var f = form.querySelector('input[type="email"]');
        if (f) f.removeAttribute("aria-invalid");
      }
      if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
    }

    function showSuccess() {
      if (formPanel) formPanel.classList.add("hidden");
      if (successPanel) {
        successPanel.classList.remove("hidden");
        // The focused submit button was just hidden: move focus to the new heading
        var h = successPanel.querySelector("h2");
        if (h && typeof h.focus === "function") h.focus();
      }
    }

    function setLoading(loading) {
      if (!submitBtn || !btnLabel || !btnArrow) return;
      submitBtn.disabled = loading;
      btnLabel.textContent = loading ? "Sending…" : "Download";
      btnArrow.textContent = loading ? "…" : "→";
    }

    function showError(msg) {
      if (!status) return;
      // Reveal the live region first, then set the text, so it is announced
      status.classList.remove("hidden");
      status.textContent = "";
      setTimeout(function () { status.textContent = msg; }, 50);
      var field = form && form.querySelector('input[type="email"]');
      if (field) { field.setAttribute("aria-invalid", "true"); field.focus(); }
    }

    function bindOpeners() {
      var ids = ["open-modal", "open-modal-2", "open-modal-3"];
      ids.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener("click", open);
      });
    }

    function bindClosers() {
      var closers = modal.querySelectorAll("[data-close-modal]");
      for (var i = 0; i < closers.length; i++) {
        closers[i].addEventListener("click", close);
      }
    }

    function bindEscape() {
      document.addEventListener("keydown", function (e) {
        if (!modal || modal.getAttribute("data-state") !== "open") return;
        if (e.key === "Escape") { close(); return; }
        // Focus trap: keep Tab / Shift+Tab inside the dialog while it is open
        if (e.key === "Tab") {
          var nodes = modal.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), [tabindex="0"]');
          var items = [];
          for (var i = 0; i < nodes.length; i++) {
            if (nodes[i].offsetParent !== null) items.push(nodes[i]);
          }
          if (!items.length) { e.preventDefault(); return; }
          var first = items[0];
          var last = items[items.length - 1];
          var active = document.activeElement;
          if (!modal.contains(active) || (active.tabIndex === -1 && active !== first)) {
            e.preventDefault();
            (e.shiftKey ? last : first).focus();
          } else if (e.shiftKey && active === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }

    function bindForm() {
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var data = new FormData(form);
        var email = ((data.get("email") || "") + "").trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError("Please enter a valid email address.");
          return;
        }
        setLoading(true);
        fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, company: data.get("company") })
        })
          .then(function (r) {
            // Only an invalid email blocks the download. Server/DB problems
            // are handled silently so the user always gets the file.
            if (r.status === 400) {
              showError("Please enter a valid email address.");
              setLoading(false);
              return;
            }
            showSuccess();
          })
          .catch(function () {
            showSuccess();
          });
      });
    }

    bindOpeners();
    bindClosers();
    bindEscape();
    bindForm();

    // Re-bind after Astro view transitions
    document.addEventListener("astro:page-load", function () {
      modal = document.getElementById("download-modal");
      if (!modal) return;
      formPanel = document.getElementById("panel-form");
      successPanel = document.getElementById("panel-success");
      form = document.getElementById("download-form");
      status = document.getElementById("form-status");
      submitBtn = document.getElementById("submit-btn");
      btnLabel = document.getElementById("btn-label");
      btnArrow = document.getElementById("btn-arrow");
      bindOpeners();
      bindClosers();
      bindForm();
    });
  })();
</script>
