          <div class="relative">
            <div class={`inline-flex w-14 h-14 md:w-16 md:h-16 rounded-full ${waitlistAccents[0].iconBg} ${waitlistAccents[0].iconBorder} border items-center justify-center ${waitlistAccents[0].iconColor} mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-500 shadow-lg shadow-black/20`}>
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="font-Frauce font-bold text-xl md:text-2xl text-white mb-2 leading-tight">First access</h3>
