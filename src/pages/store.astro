  <!--
    =====================================================
    JSON-LD SCHEMAS — SEO + GEO + AI engine citation source
    =====================================================
  -->

  <!-- FAQ schema — Google rich results + ChatGPT/Perplexity/Claude extraction -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- WebPage schema — defines the page type and topic for crawlers -->
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

  <!-- BreadcrumbList — improves SERP display and site structure understanding -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
