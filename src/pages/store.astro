              <summary class="relative cursor-pointer list-none p-6 md:p-7 flex items-center justify-between gap-3 min-h-28 md:min-h-36 [&::-webkit-details-marker]:hidden">
                <div class="flex items-start gap-3 flex-1 min-w-0">
                  <span aria-hidden="true" class="shrink-0 mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-full border border-angie-rose/40 text-angie-rose">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                      <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                  </span>
                  <h3 class="font-Frauce font-bold text-lg md:text-xl text-white leading-snug pt-0.5 text-balance">
