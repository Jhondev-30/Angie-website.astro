            <details class="group relative overflow-hidden rounded-2xl md:rounded-3xl bg-white/4 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/30 hover:bg-white/8 hover:border-white/25 hover:shadow-angie-rose/20 transition-all duration-500 open:bg-white/8 open:border-white/25 open:shadow-angie-rose/20 ">
