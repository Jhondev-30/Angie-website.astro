---

import MainLayout from "../layout/MainLayout.astro";
import PhraseMarquee from "../components/store/PhraseMarquee.astro";
import ProductCard from "../components/store/ProductCard.astro";

// FAQ content — SEO-optimized, answers the real "Angie Pichardo resources"
// questions people ask after the keynote or coaching intro call.
const faqs = [
  {
    question: "When does the A.L.I.G.N. store open?",
    answer:
      "The store officially opens in 2026, alongside the release of the book Unleash Your Greatness. The A.L.I.G.N. self-paced course and the Still Here 30-day devotional are the first two products. Join the waitlist to get the launch date and an early-bird discount the moment doors open.",
  },
  {
    question: "What products will be available in the store?",
    answer:
      "Three core resources built around the A.L.I.G.N. framework: a self-paced A.L.I.G.N. course (Awareness, Love Yourself, Invite God, Gratitude, Nurture), the Still Here 30-day devotional for women in the season between survival and breakthrough, and Angie's chapter contribution to the co-authored book Unleash Your Greatness (September 2026).",
  },
  {
    question: "How do I join the waitlist?",
    answer:
      "Book a free 30-minute purpose discovery call on TidyCal. Everyone who books is automatically added to the waitlist. You will receive the launch date, an early-bird discount code, and first access to the A.L.I.G.N. course before public release.",
  },
  {
    question: "Will the A.L.I.G.N. course be available in Spanish?",
    answer:
      "Yes. Angie Pichardo serves women in both English and Spanish. The A.L.I.G.N. framework, the course materials, and the Still Here devotional will both be released in English first and then in Spanish. Join the waitlist to be notified when the Spanish edition drops.",
  },
  {
    question: "What is the A.L.I.G.N. framework?",
    answer:
      "A.L.I.G.N. is the five-step path Angie built for the woman who is still stuck. A — Awareness, naming what is keeping you there. L — Love Yourself, dissolving shame and self-sabotage. I — Invite God In, surrendering the outcome. G — Gratitude, rewiring the middle of the journey. N — Nurture Positivity, protecting what God is building. The letters spell the path out of stuck and into purpose.",
  },
  {
    question: "Can I pre-order the book Unleash Your Greatness?",
    answer:
      "Pre-order details for Unleash Your Greatness (September 2026) will be shared with the waitlist first. The book is a multi-author collaboration, and Angie's chapter focuses on the A.L.I.G.N. path: the moment of surrender that turns a still-here story into a God-given assignment.",
  },
];

// Coming-soon resources. Descriptions are pulled from Angie's own public
// announcement copy (same as the original store template). No fake prices.
const resources = [
  {
    eyebrow: "Self-paced course",
    title: "A.L.I.G.N. — The Five Letters",
    blurb:
      "A self-paced video course walking through each of the five letters — Awareness, Love Yourself, Invite God, Gratitude, Nurture. Scripture-anchored, with reflection guides and a private community.",
    status: "Waitlist",
    statusLabel: "Coming 2026",
    icon: "course",
  },
  {
    eyebrow: "30-day devotional",
    title: "Still Here — 30 Days for the Woman Still Struggling",
    blurb:
      "A 30-day devotional for the season between survival and breakthrough. One scripture, one reflection, one prayer — for the woman who is still here and still wondering why.",
    status: "Waitlist",
    statusLabel: "Coming 2026",
    icon: "devotional",
  },
  {
    eyebrow: "Co-authored book",
    title: "Unleash Your Greatness: The Journey to Impact",
    blurb:
      "A co-authored book releasing September 2026. Angie contributes a chapter on the A.L.I.G.N. path — the moment of surrender that turns a still-here story into a God-given assignment.",
    status: "Pre-order",
    statusLabel: "September 2026",
    icon: "book",
  },
];

const WAITLIST_URL = "https://tidycal.com/angiepspeaks/30min-purpose-discoverycall";

const perks = ["Free to join the waitlist", "Early-bird discount for members", "English & Spanish"];

const reasons = [
  { t: "First access", d: "Doors open for the waitlist 24 hours before the public release." },
  { t: "Direct line to Angie", d: "Waitlist members can book a free purpose discovery call. Angie personally responds within 24 hours." },
];

const categories = [
  { key: "all", label: "All" },
  { key: "course", label: "Course" },
  { key: "devotional", label: "Devotional" },
  { key: "book", label: "Book" },
];

// Angie's own lines, all taken from existing site copy.
const phrases = [
  "You're still here for a reason.",
  "God can rewrite any story.",
  "Transformation does not require every answer today.",
  "Self-care isn't selfish, it's stewardship.",
  "Refill the cup you pour from all day.",
  "From stuck to purpose.",
  "Still here.",
  "You were made for more than just getting by.",
  "Walk in first.",
];

const trust = [
  { icon: "gift", label: "Free to join the waitlist" },
  { icon: "tag", label: "Early-bird discount for members" },
  { icon: "globe", label: "English & Spanish" },
  { icon: "chat", label: "Angie responds within 24 hours" },
];

// Schema.org FAQPage — Google rich results + AI engine extraction.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

// Schema.org WebPage — defines the page type and topic for crawlers.
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Angie Pichardo — Resources & Store",
  url: "https://graceafterthegrave.com/store/",
  description:
    "The official A.L.I.G.N. resource hub. Self-paced course, 30-day devotional, and the forthcoming book Unleash Your Greatness, from Christian motivational speaker Angie Pichardo.",
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "Angie Pichardo — Christian Speaker & Life Coach",
    url: "https://graceafterthegrave.com",
  },
  about: {
    "@type": "Thing",
    name: "A.L.I.G.N. Framework",
    description:
      "A five-step path: Awareness, Love Yourself, Invite God, Gratitude, Nurture Positivity.",
  },
  audience: {
    "@type": "PeopleAudience",
    audienceType:
      "Christian women seeking purpose, faith-based resources, and life coaching",
  },
};

// Schema.org BreadcrumbList — helps search engines understand site structure.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://graceafterthegrave.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Store",
      item: "https://graceafterthegrave.com/store/",
    },
  ],
};
---

<MainLayout
  title="Resources & Store — Angie Pichardo | A.L.I.G.N. Course & Devotionals"
  description="The official A.L.I.G.N. resource hub from Angie Pichardo. Self-paced course, 30-day Still Here devotional, and the book Unleash Your Greatness launching 2026. Join the waitlist for early-bird access."
  canonicalPath="/store/"
  keywords={[
    "Angie Pichardo store",
    "A.L.I.G.N. course",
    "Christian devotionals for women",
    "faith-based course A.L.I.G.N.",
    "Christian women life coaching materials",
    "self-paced Christian course 2026",
    "Still Here devotional Angie Pichardo",
    "Unleash Your Greatness book",
    "A.L.I.G.N. framework resources",
  ]}
>

  {/* HERO — headline, waitlist CTA, floating product collage */}
  <section
    aria-labelledby="store-hero-heading"
    class="relative isolate overflow-hidden w-full text-angie-cream"
    style="background-image:radial-gradient(48rem 32rem at 88% 8%,rgb(227 183 120/0.28),transparent 62%),radial-gradient(40rem 30rem at 0% 100%,rgb(196 101 138/0.38),transparent 60%),linear-gradient(135deg,#1f0612 0%,#4a0d28 38%,#6b1d44 62%,#2a0818 100%)"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <span class="absolute top-24 left-[6%] w-24 h-24 rounded-full border border-angie-gold/40 animate-float-soft"></span>
      <span class="absolute bottom-16 left-[42%] w-10 h-10 rounded-full bg-angie-peach/30 animate-float-soft" style="animation-delay:1.5s"></span>
      <span class="absolute top-40 right-[8%] w-16 h-16 rounded-full bg-gradient-to-br from-angie-gold/50 to-angie-rose/30 animate-float-soft" style="animation-delay:3s"></span>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-28 md:pt-40 pb-14 md:pb-24 grid md:grid-cols-12 gap-x-12 gap-y-12 items-center">
      <div class="md:col-span-6">
        <h1 id="store-hero-heading" class="font-Frauce font-bold leading-[1] text-[clamp(2.5rem,6vw,4.75rem)] tracking-tight text-balance animate-rise">
          Tools to walk the path at your own pace.
        </h1>
        <p class="mt-6 measure text-angie-cream/90 text-lg md:text-xl leading-relaxed animate-rise" style="animation-delay:120ms">
          The A.L.I.G.N. store opens in 2026. Courses, devotionals, and the forthcoming book, each built to be picked up in the middle of a hard season and walked out slowly.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-x-8 gap-y-4 animate-rise" style="animation-delay:240ms">
          <a
            href={WAITLIST_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Join the waitlist (opens in a new tab)"
            class="btn btn-light hover:animate-tada self-start"
          >
            Join the waitlist
          </a>
          <a href="#shelf" class="link-arrow min-h-11">
            See what's coming
          </a>
        </div>
      </div>

      <div class="md:col-span-6 animate-zoom-in" style="animation-delay:160ms">
        <div class="relative mx-auto w-full max-w-xl aspect-[5/4]">
          <div class="absolute left-0 top-0 w-[68%] animate-float-soft">
            <img
              src="/images/popups/popup-mockup-3-darkwood.webp"
              alt="A burgundy hardcover book on dark wood beside a candle and olive leaves"
              width="1120"
              height="630"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full aspect-[4/5] object-cover object-[50%_50%] rounded-2xl -rotate-3 shadow-[0_24px_50px_rgb(0_0_0/0.5)] ring-1 ring-angie-peach/40"
            />
          </div>
          <div class="absolute right-0 bottom-0 w-[58%] animate-float-soft" style="animation-delay:2s">
            <img
              src="/images/popups/popup-mockup-1-wooden.webp"
              alt="A rose-pink hardcover journal on a wooden table with a pen and a cup of tea"
              width="1120"
              height="630"
              loading="eager"
              decoding="async"
              class="w-full aspect-square object-cover object-[50%_50%] rounded-2xl rotate-3 shadow-[0_24px_50px_rgb(0_0_0/0.5)] ring-1 ring-angie-gold/50"
            />
          </div>
          <p class="absolute left-[4%] bottom-[4%] card-glass px-4 py-2.5 font-Grotesk-bold text-angie-cream">
            Coming 2026
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* PHRASE MARQUEE — Angie's own words */}
  <div class="w-full bg-[linear-gradient(90deg,#4a0d28,#8a2654_50%,#4a0d28)] border-y border-angie-gold/30">
    <PhraseMarquee phrases={phrases} />
  </div>

  {/* SHELF — filter chips + product cards */}
  <section
    id="shelf"
    aria-labelledby="coming-soon-heading"
    data-shelf
    class="relative isolate overflow-hidden w-full text-angie-cream"
    style="background-image:radial-gradient(44rem 30rem at 10% 4%,rgb(247 201 182/0.2),transparent 62%),radial-gradient(46rem 34rem at 100% 55%,rgb(196 101 138/0.32),transparent 60%),radial-gradient(30rem 24rem at 20% 100%,rgb(227 183 120/0.18),transparent 60%),linear-gradient(170deg,#2a0818 0%,#4a0d28 35%,#6b1d44 65%,#1f0612 100%)"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <span class="absolute top-[18%] right-[5%] w-28 h-28 rounded-full border border-angie-peach/30 animate-float-soft" style="animation-delay:1s"></span>
      <span class="absolute bottom-[10%] left-[3%] w-14 h-14 rounded-full bg-gradient-to-br from-angie-gold/40 to-angie-peach/20 animate-float-soft" style="animation-delay:2.5s"></span>
    </div>

    <div class="max-w-6xl mx-auto px-6 pt-16 md:pt-24 pb-16 md:pb-24">
      <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="max-w-2xl">
          <h2 id="coming-soon-heading" class="font-Frauce font-bold text-[clamp(2rem,4.2vw,3.25rem)] leading-[1.05] text-balance">What's coming to the store</h2>
          <p class="mt-4 measure text-angie-cream/90 text-lg leading-relaxed">
            Each resource is built around the A.L.I.G.N. framework. Pick the one that meets you where you are today.
          </p>
        </div>

        <div role="group" aria-label="Filter products" class="flex flex-wrap gap-2.5">
          {categories.map((c, i) => (
            <button
              type="button"
              data-filter={c.key}
              aria-pressed={i === 0 ? "true" : "false"}
              class="btn btn-glass !min-h-11 !px-5 aria-pressed:!bg-angie-cream aria-pressed:!text-angie-noir aria-pressed:!border-transparent"
            >
              {c.label}
            </button>
          ))}
        </div>
      </header>

      <p data-shelf-status class="sr-only" role="status" aria-live="polite"></p>

      <ul class="mt-10 md:mt-12 grid md:grid-cols-2 gap-6 md:gap-8">
        <ProductCard
          category="course"
          typeLabel="Self-paced course"
          title="A.L.I.G.N. — The Five Letters"
          blurb="A self-paced video course walking through each of the five letters. Scripture-anchored, with reflection guides and a private community."
          status="Coming 2026"
          priceNote="Early-bird price for the waitlist"
          href={WAITLIST_URL}
          image="/images/services/coach.webp"
          imageAlt="Angie Pichardo smiling, wearing a burgundy plaid blazer"
          imageWidth={1045}
          imageHeight={1400}
          imagePosition="50% 15%"
          featured
          details={["Awareness", "Love Yourself", "Invite God", "Gratitude", "Nurture Positivity", "Reflection guides and a private community"]}
        />
        <ProductCard
          category="devotional"
          typeLabel="30-day devotional"
          title="Still Here — 30 Days for the Woman Still Struggling"
          blurb="One scripture, one reflection, one prayer, for the woman who is still here and still wondering why."
          status="Coming 2026"
          priceNote="Price announced at launch"
          href={WAITLIST_URL}
          image="/images/popups/popup-mockup-3-darkwood.webp"
          imageAlt="A burgundy hardcover devotional on dark wood beside a lit candle and olive leaves"
          imageWidth={1120}
          imageHeight={630}
          imagePosition="50% 50%"
        />
        <ProductCard
          category="book"
          typeLabel="Co-authored book"
          title="Unleash Your Greatness: The Journey to Impact"
          blurb="Angie contributes a chapter on the A.L.I.G.N. path: the moment of surrender that turns a still-here story into a God-given assignment."
          status="Pre-order September 2026"
          priceNote="Price announced at launch"
          href={WAITLIST_URL}
          image="/images/popups/popup-mockup-2-marble.webp"
          imageAlt="A white embossed hardcover book on a marble table beside a gold pen and a succulent"
          imageWidth={1120}
          imageHeight={630}
          imagePosition="50% 50%"
        />
      </ul>

      {/* Trust strip — perks that already exist in the copy */}
      <ul class="mt-10 md:mt-12 card-glass grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden bg-angie-cream/10">
        {trust.map((t) => (
          <li class="flex items-start gap-3 p-5 bg-angie-noir/55">
            <svg viewBox="0 0 24 24" class="mt-0.5 w-6 h-6 shrink-0 text-angie-gold" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {t.icon === "gift" && (<><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"></path><path d="M7.5 8a2.5 2.5 0 1 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 1 1 0 5"></path></>)}
              {t.icon === "tag" && (<><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"></path><circle cx="7.5" cy="7.5" r="1.2"></circle></>)}
              {t.icon === "globe" && (<><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></>)}
              {t.icon === "chat" && (<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path>)}
            </svg>
            <span class="text-angie-cream/95 leading-snug">{t.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* START HERE — bundle block + why join, on a lively light plane */}
  <section
    aria-labelledby="start-here-heading"
    class="relative isolate overflow-hidden w-full text-angie-noir"
    style="background-image:radial-gradient(40rem 28rem at 90% 0%,rgb(227 183 120/0.35),transparent 62%),radial-gradient(36rem 28rem at 0% 100%,rgb(247 201 182/0.7),transparent 60%),linear-gradient(160deg,#FFF5FA 0%,#FBC2EB 55%,#E8A0B8 100%)"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <span class="absolute top-10 left-[45%] w-20 h-20 rounded-full border border-angie-burgundy/25 animate-float-soft"></span>
      <span class="absolute bottom-12 right-[6%] w-12 h-12 rounded-full bg-angie-gold/40 animate-float-soft" style="animation-delay:2s"></span>
    </div>

    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-12 gap-x-10 gap-y-8 items-stretch">
      <div class="md:col-span-7 card-glass-light overflow-hidden grid sm:grid-cols-5">
        <div class="sm:col-span-2 relative min-h-48 sm:min-h-full">
          <img
            src="/images/popups/popup-mockup-1-wooden.webp"
            alt="A rose-pink hardcover journal on a wooden table with a gold pen and a cup of tea"
            width="1120"
            height="630"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover object-[50%_50%]"
          />
        </div>
        <div class="sm:col-span-3 p-6 md:p-8">
          <h2 id="start-here-heading" class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1] text-balance">Start here: the first two to open</h2>
          <p class="mt-4 text-angie-noir/85 text-lg leading-relaxed">
            Most offerings launch in 2026 alongside the book release. The self-paced A.L.I.G.N. course and the Still Here devotional are the first two to open.
          </p>
          <p class="mt-3 text-angie-noir/85 text-lg leading-relaxed">
            Join the waitlist to be the first to know when doors open, and to receive an early-bird discount.
          </p>
          <a
            href={WAITLIST_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Join the waitlist for the course and the devotional (opens in a new tab)"
            class="btn btn-glass-dark mt-6 w-full sm:w-auto"
          >
            Join the waitlist
          </a>
        </div>
      </div>

      <div class="md:col-span-5 flex flex-col justify-center">
        <h2 id="why-waitlist-heading" class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1]">Why join the waitlist?</h2>
        <dl class="mt-5 card-glass-light px-6">
          {reasons.map((r) => (
            <div class="py-5 border-b border-angie-noir/15">
              <dt class="font-Frauce font-bold text-2xl">{r.t}</dt>
              <dd class="mt-2 text-angie-noir/85 text-lg leading-relaxed">{r.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  {/* FAQ — nocturne plane, details rows */}
  <section
    id="faq"
    aria-labelledby="store-faq-heading"
    class="relative isolate overflow-hidden w-full text-angie-cream"
    style="background-image:radial-gradient(40rem 30rem at 100% 0%,rgb(196 101 138/0.3),transparent 60%),radial-gradient(34rem 26rem at 0% 100%,rgb(227 183 120/0.14),transparent 60%),linear-gradient(135deg,#1f0612 0%,#3a0820 30%,#6b1d44 55%,#3a0820 80%,#1f0612 100%)"
  >
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-12 gap-x-12 gap-y-8">
      <header class="md:col-span-4">
        <h2 id="store-faq-heading" class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1]">About the A.L.I.G.N. resources</h2>
        <p class="mt-4 text-angie-cream/85 text-lg leading-relaxed">The same questions I get after every keynote and coaching call. If yours isn't here, send it over.</p>
      </header>
      <div class="md:col-span-8 card-glass px-6">
        {faqs.map((faq) => (
          <details class="group/faq border-b border-angie-cream/20">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4 min-h-14 py-4 font-Frauce font-bold text-lg md:text-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-angie-rose [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg aria-hidden="true" class="shrink-0 w-5 h-5 text-angie-rose transition-transform duration-300 group-open/faq:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </summary>
            <p class="pb-5 pr-9 measure text-angie-cream/90 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* FINAL CTA */}
  <section aria-label="Join the waitlist and book a purpose discovery call" class="relative isolate overflow-hidden w-full bg-gradient-zion text-angie-cream">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <span class="absolute -top-10 right-[10%] w-40 h-40 rounded-full bg-angie-gold/20 animate-float-soft"></span>
      <span class="absolute bottom-6 left-[8%] w-16 h-16 rounded-full border border-angie-cream/30 animate-float-soft" style="animation-delay:2s"></span>
    </div>
    <div class="max-w-6xl mx-auto px-6 py-14 md:py-20 grid md:grid-cols-12 gap-x-12 gap-y-8 items-end">
      <div class="md:col-span-8">
        <h2 class="font-Frauce font-bold text-[clamp(2rem,5vw,3.75rem)] leading-[1.05] text-balance">
          The store opens in 2026. Walk in first.
        </h2>
        <p class="mt-5 measure text-angie-cream/90 text-lg leading-relaxed">
          Book a free 30-minute purpose discovery call. Everyone who books is added to the waitlist, gets the early-bird discount, and first access when the A.L.I.G.N. course launches.
        </p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a
          href={WAITLIST_URL}
          target="_blank"
          rel="noopener noreferrer"
