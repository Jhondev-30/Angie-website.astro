---

import MainLayout from "../layout/MainLayout.astro";

// FAQ content — SEO-optimized, answers the real "Angie Pichardo resources"
// questions people ask after the keynote or coaching intro call.
const faqs = [
  {
    question: "When does the A.L.I.G.N. store open?",
    answer:
      "The store officially opens in 2026, alongside the release of the book Unleash Your Greatness. The A.L.I.G.N. self-paced course and the Still Here 30-day devotional are the first two products. Join the waitlist to get the launch date and an early-bird discount the moment doors open.",
  },
  {
    question: "What products will be available in the store?",
    answer:
      "Three core resources built around the A.L.I.G.N. framework: a self-paced A.L.I.G.N. course (Awareness, Love Yourself, Invite God, Gratitude, Nurture), the Still Here 30-day devotional for women in the season between survival and breakthrough, and Angie's chapter contribution to the co-authored book Unleash Your Greatness (September 2026).",
  },
  {
    question: "How do I join the waitlist?",
    answer:
      "Book a free 30-minute purpose discovery call on TidyCal. Everyone who books is automatically added to the waitlist. You will receive the launch date, an early-bird discount code, and first access to the A.L.I.G.N. course before public release.",
  },
  {
    question: "Will the A.L.I.G.N. course be available in Spanish?",
    answer:
      "Yes. Angie Pichardo serves women in both English and Spanish. The A.L.I.G.N. framework, the course materials, and the Still Here devotional will both be released in English first and then in Spanish. Join the waitlist to be notified when the Spanish edition drops.",
  },
  {
    question: "What is the A.L.I.G.N. framework?",
    answer:
      "A.L.I.G.N. is the five-step path Angie built for the woman who is still stuck. A — Awareness, naming what is keeping you there. L — Love Yourself, dissolving shame and self-sabotage. I — Invite God In, surrendering the outcome. G — Gratitude, rewiring the middle of the journey. N — Nurture Positivity, protecting what God is building. The letters spell the path out of stuck and into purpose.",
  },
  {
    question: "Can I pre-order the book Unleash Your Greatness?",
    answer:
      "Pre-order details for Unleash Your Greatness (September 2026) will be shared with the waitlist first. The book is a multi-author collaboration, and Angie's chapter focuses on the A.L.I.G.N. path: the moment of surrender that turns a still-here story into a God-given assignment.",
  },
];

// Coming-soon resources. Descriptions are pulled from Angie's own public
// announcement copy (same as the original store template). No fake prices.
const resources = [
  {
    eyebrow: "Self-paced course",
    title: "A.L.I.G.N. — The Five Letters",
    blurb:
      "A self-paced video course walking through each of the five letters — Awareness, Love Yourself, Invite God, Gratitude, Nurture. Scripture-anchored, with reflection guides and a private community.",
    status: "Waitlist",
    statusLabel: "Coming 2026",
    icon: "course",
  },
  {
    eyebrow: "30-day devotional",
    title: "Still Here — 30 Days for the Woman Still Struggling",
    blurb:
      "A 30-day devotional for the season between survival and breakthrough. One scripture, one reflection, one prayer — for the woman who is still here and still wondering why.",
    status: "Waitlist",
    statusLabel: "Coming 2026",
    icon: "devotional",
  },
  {
    eyebrow: "Co-authored book",
    title: "Unleash Your Greatness: The Journey to Impact",
    blurb:
      "A co-authored book releasing September 2026. Angie contributes a chapter on the A.L.I.G.N. path — the moment of surrender that turns a still-here story into a God-given assignment.",
    status: "Pre-order",
    statusLabel: "September 2026",
    icon: "book",
  },
];

// Per-card visual accent — each "What's Coming" resource gets its own
// character so the trio doesn't read as three identical clones (no AI slop).
// Variants stay inside the established palette: rose / cream / burgundy.
const cardAccents = [
  {
    // 0 — A.L.I.G.N. course (warm rose, the "starting point" of the path)
    border: "border-white/20 hover:border-angie-rose/55",
    glass: "bg-angie-noir/55",
    glassHover: "hover:bg-angie-noir/70",
    baseShadow: "shadow-angie-noir/30",
    hoverShadow: "hover:shadow-angie-rose/35",
    accentLine:
      "bg-gradient-to-r from-angie-rose via-angie-burgundy/70 to-transparent",
    overlay:
      "bg-[radial-gradient(ellipse_120%_80%_at_top_left,rgba(196,101,138,0.28),transparent_55%),linear-gradient(135deg,rgba(255,255,255,0.05)_0%,transparent_45%)]",
    iconBg: "bg-angie-noir",
    iconColor: "text-white",
    iconBorder: "border-angie-rose/50",
    statusBg:
      "bg-angie-rose/20 border-angie-rose/55 text-angie-rose shadow-[0_0_18px_-4px_rgba(196,101,138,0.65)]",
    letterColor: "text-angie-burgundy/15",
  },
  {
    // 1 — Still Here devotional (soft cream, the "intimate middle")
    border: "border-white/20 hover:border-angie-cream/55",
    glass: "bg-angie-noir/55",
    glassHover: "hover:bg-angie-noir/70",
    baseShadow: "shadow-angie-noir/30",
    hoverShadow: "hover:shadow-angie-cream/25",
    accentLine:
      "bg-gradient-to-r from-angie-cream/95 via-angie-rose/70 to-transparent",
    overlay:
      "bg-[radial-gradient(ellipse_120%_80%_at_top_left,rgba(255,245,250,0.22),transparent_55%),linear-gradient(135deg,rgba(196,101,138,0.10)_0%,transparent_45%)]",
    iconBg: "bg-linear-to-br from-angie-cream/40 to-angie-rose/25",
    iconColor: "text-angie-burgundy",
    iconBorder: "border-angie-cream/40",
    statusBg:
      "bg-angie-cream/18 border-angie-cream/50 text-angie-cream shadow-[0_0_18px_-4px_rgba(255,245,250,0.55)]",
    letterColor: "text-angie-rose/18",
  },
  {
    // 2 — Unleash Your Greatness book (deep burgundy, the "premium finish")
    border: "border-white/20 hover:border-angie-burgundy/65",
    glass: "bg-angie-noir/55",
    glassHover: "hover:bg-angie-noir/70",
    baseShadow: "shadow-angie-noir/30",
    hoverShadow: "hover:shadow-angie-burgundy/40",
    accentLine:
      "bg-gradient-to-r from-angie-burgundy via-angie-wine/80 to-transparent",
    overlay:
      "bg-[radial-gradient(ellipse_120%_80%_at_top_left,rgba(138,38,84,0.32),transparent_55%),linear-gradient(135deg,rgba(74,13,40,0.14)_0%,transparent_45%)]",
    iconBg: "bg-angie-noir",
    iconColor: "text-white",
    iconBorder: "border-angie-burgundy/60",
    statusBg:
      "bg-angie-burgundy/30 border-angie-burgundy/60 text-angie-rose shadow-[0_0_18px_-4px_rgba(138,38,84,0.75)]",
    letterColor: "text-angie-noir/18",
  },
];

// One oversized letter per card — A, S, U — silently echoes the
// A.L.I.G.N. initials and the resource name. Sits behind the content
// as a quiet decorative anchor, only visible because the card lifts on hover.
const cardLetters = ["A", "S", "U"];

// Per-card "Why join the waitlist" accents — same family as the
// "What's Coming" cards, but with two distinct colors (rose = launch,
// burgundy = personal line) so the section reads as a coherent pair.
const waitlistAccents = [
  {
    border: "border-white/20 hover:border-angie-rose/55",
    glass: "bg-angie-noir/55",
    glassHover: "hover:bg-angie-noir/70",
    baseShadow: "shadow-angie-noir/30",
    hoverShadow: "hover:shadow-angie-rose/35",
    overlay:
      "bg-[radial-gradient(ellipse_120%_80%_at_top_left,rgba(196,101,138,0.26),transparent_55%)]",
    iconBg: "bg-linear-to-br from-angie-rose/55 to-angie-burgundy/30",
    iconColor: "text-white",
    iconBorder: "border-angie-rose/45",
    numberColor: "text-angie-burgundy/15",
  },
  {
    border: "border-white/20 hover:border-angie-burgundy/65",
    glass: "bg-angie-noir/55",
    glassHover: "hover:bg-angie-noir/70",
    baseShadow: "shadow-angie-noir/30",
    hoverShadow: "hover:shadow-angie-burgundy/40",
    overlay:
      "bg-[radial-gradient(ellipse_120%_80%_at_top_left,rgba(138,38,84,0.30),transparent_55%)]",
    iconBg: "bg-linear-to-br from-angie-burgundy/55 to-angie-wine/35",
    iconColor: "text-white",
    iconBorder: "border-angie-burgundy/50",
    numberColor: "text-angie-noir/15",
  },
];

// Subtle dot grid overlay (decorative, low-contrast). Used to break
// the flat feel of the nocturne background without competing with content.
const dotPattern =
  "bg-[radial-gradient(rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:22px_22px]";

// "Twilight rose" — light gradient (cream → rose → burgundy) used
// for the "What's Coming" and "Why join the waitlist" sections to
// break the dark rhythm. Palette is 100% reused from global.css tokens
// (cream / gradient-rose / rose / burgundy) so it harmonizes with the
// dark sections around it. Cards in these sections use DARK glass
// (angie-noir with alpha) so the white text + colored pills stay
// readable on the light bg.
const twilightBg =
  "bg-[linear-gradient(160deg,#FFF5FA_0%,#FBC2EB_28%,#C4658A_62%,#8A2654_100%)]";

// Dot pattern tuned for the light gradient — dark dots on light bg,
// in place of the white-on-dark version used in the nocturne sections.
const twilightDot =
  "bg-[radial-gradient(rgba(31,6,18,0.06)_1px,transparent_1px)] bg-[size:22px_22px]";

// Icon helper — inline SVGs matching the rest of the site's icon style.
const iconFor = (key: string) => {
  switch (key) {
    case "course":
      return `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>`;
    case "devotional":
      return `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>`;
    case "book":
      return `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path><path d="M9 7h7M9 11h7"></path>`;
    default:
      return "";
  }
};

// Schema.org FAQPage — Google rich results + AI engine extraction.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

// Schema.org WebPage — defines the page type and topic for crawlers.
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Angie Pichardo — Resources & Store",
  url: "https://graceafterthegrave.com/store/",
  description:
    "The official A.L.I.G.N. resource hub. Self-paced course, 30-day devotional, and the forthcoming book Unleash Your Greatness, from Christian motivational speaker Angie Pichardo.",
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "Angie Pichardo — Christian Speaker & Life Coach",
    url: "https://graceafterthegrave.com",
  },
  about: {
    "@type": "Thing",
    name: "A.L.I.G.N. Framework",
    description:
      "A five-step path: Awareness, Love Yourself, Invite God, Gratitude, Nurture Positivity.",
  },
  audience: {
    "@type": "PeopleAudience",
    audienceType:
      "Christian women seeking purpose, faith-based resources, and life coaching",
  },
};

// Schema.org BreadcrumbList — helps search engines understand site structure.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://graceafterthegrave.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Store",
      item: "https://graceafterthegrave.com/store/",
    },
  ],
};
---

<MainLayout
  title="Resources & Store — Angie Pichardo | A.L.I.G.N. Course & Devotionals"
  description="The official A.L.I.G.N. resource hub from Angie Pichardo. Self-paced course, 30-day Still Here devotional, and the book Unleash Your Greatness launching 2026. Join the waitlist for early-bird access."
  canonicalPath="/store/"
  keywords={[
    "Angie Pichardo store",
    "A.L.I.G.N. course",
    "Christian devotionals for women",
    "faith-based course A.L.I.G.N.",
    "Christian women life coaching materials",
    "self-paced Christian course 2026",
    "Still Here devotional Angie Pichardo",
    "Unleash Your Greatness book",
    "A.L.I.G.N. framework resources",
  ]}
>
  <!--
    =====================================================
    HERO — Dark gradient + glassmorphism pattern
    Matches the wellness.astro + index.astro visual language:
    bg-gradient-nocturne allows translucent glass cards behind it.
    =====================================================
  -->
  <section
    title="store-hero"
    aria-labelledby="store-hero-heading"
    class="relative overflow-hidden bg-gradient-nocturne w-full min-h-[80dvh] md:min-h-[88dvh] flex items-center justify-center px-4 md:px-8"
  >
    <!-- Decorative glow orbs (background depth) -->
    <div aria-hidden="true" class="absolute top-1/4 -left-20 w-72 h-72 md:w-96 md:h-96 rounded-full bg-angie-rose/15 blur-[100px] pointer-events-none"></div>
    <div aria-hidden="true" class="absolute bottom-1/4 -right-20 w-72 h-72 md:w-96 md:h-96 rounded-full bg-angie-burgundy/25 blur-[100px] pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-10 right-1/3 w-40 h-40 md:w-56 md:h-56 rounded-full bg-angie-wine/30 blur-[80px] pointer-events-none"></div>
    <div aria-hidden="true" class="absolute bottom-10 left-1/3 w-44 h-44 md:w-60 md:h-60 rounded-full bg-angie-cream/8 blur-[90px] pointer-events-none"></div>
    <div aria-hidden="true" class={`absolute inset-0 ${dotPattern} pointer-events-none opacity-60`}></div>

    <div class="relative max-w-4xl mx-auto text-center pt-28 md:pt-32 pb-16">
      <!-- Eyebrow badge -->
   

      <h1
        id="store-hero-heading"
        class="font-Frauce font-bold text-4xl sm:text-5xl md:text-7xl lg:text-8xl text-white leading-[1.02] mb-6 text-balance animate-slide-in-bottom animate-delay-100"
      >
        Tools to walk the path<br />
        <span class="text-angie-rose italic">at your own pace.</span>
      </h1>

      <p class="text-white/85 text-base sm:text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-8 text-pretty animate-fade-in animate-delay-300">
        Courses, devotionals, and the forthcoming book. Each one is built to be picked up in the middle of a hard season and walked out slowly — not crammed, not hustled, not performed.
      </p>

      <p class="text-white/70 text-sm md:text-base leading-relaxed max-w-2xl mx-auto mb-10 text-pretty">
        Resources built around the <span class="font-Grotesk-bold text-white">A.L.I.G.N. Framework</span>
      </p>

      <!-- CTA row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4 animate-fade-in animate-delay-500">
        <a
          href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-white text-angie-noir rounded-full font-Frauce text-base md:text-lg font-bold transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-black/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60 w-full sm:w-auto"
          aria-label="Book a free discovery call and join the store waitlist (opens in a new tab)"
        >
          <span>Join the waitlist</span>
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="/#services"
          class="group relative inline-flex items-center justify-center gap-2.5 px-7 py-3.5 border-2 border-white/80 text-white rounded-full font-Frauce text-base md:text-lg font-bold transition-all duration-300 hover:bg-white hover:text-angie-noir hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60 w-full sm:w-auto"
        >
          <span>Learn about A.L.I.G.N.</span>
        </a>
      </div>

      <!-- Trust strip (micro proof under the CTAs) -->
      <div class="mt-10 md:mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/60 text-xs md:text-sm font-Grotesk">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-angie-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Free to join the waitlist
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-angie-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Early-bird discount for members
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-angie-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          English &amp; Spanish
        </span>
      </div>
    </div>
  </section>

  <!--
    =====================================================
    COMING SOON — Glass cards grid
    Pattern: bg-white/4 + backdrop-blur-xl + border-white/10
    Same visual language as wellness.astro FAQ cards.
    =====================================================
  -->
  <section
    title="coming-soon"
    aria-labelledby="coming-soon-heading"
    class={`relative ${twilightBg} w-full py-16 md:py-24 overflow-hidden`}
  >
    <!-- Atmospheric orbs + dot grid — light section variant.
         White/cream glows + darker rose accents play on the light bg
         the way the colored glows play on the dark nocturne sections. -->
    <div aria-hidden="true" class="absolute -top-10 left-1/4 w-72 h-72 md:w-96 md:h-96 rounded-full bg-white/35 blur-[120px] pointer-events-none"></div>
    <div aria-hidden="true" class="absolute -bottom-10 right-1/4 w-80 h-80 md:w-md md:h-112 rounded-full bg-angie-cream/45 blur-[120px] pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60%] h-32 md:h-48 rounded-full bg-angie-burgundy/20 blur-[100px] pointer-events-none"></div>
    <div aria-hidden="true" class={`absolute inset-0 ${twilightDot} pointer-events-none opacity-80`}></div>
    <!-- Section divider: thin dark line under the hero (dark on light) -->
    <div aria-hidden="true" class="absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-angie-noir/20 to-transparent"></div>
    <div class="relative max-w-6xl mx-auto px-4 md:px-8">
      <header class="text-center mb-10 md:mb-14">
        <span class="inline-block font-Grotesk-bold text-[11px] md:text-xs tracking-[0.25em] uppercase text-angie-burgundy mb-4">
          What's coming
        </span>
        <h2
          id="coming-soon-heading"
          class="font-Frauce font-bold text-4xl md:text-5xl lg:text-6xl text-angie-noir leading-tight mb-4 text-balance"
        >
          Three resources. One path.
        </h2>
        <p class="text-angie-noir/75 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Each resource walks one letter of the A.L.I.G.N. framework. Pick the one that meets you where you are today.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {
          resources.map((r, i) => {
            const a = cardAccents[i] ?? cardAccents[0];
            return (
            <article class={`group relative overflow-hidden rounded-2xl md:rounded-3xl p-6 md:p-7 ${a.glass} ${a.glassHover} backdrop-blur-xl border ${a.border} shadow-2xl ${a.baseShadow} transition-all duration-500 hover:-translate-y-1.5 ${a.hoverShadow} flex flex-col timeline-view animate-range-[5%_20%] animate-slide-in-bottom animate-delay-${(i + 1) * 100}`}>
              <!-- Top accent line (per-card color, lights up on hover) -->
              <div aria-hidden="true" class={`absolute top-0 left-0 right-0 h-0.5 ${a.accentLine} opacity-70 group-hover:opacity-100 transition-opacity duration-500`}></div>

              <!-- Per-card radial gradient overlay (gives each card its own mood) -->
              <div aria-hidden="true" class={`absolute inset-0 rounded-2xl md:rounded-3xl ${a.overlay} pointer-events-none`}></div>

              <!-- Top-left glass highlight (preserved from original pattern) -->
              <div aria-hidden="true" class="absolute inset-0 rounded-2xl md:rounded-3xl bg-linear-to-br from-white/6 via-transparent to-transparent pointer-events-none"></div>

              <!-- Oversized letter mark (A / S / U) — silent visual anchor behind the content -->
              <div aria-hidden="true" class={`absolute -right-2 -bottom-8 md:-right-3 md:-bottom-10 font-Frauce text-[150px] md:text-[200px] font-bold leading-none ${a.letterColor} italic select-none pointer-events-none transition-all duration-500 group-hover:scale-105`}>
                {cardLetters[i] ?? ""}
              </div>

              <div class="relative flex flex-col h-full">
                <!-- Icon + status row -->
                <div class="flex items-start justify-between gap-3 mb-5">
                  <div class={`inline-flex w-14 h-14 md:w-16 md:h-16 rounded-2xl ${a.iconBg} ${a.iconBorder} border items-center justify-center ${a.iconColor} group-hover:scale-110 group-hover:rotate-3 transition-all duration-500 shadow-lg shadow-black/20`}>
                    <svg class="w-7 h-7 md:w-8 md:h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconFor(r.icon)} />
                  </div>
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-full backdrop-blur-sm border text-[10px] font-Grotesk-bold tracking-[0.15em] uppercase ${a.statusBg}`}>
                    {r.statusLabel}
                  </span>
                </div>

                <!-- Eyebrow -->
                <p class="font-Grotesk-bold text-[10px] md:text-xs tracking-[0.25em] uppercase text-angie-burgundy mb-2">
                  {r.eyebrow}
                </p>

                <!-- Title -->
                <h3 class="font-Frauce font-bold text-xl md:text-2xl text-white leading-snug mb-3 text-balance">
                  {r.title}
                </h3>

                <!-- Blurb -->
                <p class="text-white/75 text-sm md:text-[15px] leading-relaxed mb-6 flex-1 text-pretty">
                  {r.blurb}
                </p>

                <!-- Footer: status + CTA -->
                <div class="pt-5 border-t border-white/10 flex items-center justify-between gap-3">
                  <p class="font-Grotesk-bold text-[10px] md:text-xs tracking-[0.2em] uppercase text-white/55">
