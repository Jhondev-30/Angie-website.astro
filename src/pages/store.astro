---

import MainLayout from "../layout/MainLayout.astro";

// FAQ content — SEO-optimized, answers the real "Angie Pichardo resources"
// questions people ask after the keynote or coaching intro call.
const faqs = [
  {
    question: "When does the A.L.I.G.N. store open?",
    answer:
      "The store officially opens in 2026, alongside the release of the book Unleash Your Greatness. The A.L.I.G.N. self-paced course and the Still Here 30-day devotional are the first two products. Join the waitlist to get the launch date and an early-bird discount the moment doors open.",
  },
  {
    question: "What products will be available in the store?",
    answer:
      "Three core resources built around the A.L.I.G.N. framework: a self-paced A.L.I.G.N. course (Awareness, Love Yourself, Invite God, Gratitude, Nurture), the Still Here 30-day devotional for women in the season between survival and breakthrough, and Angie's chapter contribution to the co-authored book Unleash Your Greatness (September 2026).",
  },
  {
    question: "How do I join the waitlist?",
    answer:
      "Book a free 30-minute purpose discovery call on TidyCal. Everyone who books is automatically added to the waitlist. You will receive the launch date, an early-bird discount code, and first access to the A.L.I.G.N. course before public release.",
  },
  {
    question: "Will the A.L.I.G.N. course be available in Spanish?",
    answer:
      "Yes. Angie Pichardo serves women in both English and Spanish. The A.L.I.G.N. framework, the course materials, and the Still Here devotional will both be released in English first and then in Spanish. Join the waitlist to be notified when the Spanish edition drops.",
  },
  {
    question: "What is the A.L.I.G.N. framework?",
    answer:
      "A.L.I.G.N. is the five-step path Angie built for the woman who is still stuck. A — Awareness, naming what is keeping you there. L — Love Yourself, dissolving shame and self-sabotage. I — Invite God In, surrendering the outcome. G — Gratitude, rewiring the middle of the journey. N — Nurture Positivity, protecting what God is building. The letters spell the path out of stuck and into purpose.",
  },
  {
    question: "Can I pre-order the book Unleash Your Greatness?",
    answer:
      "Pre-order details for Unleash Your Greatness (September 2026) will be shared with the waitlist first. The book is a multi-author collaboration, and Angie's chapter focuses on the A.L.I.G.N. path: the moment of surrender that turns a still-here story into a God-given assignment.",
  },
];

// Coming-soon resources. Descriptions are pulled from Angie's own public
// announcement copy (same as the original store template). No fake prices.
const resources = [
  {
    eyebrow: "Self-paced course",
    title: "A.L.I.G.N. — The Five Letters",
    blurb:
      "A self-paced video course walking through each of the five letters — Awareness, Love Yourself, Invite God, Gratitude, Nurture. Scripture-anchored, with reflection guides and a private community.",
    status: "Waitlist",
    statusLabel: "Coming 2026",
    icon: "course",
  },
  {
    eyebrow: "30-day devotional",
    title: "Still Here — 30 Days for the Woman Still Struggling",
    blurb:
      "A 30-day devotional for the season between survival and breakthrough. One scripture, one reflection, one prayer — for the woman who is still here and still wondering why.",
    status: "Waitlist",
    statusLabel: "Coming 2026",
    icon: "devotional",
  },
  {
    eyebrow: "Co-authored book",
    title: "Unleash Your Greatness: The Journey to Impact",
    blurb:
      "A co-authored book releasing September 2026. Angie contributes a chapter on the A.L.I.G.N. path — the moment of surrender that turns a still-here story into a God-given assignment.",
    status: "Pre-order",
    statusLabel: "September 2026",
    icon: "book",
  },
];

// One oversized letter per card (A, S, U) echoing the A.L.I.G.N. initials.
const cardLetters = ["A", "S", "U"];

// Schema.org FAQPage — Google rich results + AI engine extraction.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

// Schema.org WebPage — defines the page type and topic for crawlers.
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Angie Pichardo — Resources & Store",
  url: "https://graceafterthegrave.com/store/",
  description:
    "The official A.L.I.G.N. resource hub. Self-paced course, 30-day devotional, and the forthcoming book Unleash Your Greatness, from Christian motivational speaker Angie Pichardo.",
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "Angie Pichardo — Christian Speaker & Life Coach",
    url: "https://graceafterthegrave.com",
  },
  about: {
    "@type": "Thing",
    name: "A.L.I.G.N. Framework",
    description:
      "A five-step path: Awareness, Love Yourself, Invite God, Gratitude, Nurture Positivity.",
  },
  audience: {
    "@type": "PeopleAudience",
    audienceType:
      "Christian women seeking purpose, faith-based resources, and life coaching",
  },
};

// Schema.org BreadcrumbList — helps search engines understand site structure.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://graceafterthegrave.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Store",
      item: "https://graceafterthegrave.com/store/",
    },
  ],
};
---

<MainLayout
  title="Resources & Store — Angie Pichardo | A.L.I.G.N. Course & Devotionals"
  description="The official A.L.I.G.N. resource hub from Angie Pichardo. Self-paced course, 30-day Still Here devotional, and the book Unleash Your Greatness launching 2026. Join the waitlist for early-bird access."
  canonicalPath="/store/"
  keywords={[
    "Angie Pichardo store",
    "A.L.I.G.N. course",
    "Christian devotionals for women",
    "faith-based course A.L.I.G.N.",
    "Christian women life coaching materials",
    "self-paced Christian course 2026",
    "Still Here devotional Angie Pichardo",
    "Unleash Your Greatness book",
    "A.L.I.G.N. framework resources",
  ]}
>

  {/* ============================================================
      HERO — split layout, mobile-first. Promise + waitlist CTA.
  ============================================================ */}
  <section aria-labelledby="store-hero-heading" class="relative isolate overflow-hidden w-full bg-angie-noir text-angie-cream">
    <div aria-hidden="true" class="absolute -top-32 -left-24 w-[26rem] h-[26rem] rounded-full bg-angie-burgundy/40 blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute -bottom-40 -right-24 w-[28rem] h-[28rem] rounded-full bg-angie-rose/25 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-28 md:pt-40 pb-16 md:pb-28 text-center md:text-left grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-8">
        <p class="inline-flex items-center gap-2 text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold animate-rise">
          <span aria-hidden="true" class="hidden md:block h-px w-8 bg-angie-rose"></span>
          The A.L.I.G.N. store · opening 2026
        </p>
        <h1 id="store-hero-heading" class="mt-5 font-Frauce font-bold leading-[0.95] text-[clamp(2.6rem,8.5vw,5.5rem)] tracking-tight text-balance animate-rise" style="animation-delay:120ms">
          Tools to walk the path <span class="text-angie-rose">at your own pace.</span>
        </h1>
        <p class="mt-6 max-w-2xl mx-auto md:mx-0 text-angie-cream/85 text-base md:text-xl leading-relaxed animate-rise" style="animation-delay:240ms">
          Courses, devotionals, and the forthcoming book. Each one is built to be picked up in the middle of a hard season and walked out slowly — not crammed, not hustled, not performed.
        </p>
        <div class="mt-9 flex flex-col sm:flex-row gap-3 items-center justify-center md:justify-start animate-rise" style="animation-delay:360ms">
          <a
            href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Book a free discovery call and join the store waitlist (opens in a new tab)"
            class="group inline-flex items-center gap-2 px-8 py-4 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold shadow-xl shadow-black/30 transition-all duration-300 hover:bg-white hover:scale-[1.03] active:scale-[0.98]"
          >
            <span>Join the waitlist</span>
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          <a
            href="/#services"
            class="inline-flex items-center gap-2 px-7 py-4 rounded-full border border-angie-cream/40 text-angie-cream font-Grotesk-bold transition-all duration-300 hover:bg-angie-cream hover:text-angie-noir"
          >
            Learn about A.L.I.G.N.
          </a>
        </div>
      </div>

      <ul class="md:col-span-4 grid gap-3 text-left animate-zoom-in" style="animation-delay:240ms">
        {["Free to join the waitlist", "Early-bird discount for members", "English & Spanish"].map((t) => (
          <li class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/5 px-5 py-4 text-sm md:text-base">
            <span aria-hidden="true" class="grid place-items-center w-7 h-7 rounded-full bg-angie-rose/90 text-angie-noir text-sm font-Grotesk-bold">✓</span>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ============================================================
      WHAT'S COMING — three product cards on a light section
  ============================================================ */}
  <section aria-labelledby="coming-soon-heading" class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <header class="max-w-2xl timeline-view animate-range-entry animate-rise">
        <p class="text-angie-burgundy uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">What's coming</p>
        <h2 id="coming-soon-heading" class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-[1.05]">Three resources. <span class="text-angie-burgundy">One path.</span></h2>
        <p class="mt-4 text-angie-noir/70 text-base md:text-lg leading-relaxed">
          Each resource walks one letter of the A.L.I.G.N. framework. Pick the one that meets you where you are today.
        </p>
      </header>

      <div class="mt-12 grid gap-5 md:gap-6 md:grid-cols-3">
        {resources.map((r, i) => (
          <article class:list={[
            "group relative flex flex-col overflow-hidden rounded-3xl p-7 md:p-8 transition-all duration-300 hover:-translate-y-1.5 timeline-view animate-range-entry animate-rise",
            i === 1 ? "bg-angie-burgundy text-angie-cream shadow-xl shadow-angie-burgundy/30" : i === 2 ? "bg-angie-noir text-angie-cream shadow-xl shadow-black/25" : "bg-white text-angie-noir border border-angie-burgundy/10 shadow-xl shadow-angie-burgundy/10",
          ]}>
            <span aria-hidden="true" class:list={["absolute -top-6 -right-2 font-Frauce italic font-bold text-[9rem] leading-none select-none pointer-events-none", i === 0 ? "text-angie-burgundy/10" : "text-white/10"]}>{cardLetters[i]}</span>
            <span class:list={["relative self-start inline-flex items-center px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-Grotesk-bold border", i === 0 ? "border-angie-burgundy/30 text-angie-burgundy" : "border-white/35 text-angie-cream"]}>{r.statusLabel}</span>
            <p class:list={["relative mt-6 text-[10px] md:text-xs uppercase tracking-[0.25em] font-Grotesk-bold", i === 0 ? "text-angie-burgundy" : "text-angie-rose"]}>{r.eyebrow}</p>
            <h3 class="relative mt-2 font-Frauce font-bold text-2xl leading-snug text-balance">{r.title}</h3>
            <p class:list={["relative mt-3 text-sm md:text-[15px] leading-relaxed flex-1", i === 0 ? "text-angie-noir/75" : "text-angie-cream/80"]}>{r.blurb}</p>
            <div class="relative mt-7 flex items-center justify-between gap-3">
              <p class:list={["text-[10px] md:text-xs uppercase tracking-[0.2em] font-Grotesk-bold", i === 0 ? "text-angie-noir/55" : "text-angie-cream/60"]}>{r.status}</p>
              <a
                href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Notify me when ${r.title} is available`}
                class:list={["inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-Grotesk-bold transition-all duration-300 hover:scale-[1.04]", i === 0 ? "bg-angie-noir text-angie-cream hover:bg-angie-burgundy" : "bg-angie-cream text-angie-noir hover:bg-white"]}
              >
                <span>Notify me</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      NOTE — statement block
  ============================================================ */}
  <section aria-label="A note on the store timeline" class="w-full bg-angie-wine text-angie-cream">
    <div class="max-w-3xl mx-auto px-6 py-20 md:py-28 text-center timeline-view animate-range-entry animate-rise">
      <p class="text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">A note on the store</p>
      <p class="mt-5 font-Frauce text-2xl md:text-4xl leading-[1.25] text-balance">
        Most offerings are launching in 2026 alongside the book release. The self-paced A.L.I.G.N. course and the Still Here devotional are the first two to open.
      </p>
      <p class="mt-6 text-angie-cream/75 text-base md:text-lg leading-relaxed">
        Every resource is built around the framework that has changed my life and the lives of the women I coach. Join the waitlist to be the first to know when doors open — and to receive an early-bird discount. No spam. Just the launch.
      </p>
    </div>
  </section>

  {/* ============================================================
      WHY JOIN — two cards
  ============================================================ */}
  <section aria-labelledby="why-waitlist-heading" class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
      <h2 id="why-waitlist-heading" class="font-Frauce font-bold text-3xl md:text-5xl text-center leading-tight timeline-view animate-range-entry animate-rise">Why join the waitlist?</h2>
      <div class="mt-12 grid md:grid-cols-2 gap-5 md:gap-6">
        <article class="rounded-3xl bg-white border border-angie-burgundy/10 shadow-xl shadow-angie-burgundy/10 p-8 text-center timeline-view animate-range-entry animate-rise">
          <p class="font-Frauce italic font-bold text-5xl text-angie-burgundy/30 leading-none">01</p>
          <h3 class="mt-3 font-Frauce font-bold text-2xl">First access</h3>
          <p class="mt-3 text-angie-noir/75 leading-relaxed">Doors open for the waitlist 24 hours before the public release. You walk the A.L.I.G.N. path before anyone else.</p>
        </article>
        <article class="rounded-3xl bg-angie-noir text-angie-cream shadow-xl shadow-black/25 p-8 text-center timeline-view animate-range-entry animate-rise">
          <p class="font-Frauce italic font-bold text-5xl text-angie-rose/40 leading-none">02</p>
          <h3 class="mt-3 font-Frauce font-bold text-2xl">Direct line to Angie</h3>
          <p class="mt-3 text-angie-cream/80 leading-relaxed">Waitlist members can book a free purpose discovery call. Angie personally responds within 24 hours.</p>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================
      FAQ — accessible <details> list
  ============================================================ */}
  <section id="faq" aria-labelledby="store-faq-heading" class="w-full bg-angie-burgundy text-angie-cream">
    <div class="max-w-3xl mx-auto px-6 py-20 md:py-28">
      <header class="mb-10 timeline-view animate-range-entry animate-rise">
        <p class="text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">FAQ</p>
        <h2 id="store-faq-heading" class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-tight">About the A.L.I.G.N. resources</h2>
        <p class="mt-3 text-angie-cream/80 text-base md:text-lg">The same questions I get after every keynote and coaching call. If yours isn't here, send it over.</p>
      </header>
      <div>
        {faqs.map((faq, i) => (
          <details class="group/faq border-b border-white/20 py-5">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4 font-Frauce text-lg md:text-xl [&::-webkit-details-marker]:hidden">
              <span class="flex items-baseline gap-3">
                <span class="text-angie-rose text-[10px] md:text-xs font-Grotesk-bold tracking-[0.25em] shrink-0">Q.{String(i + 1).padStart(2, "0")}</span>
                <span>{faq.question}</span>
              </span>
              <span aria-hidden="true" class="shrink-0 text-angie-rose text-2xl leading-none transition-transform duration-300 group-open/faq:rotate-45">+</span>
            </summary>
            <p class="mt-4 md:ml-12 text-angie-cream/85 text-sm md:text-base leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      FINAL CTA
  ============================================================ */}
  <section aria-label="Join the waitlist and book a purpose discovery call" class="w-full py-20 md:py-28 text-angie-cream text-center bg-gradient-zion">
    <div class="max-w-3xl mx-auto px-6 timeline-view animate-range-entry animate-rise">
      <h2 class="font-Frauce font-bold text-4xl md:text-6xl leading-[1.05] text-balance">
        The store opens in 2026. <span class="italic block">Walk in first.</span>
      </h2>
      <p class="mt-5 text-base md:text-xl text-angie-cream/90 leading-relaxed max-w-2xl mx-auto">
        Book a free 30-minute purpose discovery call. Everyone who books is added to the waitlist, gets the early-bird discount, and first access when the A.L.I.G.N. course launches.
      </p>
      <a
        href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Book your free purpose discovery call and join the waitlist (opens in a new tab)"
        class="group mt-9 inline-flex items-center gap-2 px-8 py-4 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold transition-all duration-300 hover:bg-white hover:scale-[1.03]"
      >
        <span>Book Your Free Call</span>
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
      <p class="mt-8 text-angie-cream/80 text-sm md:text-base">💜 Angie personally responds within 24 hours.</p>
    </div>
  </section>

  {/* FAQ schema — Google rich results + AI engine extraction */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</MainLayout>
