                  </p>
                  <a
                    href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/btn inline-flex items-center gap-1.5 text-angie-burgundy font-Grotesk-bold text-xs md:text-sm hover:text-angie-cream transition-colors"
                    aria-label={`Notify me when ${r.title} is available`}
