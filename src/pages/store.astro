                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </summary>

              <div class="relative px-6 md:px-7 pb-6 md:pb-7 -mt-1">
                <p class="text-white/75 text-sm md:text-[15px] leading-relaxed pl-10 text-pretty">
                  {faq.answer}
                </p>
              </div>
            </details>
