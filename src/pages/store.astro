<script>
  function initShelf() {
    const root = document.querySelector<HTMLElement>("[data-shelf]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-product]"));
    const status = root.querySelector<HTMLElement>("[data-shelf-status]");
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const key = chip.dataset.filter ?? "all";
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        let shown = 0;
        items.forEach((el) => {
          const match = key === "all" || el.dataset.category === key;
          el.hidden = !match;
          if (match) shown += 1;
        });
        if (status) status.textContent = `Showing ${shown} ${shown === 1 ? "product" : "products"}`;
      });
    });
  }
  document.addEventListener("astro:page-load", initShelf);
</script>
