          <div aria-hidden="true" class={`absolute inset-0 rounded-2xl md:rounded-3xl ${waitlistAccents[0].overlay} pointer-events-none`}></div>
          <div aria-hidden="true" class="absolute inset-0 rounded-2xl md:rounded-3xl bg-linear-to-br from-white/5 via-transparent to-transparent pointer-events-none"></div>
          <div aria-hidden="true" class={`absolute -right-2 -bottom-12 font-Frauce text-[180px] md:text-[220px] font-bold leading-none ${waitlistAccents[0].numberColor} italic select-none pointer-events-none`}>
