            </p>
          </div>
        </article>

        <!-- 2. Direct line to Angie — burgundy accent (premium/personal feel) -->
        <article class={`group relative overflow-hidden rounded-2xl md:rounded-3xl p-6 md:p-7 ${waitlistAccents[1].glass} ${waitlistAccents[1].glassHover} backdrop-blur-xl border ${waitlistAccents[1].border} shadow-2xl ${waitlistAccents[1].baseShadow} ${waitlistAccents[1].hoverShadow} transition-all duration-500 hover:-translate-y-1.5 text-center`}>
          <div aria-hidden="true" class={`absolute inset-0 rounded-2xl md:rounded-3xl ${waitlistAccents[1].overlay} pointer-events-none`}></div>
          <div aria-hidden="true" class="absolute inset-0 rounded-2xl md:rounded-3xl bg-linear-to-br from-white/5 via-transparent to-transparent pointer-events-none"></div>
          <div aria-hidden="true" class={`absolute -right-2 -bottom-12 font-Frauce text-[180px] md:text-[220px] font-bold leading-none ${waitlistAccents[1].numberColor} italic select-none pointer-events-none`}>
            02
          </div>
          <div class="relative">
            <div class={`inline-flex w-14 h-14 md:w-16 md:h-16 rounded-full ${waitlistAccents[1].iconBg} ${waitlistAccents[1].iconBorder} border items-center justify-center ${waitlistAccents[1].iconColor} mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-500 shadow-lg shadow-black/20`}>
