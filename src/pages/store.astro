    <div aria-hidden="true" class="absolute bottom-10 right-1/4 w-80 h-80 md:w-md md:h-112 rounded-full bg-angie-burgundy/25 blur-[120px] pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-1/3 right-1/3 w-60 h-60 md:w-80 md:h-80 rounded-full bg-angie-cream/40 blur-[100px] pointer-events-none"></div>
