---
import MainLayout from "../layout/MainLayout.astro";
import { getCollection } from "astro:content";
const services = await getCollection("services");

// Intrinsic sizes of the service photos (prevents layout shift).
const serviceImageSize: Record<string, { width: number; height: number }> = {
  "coach.webp": { width: 1045, height: 1400 },
  "keynote.webp": { width: 864, height: 1152 },
  "podcast.webp": { width: 832, height: 1248 },
};
const BOOK_URL = "https://tidycal.com/angiepspeaks/30min-purpose-discoverycall";
---

<MainLayout
  title="Angie Pichardo | Christian Speaker & Life Coach"
  description="Christian motivational speaker and life coach helping women move from stuck to purpose through the A.L.I.G.N. framework. Serving Lemoyne, Harrisburg, and Central PA — in person and virtually, in English and Spanish."
  keywords={[
    "Angie Pichardo",
    "Christian speaker",
    "Christian life coach",
    "motivational speaker Pennsylvania",
    "keynote speaker Central PA",
    "A.L.I.G.N. framework",
    "women's ministry speaker",
    "bilingual coach English Spanish",
  ]}
>
  <!-- ============ HERO ============ -->
  <section class="relative w-full overflow-hidden bg-angie-wine text-angie-cream">
    <!-- solid burgundy plane behind the portrait -->
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-[52%] bg-angie-burgundy md:inset-x-auto md:right-0 md:top-0 md:h-full md:w-5/12"
    >
    </div>

    <div
      class="relative mx-auto grid w-full max-w-7xl grid-cols-1 gap-x-8 px-5 pt-28 md:min-h-[88dvh] md:grid-cols-12 md:px-10 md:pt-36 lg:pt-40"
    >
      <div class="flex flex-col justify-center pb-10 md:col-span-7 md:pb-20">
        <p
          class="hero-fade-up font-Frauce font-bold italic leading-none text-angie-rose text-[clamp(2.25rem,9vw,4.5rem)]"
        >
          Still here.
        </p>

        <h1
          class="hero-fade-up mt-4 font-Frauce font-bold leading-[0.95] tracking-tight text-balance text-[clamp(2.75rem,11vw,6rem)]"
          style="animation-delay: 0.1s;"
        >
          Angie Pichardo
        </h1>

        <div class="hero-fade-up mt-7 max-w-lg" style="animation-delay: 0.2s;">
          <p class="font-Grotesk-bold text-lg md:text-xl">
            Christian Speaker &amp; Life Coach
          </p>
          <ul
            class="mt-4 grid grid-cols-1 border-t border-angie-cream/20 text-base text-angie-cream/85 sm:grid-cols-3"
          >
            <li class="border-b border-angie-cream/20 py-3 sm:pr-4">Lemoyne, PA</li>
            <li class="border-b border-angie-cream/20 py-3 sm:px-4">A.L.I.G.N. Framework</li>
            <li class="border-b border-angie-cream/20 py-3 sm:pl-4">English &amp; Spanish</li>
          </ul>
        </div>

        <div
          class="hero-fade-up mt-8 flex flex-wrap items-center gap-x-6 gap-y-4"
          style="animation-delay: 0.3s;"
        >
          <a
            href={BOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-light hover:animate-tada"
          >
            Book a call
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </a>

          <div class="flex items-center">
            <a
              href="https://www.instagram.com/angie.p.speaks"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="inline-flex h-11 w-11 items-center justify-center rounded-md text-angie-cream transition-colors hover:text-angie-rose focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-cream"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/angie-pichardo"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="inline-flex h-11 w-11 items-center justify-center rounded-md text-angie-cream transition-colors hover:text-angie-rose focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-cream"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3v9zM6.5 8.25A1.75 1.75 0 1 1 8.3 6.5a1.78 1.78 0 0 1-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0 0 13 14.19a.66.66 0 0 0 0 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 0 1 2.7-1.4c1.55 0 3.36.86 3.36 3.66V19z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.facebook.com/people/Angie-Pichardo/61579911753681/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="inline-flex h-11 w-11 items-center justify-center rounded-md text-angie-cream transition-colors hover:text-angie-rose focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-cream"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="flex items-end justify-center md:col-span-5">
        <img
          src="/images/angie-hero-1600.webp"
          alt="Angie Pichardo — Christian speaker and life coach in Lemoyne, PA"
          width="1300"
          height="1400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-fade-up block h-auto w-full max-w-sm md:max-w-none"
          style="animation-delay: 0.15s;"
        />
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section aria-label="Services" class="w-full bg-angie-cream text-angie-noir">
    <section id="services" class="mx-auto w-full max-w-7xl px-5 pb-6 pt-16 md:px-10 md:pt-24">
      <h2
        class="timeline-view animate-range-[entry_0%_cover_30%] animate-rise font-Frauce text-[clamp(2.25rem,6vw,4rem)] font-bold leading-none"
      >
        Services
      </h2>

      <div class="mt-12 md:mt-20">
        {
          services.map((service, i) => {
            const { title, image, format, bestFor, longDescription, duration, location, url } =
              service.data;
            const size = serviceImageSize[image] ?? { width: 864, height: 1152 };
            const flip = i % 2 === 1;
            return (
              <article class="grid grid-cols-1 items-center gap-8 border-t border-angie-noir/15 py-12 md:grid-cols-12 md:gap-12 md:py-20">
                <div
                  class:list={[
                    "md:col-span-5",
                    flip ? "md:order-last md:col-start-8" : "",
                  ]}
                >
                  <img
                    src={`/images/services/${image}`}
                    alt={title}
                    width={size.width}
                    height={size.height}
                    loading="lazy"
                    decoding="async"
                    class="aspect-4/5 w-full rounded-lg object-cover object-top"
                  />
                </div>
                <div
                  class:list={[
                    "md:col-span-6",
                    flip ? "md:col-start-1 md:row-start-1" : "md:col-start-7",
                  ]}
                >
                  <h3 class="font-Frauce text-3xl font-bold leading-tight text-balance md:text-5xl">
                    {title}
                  </h3>
                  <p class="measure mt-5 text-[1.0625rem] leading-relaxed text-angie-noir/85 md:text-lg">
                    {longDescription}
                  </p>

                  <ul class="mt-6 grid grid-cols-1 border-t border-angie-noir/15 text-base sm:grid-cols-2 sm:gap-x-8">
                    {(bestFor ?? []).slice(0, 6).map((item: string) => (
                      <li class="border-b border-angie-noir/15 py-2.5">{item}</li>
                    ))}
                  </ul>

                  <p class="mt-6 text-base text-angie-noir/75">
                    {format} · {duration} · {location}
                  </p>

                  <a href={`/${url}`} class="btn btn-dark mt-7">
                    Learn more
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M13 5l7 7-7 7" />
                    </svg>
                    <span class="sr-only">about {title}</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section id="testimonials" class="w-full bg-angie-burgundy text-white">
    <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-10 md:py-32">
      <h2
        class="timeline-view animate-range-[entry_0%_cover_30%] animate-rise font-Frauce text-[clamp(2.25rem,6vw,4rem)] font-bold leading-none"
      >
        Testimonials
      </h2>

      <figure class="mt-12 md:mt-16 md:max-w-4xl">
        <blockquote
          class="font-Frauce text-2xl font-medium leading-snug text-balance sm:text-3xl md:text-5xl md:leading-[1.15]"
        >
          &ldquo;Knowing you has encouraged me to show up more authentically and stay grounded in
          my faith. Your positivity, compassion, and consistency have motivated me to keep pushing
          forward and to lead with kindness in my own life.&rdquo;
        </blockquote>
        <figcaption class="mt-6 text-base">
          <span class="font-Grotesk-bold">Isabel L.</span>
          <span class="text-white/80"> · Coaching Client</span>
        </figcaption>
      </figure>

      <div
        class="mt-16 grid grid-cols-1 gap-x-16 gap-y-12 border-t border-white/25 pt-12 md:mt-24 md:grid-cols-2 md:pt-14"
      >
        <figure>
          <blockquote class="measure text-[1.0625rem] leading-relaxed text-white/95 md:text-lg">
            &ldquo;You have a big influence on me. I was down, isolated and depressed. Your posting
            kept coming up on my feed, I use to scroll through them, but they kept coming up. Until
            on day I stop to listen, it was about been positive, and the way you see things and how
            God its so good. After that I heard about two or three more, when one morning driving to
            work, I decided to try what you said. It was hard, it still is, but everything that I
            encounter i turn it into a positive. At first I had to say it out loud and hear me say
            it, now I do it internally. Your faith its so strong and big that it has touched my
            life. Your faith has rolled into my life and now I am living in God&apos;s faith. You
            woke me up and helped me stand when I was down and had no desire to live. I and
            greatful and thankful to have you in my life.&rdquo;
          </blockquote>
          <figcaption class="mt-5 text-base">
            <span class="font-Grotesk-bold">Yobanka S.</span>
            <span class="text-white/80"> · Community Member</span>
          </figcaption>
        </figure>

        <figure>
          <blockquote class="measure text-[1.0625rem] leading-relaxed text-white/95 md:text-lg">
            &ldquo;Working with you has challenged me to continue growing and to step out and take
            the risks that God is calling me to take. Working with you has also encouraged me to see
            how He takes the little I have and uses it to free His children. Your growth reflects my
            growth. Your progress is a testimony of how God is able to use me for His glory. Your
            growth encourages me to continue to reach out to find others that God wants me to help.
            Working with you also gives me a measure of accountability, because I know God wants me
            to give His best to you.&rdquo;
          </blockquote>
          <figcaption class="mt-5 text-base">
            <span class="font-Grotesk-bold">Laurie S.</span>
            <span class="text-white/80"> · Coaching Client</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section aria-label="About Angie Pichardo" class="w-full bg-angie-noir text-angie-cream">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-5 py-16 md:grid-cols-12 md:gap-16 md:px-10 md:py-24"
    >
      <div class="md:col-span-5">
        <img
          src="/images/about/angie-aboutme-relaxed.webp"
          alt="Angie Pichardo seated in a green armchair, smiling"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
          class="aspect-4/5 w-full rounded-lg object-cover object-top"
        />
      </div>
      <div
        class="timeline-view animate-range-[entry_0%_cover_30%] animate-rise md:col-span-6 md:col-start-7"
      >
        <h2
          class="font-Frauce text-[clamp(2.25rem,5.5vw,4rem)] font-bold leading-[1] text-balance"
        >
          You're Still Here For A Reason
        </h2>
        <p class="measure mt-6 text-[1.0625rem] leading-relaxed text-angie-cream/90 md:text-lg">
          I'm Angie — a Christian speaker, life coach, and living proof that God can rewrite any
          story. For years I was smiling on the outside but fighting battles no one could see. Then
          came the moment I almost didn't survive — and that's where my real story began.
        </p>
        <p class="measure mt-5 text-[1.0625rem] leading-relaxed text-angie-cream/90 md:text-lg">
          What tried to break me became the foundation of my purpose. Today, through the A.L.I.G.N.
          Framework, I help other women turn their survival into strength and their pain into
          purpose — because you were made for more than just getting by.
        </p>
        <a href="/aboutme" class="btn btn-outline-light mt-8">
          Read my full story
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="w-full bg-angie-cream text-angie-noir">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-5 py-16 md:grid-cols-12 md:gap-16 md:px-10 md:py-28"
    >
      <div class="md:col-span-4">
        <div class="md:sticky md:top-28">
          <h2
            class="font-Frauce text-[clamp(2.25rem,5vw,3.5rem)] font-bold leading-[1.02] text-balance"
          >
            Frequently asked questions
          </h2>
          <p class="mt-5 text-base leading-relaxed text-angie-noir/80 md:text-lg">
            The same four questions I hear after every talk, in every coaching call, and in almost
            every DM. If yours isn't here, send it over — I read every message.
          </p>
        </div>
      </div>

      <div class="timeline-view animate-range-[entry_0%_cover_25%] animate-rise md:col-span-8">
        <div class="border-t border-angie-noir/25">
          <details class="group border-b border-angie-noir/25">
            <summary
              class="flex min-h-14 cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-burgundy"
            >
              <h3 class="font-Frauce text-xl font-semibold leading-snug md:text-2xl">
                How was your death experience?
              </h3>
              <svg
                class="mt-1.5 h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            <div class="measure space-y-4 pb-7 text-base leading-relaxed text-angie-noir/90 md:text-[1.0625rem]">
              <p>
                After a suicide attempt that clinically took my life, I came back. What happened in
                those hours is the story I tell on stage — not the details, but the restoration, the
                forgiveness and God saying “It's not your time”. I share it because the room needs
                to know: the woman still struggling is not alone in the dark. There is a way
                through. There is a way out.
              </p>
              <p class="rounded-md bg-angie-noir/5 p-4 text-base">
                <strong>If you or someone you love is struggling, call or text 988</strong> — the
                Suicide &amp; Crisis Lifeline (US). Free, confidential, 24/7.
              </p>
            </div>
          </details>

          <details class="group border-b border-angie-noir/25">
            <summary
              class="flex min-h-14 cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-burgundy"
            >
              <h3 class="font-Frauce text-xl font-semibold leading-snug md:text-2xl">
                How did your faith and experience with God happen?
              </h3>
              <svg
                class="mt-1.5 h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            <div class="measure pb-7 text-base leading-relaxed text-angie-noir/90 md:text-[1.0625rem]">
              <p>
                Slowly, then all at once. I spent years asking God <em>"Why did You save me?"</em>
                before I realized I was asking the wrong question. The right one was <em
                  >"What now?"</em
                > Today my faith is less about perfect theology and more about a daily practice of
                showing up — prayer, scripture, community, obedience. I share that practice because
                it is portable. It works in a hospital room. It works in a small group. It works in
                the middle of a regular Tuesday.
              </p>
            </div>
          </details>

          <details class="group border-b border-angie-noir/25">
            <summary
              class="flex min-h-14 cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-burgundy"
            >
              <h3 class="font-Frauce text-xl font-semibold leading-snug md:text-2xl">
                What is the A.L.I.G.N. framework?
              </h3>
              <svg
                class="mt-1.5 h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            <div class="measure pb-7 text-base leading-relaxed text-angie-noir/90 md:text-[1.0625rem]">
              <p>A.L.I.G.N. is the five-step path I built for the woman who is still stuck.</p>
              <ul class="mt-3 space-y-2">
                <li><strong>A — Awareness:</strong> naming what is keeping you there.</li>
                <li><strong>L — Love Yourself:</strong> dissolving shame and self-sabotage.</li>
                <li><strong>I — Invite God In:</strong> surrendering the outcome.</li>
                <li><strong>G — Gratitude:</strong> rewiring the middle of the journey.</li>
                <li><strong>N — Nurture Positivity:</strong> protecting what God is building.</li>
              </ul>
              <p class="mt-3">The letters spell the path out of stuck and into purpose.</p>
            </div>
          </details>

          <details class="group border-b border-angie-noir/25">
            <summary
              class="flex min-h-14 cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-angie-burgundy"
            >
              <h3 class="font-Frauce text-xl font-semibold leading-snug md:text-2xl">
                How does awareness actually work?
              </h3>
              <svg
                class="mt-1.5 h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            <div class="measure pb-7 text-base leading-relaxed text-angie-noir/90 md:text-[1.0625rem]">
              <p>
                Awareness is the first letter because nothing else works without it. Most of us are
                not stuck because we lack tools — we are stuck because we have not named the thing.
                Awareness is the practice of looking at the pattern, the lie, the coping mechanism,
                the relationship, the voice — and refusing to flinch. It is not confession. It is
                not shame. It is the brave act of seeing clearly so God can begin the restoration.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="w-full bg-angie-wine text-angie-cream">
    <div
      class="mx-auto flex w-full max-w-7xl flex-col items-start gap-8 px-5 py-16 md:flex-row md:items-end md:justify-between md:px-10 md:py-20"
    >
      <div class="max-w-2xl">
        <h2
          class="font-Frauce text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.05] text-balance"
        >
          30-minute purpose discovery call
        </h2>
        <p class="mt-4 text-base text-angie-cream/85 md:text-lg">
          In person and virtually, in English and Spanish. Serving Lemoyne, Harrisburg, and
          Central PA.
        </p>
      </div>
      <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class="btn btn-light shrink-0">
        Book a call
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>
</MainLayout>

<!--
  =====================================================
  JSON-LD: FAQ, Services, Reviews, LocalBusiness
  =====================================================
-->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
