    }
  }
</style>

<script>
  // Hero CTAs (social icons + Book a call) ya tienen la animacion CSS
  // hero-fade-up al cargar. No necesitamos scroll reveal — eso rompia
  // cuando el usuario navegaba a otra pagina y volvia con scroll=0.
  // Mantenemos las referencias por si queremos re-disparar en el futuro.
  const heroInfo = document.getElementById("hero-info");
  const heroCta = document.getElementById("hero-cta");

  // Testimonials: detectar si el texto está truncado y mostrar/ocultar "Read more"
  function setupReadMore() {
    const buttons = document.querySelectorAll("[data-readmore]");
    for (const btn of buttons) {
      const card = btn.closest("article");
      if (!card) continue;
      const quote = card.querySelector(".testimonial-quote") as HTMLElement | null;
      if (!quote) continue;
      if (quote.scrollHeight > quote.clientHeight + 1) {
        btn.classList.remove("hidden");
        const slide = btn.querySelector("[data-readmore-slide]") as HTMLElement | null;
        const label = btn.querySelector(".readmore-label") as HTMLElement | null;
        btn.addEventListener("click", () => {
          const expanded = quote.dataset.expanded === "true";
          if (expanded) {
            quote.style.display = "-webkit-box";
            quote.style.webkitLineClamp = "4";
            quote.style.webkitBoxOrient = "vertical";
            quote.style.overflow = "hidden";
            quote.dataset.expanded = "false";
            if (slide) slide.style.transform = "";
            if (label) { label.textContent = "Read more →"; label.style.color = ""; }
          } else {
            quote.style.display = "block";
            quote.style.webkitLineClamp = "unset";
            quote.style.webkitBoxOrient = "horizontal";
            quote.style.overflow = "visible";
            quote.dataset.expanded = "true";
            if (slide) slide.style.transform = "translateY(0)";
            if (label) { label.textContent = "Read less ↑"; label.style.color = "#ffffff"; }
          }
        });
      } else {
        btn.classList.add("hidden");
      }
    }
  }
  setupReadMore();
  window.addEventListener("resize", setupReadMore);
</script>
