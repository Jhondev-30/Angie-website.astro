---
import ServicesHeroLayout from "../../layout/ServicesHeroLayout.astro";
import ServicesLayout from "../../layout/ServicesLayout.astro";
import ServicesMainLayout from "../../layout/ServicesMainLayout.astro";

const whoFor = [
  {
    title: "Faith and Christian podcasts",
    text: "Women's ministry, Bible study, devotional, and Christian living shows that want a guest with real-world grit, not just theory.",
  },
  {
    title: "Recovery and mental health",
    text: "Sobriety, suicide loss, grief, and mental health awareness shows that handle these topics with care and depth.",
  },
  {
    title: "Leadership and entrepreneurship",
    text: "Women's leadership, founder stories, and purpose-driven business shows. Real talk about building a life and a business after loss.",
  },
  {
    title: "TV and radio interviews",
    text: "Local and regional media appearances, including morning shows, news segments, and faith-based radio.",
  },
];

const steps = [
  {
    title: "Reach out",
    text: "Send a message with your show name, audience size, and proposed topic. You will hear back within 48 hours.",
  },
  {
    title: "Pre-show call",
    text: "A short alignment call to confirm tone, talk tracks, and any sensitive topics to honor. Bring your hardest questions.",
  },
  {
    title: "Record and share",
    text: "We record, you edit, you publish. Angie will share the episode across her channels to help your show reach the people who need it.",
  },
];

const offers = [
  {
    name: "Podcast guest",
    price: "Complimentary",
    text: "For aligned missions and audience fit. 30 to 60 minute interviews via Zoom or in-studio. Includes a pre-show call to align on tone and talking points.",
    meta: "Best for aligned podcasts and mission-driven shows.",
  },
  {
    name: "Panel discussions",
    price: "Contact",
    text: "Multi-speaker panels, summits, and live events. Virtual or in-person. Format, length, and fee scoped per engagement.",
    meta: "Best for summits, virtual conferences, live events.",
  },
  {
    name: "Church and recovery groups",
    price: "Contact",
    text: "In-person or virtual talks for churches, recovery groups, and community organizations. Sliding scale available for smaller ministries.",
    meta: "Best for ministries, recovery communities, support groups.",
  },
];

const details = [
  { label: "Format", value: "In-person or virtual" },
  { label: "Duration", value: "30 to 60 minutes" },
  { label: "Location", value: "Nationwide or Zoom" },
];

const faq = [
  {
    q: "What topics do you cover on podcasts?",
    a: "Faith and recovery, suicide loss and grief, resilience, finding purpose after trauma, women's leadership, the A.L.I.G.N. framework, bilingual identity, and rebuilding your life when you thought it was over.",
  },
  {
    q: "Are you available for remote interviews?",
    a: "Yes. Most interviews are remote via Zoom, Riverside, SquadCast, or your platform of choice. Angie records from a quiet home setup with a professional microphone and stable internet. In-studio is available when geography allows.",
  },
  {
    q: "How long is a typical podcast interview?",
    a: "Most interviews run 30 to 60 minutes. Angie is comfortable with longer conversational formats and quick 15-minute segments alike. Pre-show alignment keeps the recording tight.",
  },
  {
    q: "Is there an audience size requirement?",
    a: "No hard minimum. Mission alignment matters more than download numbers, and smaller, niche shows that serve the right audience are often the best fit. Send a pitch and let's talk.",
  },
];
---

<ServicesLayout
  title="Faith & Recovery Podcast Guest | Angie Pichardo"
  description="Christian podcast guest Angie Pichardo — faith, recovery, and purpose. Available remotely or in-studio on shows about resilience and the A.L.I.G.N. framework."
  canonicalPath="/services/podcast-guest/"
  keywords={[
    "Christian podcast guest",
    "faith podcast guest speaker",
    "women's podcast guest",
    "Angie Pichardo podcast",
    "suicide survivor speaker podcast",
    "recovery podcast guest",
    "bilingual podcast guest",
    "A.L.I.G.N. framework podcast",
  ]}
>
  <ServicesHeroLayout
    image="/images/services/podcast.webp"
    alt="Angie Pichardo in her home recording studio beside a podcast microphone"
    width={832}
    height={1248}
    position="40% 12%"
    ctaLabel="Pitch your show"
  >
    Podcast Guest &amp; Media Appearances
    <Fragment slot="lead">
      Authentic, faith-rooted conversations on resilience, recovery, purpose,
      and what it really means to rebuild your life.
    </Fragment>
  </ServicesHeroLayout>

  <ServicesMainLayout
    whoFor={whoFor}
    steps={steps}
    offers={offers}
    details={details}
    faq={faq}
    whatTitle="The conversation that makes people feel less alone"
  >
    <Fragment slot="mission-intro">
      Audiences remember the conversation that made them feel less alone.
    </Fragment>

    <Fragment slot="mission-text">
      <p>
        Angie brings her own story of grief, suicide loss, recovery, and
        rebuilt purpose to every interview, paired with scripture, practical
        wisdom, and the kind of honesty that builds trust quickly.
      </p>
      <p>
        Available for podcast guest spots, panel discussions, church events,
        recovery communities, leadership conversations, television, radio, and
        other media appearances. Trained through the Les Brown "Speaking for a
        Living" program.
      </p>
      <p>
        Remote interviews from a professional home studio, or in-studio when
        geography allows. English and Spanish.
      </p>
    </Fragment>

    <Fragment slot="investment-note">
      Podcast interviews for aligned shows are complimentary. All other
      appearances are scoped per engagement. Bilingual (English/Spanish)
      appearances available on request.
    </Fragment>
  </ServicesMainLayout>
</ServicesLayout>
