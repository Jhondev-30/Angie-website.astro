---
import ServicesHeroLayout from "../../layout/ServicesHeroLayout.astro";
import ServicesLayout from "../../layout/ServicesLayout.astro";
import ServicesMainLayout from "../../layout/ServicesMainLayout.astro";

const whoFor = [
  {
    title: "Women seeking clarity and purpose",
    text: "You know something needs to shift, you can feel it, but the next step is not clear yet. We will name it together.",
  },
  {
    title: "Women in life transitions",
    text: "Divorce, empty nest, career change, grief, recovery. The ground has shifted, and coaching helps you find steady ground again.",
  },
  {
    title: "Overcoming limiting beliefs",
    text: "Those \"I am not enough\" or \"who am I to do this\" voices? We will identify them, dismantle them, and replace them with truth.",
  },
  {
    title: "Faith and spiritual growth",
    text: "For women who want their next step rooted in scripture and prayer, not just strategy. Practical and Spirit-led.",
  },
];

const steps = [
  {
    title: "Book a free discovery call",
    text: "Schedule a complimentary 30-minute call so we can talk about where you are, what you are working through, and whether coaching is the right fit.",
  },
  {
    title: "Choose your path",
    text: "After the call, you will receive a simple recommendation: a single session to start, the 6-session transformation package, or a custom plan if your situation needs it.",
  },
  {
    title: "Begin the work",
    text: "Sessions are scheduled at a pace that fits your life. Most clients meet every 1 to 2 weeks. Expect homework, scripture, prayer, and real conversation.",
  },
];

const offers = [
  {
    name: "Single session",
    price: "$49",
    text: "60-minute 1:1 coaching call via Zoom or in-person in the Lemoyne, PA area. Perfect for trying the work, working through a specific situation, or focused one-time support.",
    meta: "English and Spanish. Virtual or in-person.",
  },
  {
    name: "6-session transformation package",
    price: "$289",
    text: "Six 60-minute sessions over 8 to 12 weeks. Real, lasting change requires consistency, and this package is built for the full A.L.I.G.N. journey from awareness to nurtured positivity.",
    meta: "Save over 20% vs. single sessions. Payment plans available.",
  },
];

const details = [
  { label: "Format", value: "In-person or virtual" },
  { label: "Duration", value: "60-minute sessions" },
  { label: "Location", value: "Harrisburg area or Zoom" },
];

const faq = [
  {
    q: "What is the A.L.I.G.N. Framework?",
    a: "A.L.I.G.N. is Angie's signature 5-step framework: <strong>A</strong>wareness (name where you actually are), <strong>L</strong>ove Yourself (replace shame with truth), <strong>I</strong>nvite God In (let scripture and prayer lead), <strong>G</strong>ratitude (shift the lens), and <strong>N</strong>urture Positivity (build a life that holds). It is the backbone of every coaching engagement.",
  },
  {
    q: "How long is each session and how often do we meet?",
    a: "Each session is 60 minutes. Most clients meet every 1 to 2 weeks, which gives time to apply what we work on between sessions. Single sessions can be one-off or the start of a longer engagement.",
  },
  {
    q: "Do you offer virtual coaching?",
    a: "Yes. Most coaching clients meet with Angie via Zoom from anywhere in the United States. In-person sessions are also available in the Lemoyne and greater Harrisburg, PA area. Both formats are equally effective.",
  },
  {
    q: "Is Christian coaching different from regular life coaching?",
    a: "Faith-rooted coaching integrates scripture, prayer, and discernment into the goal-setting and accountability work, without ever forcing it. If you are a Christian woman who wants her growth anchored in something deeper than hustle culture, this is for you.",
  },
];
---

<ServicesLayout
  title="1:1 A.L.I.G.N. Coaching for Christian Women | Angie Pichardo"
  description="Faith-based 1:1 life coaching for Christian women using the A.L.I.G.N. framework. 60-minute sessions in-person in Lemoyne, PA or via Zoom. Book a free discovery call."
  canonicalPath="/services/coaching/"
  keywords={[
    "1:1 Christian life coach",
    "A.L.I.G.N. coaching",
    "faith-based life coach",
    "Christian coaching for women",
    "Christian life coach Lemoyne PA",
    "biblical life coaching",
    "Christian coach bilingual",
    "virtual Christian coaching",
  ]}
>
  <ServicesHeroLayout
    image="/images/services/coach.webp"
    alt="Angie Pichardo, Christian life coach, smiling in a burgundy plaid blazer"
    width={1045}
    height={1400}
    position="50% 22%"
  >
    1:1 A.L.I.G.N. Coaching for Christian Women
    <Fragment slot="lead">
      Personalized 1:1 Christian life coaching using the A.L.I.G.N. Framework,
      designed for women ready to move from stuck to purpose.
    </Fragment>
  </ServicesHeroLayout>

  <ServicesMainLayout
    whoFor={whoFor}
    steps={steps}
    offers={offers}
    details={details}
    faq={faq}
    whatTitle="A space for honest, faith-rooted change"
  >
    <Fragment slot="mission-intro">
      A.L.I.G.N. coaching meets you exactly where you are. No performance required.
    </Fragment>

    <Fragment slot="mission-text">
      <p>
        Whether you are navigating a life transition, battling limiting
        beliefs, or simply feeling stuck, this is honest, faith-rooted work
        built around your season, your struggles, and your goals.
      </p>
      <p>
        Each session follows the A.L.I.G.N. framework:
        <strong>A</strong>wareness, <strong>L</strong>ove Yourself,
        <strong>I</strong>nvite God In, <strong>G</strong>ratitude,
        <strong>N</strong>urture Positivity.
      </p>
      <p>
        If you have ever felt like you are "still here for a reason" but cannot
        quite name it, this is where that reason starts to take shape.
      </p>
    </Fragment>

    <Fragment slot="note">
      Angie is not a licensed therapist. Coaching is not a substitute for
      clinical mental health care. If you are in crisis, call or text
      <strong>988</strong> (Suicide &amp; Crisis Lifeline).
    </Fragment>

    <Fragment slot="investment-note">
      All sessions available in English and Spanish. In-person within the
      Lemoyne, Harrisburg, and Central PA area, or virtual via Zoom nationwide.
    </Fragment>
  </ServicesMainLayout>
</ServicesLayout>
