---
import ServicesHeroLayout from "../../layout/ServicesHeroLayout.astro";
import ServicesLayout from "../../layout/ServicesLayout.astro";
import ServicesMainLayout from "../../layout/ServicesMainLayout.astro";

const whoFor = [
  {
    title: "Corporate events",
    text: "Leadership offsites, women in business summits, employee resilience programming. Faith-inclusive, professional, and energizing.",
  },
  {
    title: "Women's conferences",
    text: "Main-stage keynotes for Christian women's events, mom conferences, and marriage and ministry gatherings. Hope, honesty, and a call forward.",
  },
  {
    title: "Churches and ministries",
    text: "Women's ministry events, recovery ministries, special services, and leadership gatherings. Scripture-anchored and Spirit-led.",
  },
  {
    title: "Nonprofits and community",
    text: "Fundraising luncheons, awareness events, and community programs centered on mental health, recovery, or women's empowerment.",
  },
];

const steps = [
  {
    title: "Send an inquiry",
    text: "Book a free 30-minute discovery call to share your event date, audience, and goals. We will talk through fit and format.",
  },
  {
    title: "Customize the talk",
    text: "Once confirmed, Angie will craft a tailored keynote for your audience, including scripture references, stories, and a closing call to action that fits your event theme.",
  },
  {
    title: "Deliver and follow up",
    text: "Angie arrives early, brings her own mic if needed, and stays after the talk to meet attendees. Optional follow-up resources for your group are included.",
  },
];

const offers = [
  {
    name: "Local, Central PA",
    price: "From $750",
    text: "In-person keynotes within the Harrisburg / Lemoyne / Central PA area. 30 to 60 minute talks. Travel costs included.",
    meta: "Best for regional events, church services, local nonprofits.",
  },
  {
    name: "National or virtual",
    price: "Contact",
    text: "In-person keynotes nationwide (travel quoted separately) and virtual keynotes via Zoom. 30 to 90 minutes including Q&A.",
    meta: "Best for conferences, multi-day events, virtual summits.",
  },
  {
    name: "Workshop",
    price: "Custom",
    text: "60 to 90 minute interactive workshops built around your theme: resilience, leadership, the A.L.I.G.N. framework, or purpose discovery.",
    meta: "Best for leadership teams, breakout sessions, retreats.",
  },
];

const details = [
  { label: "Format", value: "In-person or virtual" },
  { label: "Duration", value: "30 to 90 minutes" },
  { label: "Location", value: "Nationwide or Zoom" },
];

const faq = [
  {
    q: "What topics do you speak on?",
    a: "Core topics include overcoming adversity, resilience after grief, discovering purpose, the A.L.I.G.N. framework, faith-based leadership, women's empowerment, and recovery. Every talk is customized to your audience.",
  },
  {
    q: "How long is a typical keynote?",
    a: "Keynotes range from 30 to 90 minutes depending on your event format. A 45-minute keynote with a 15-minute Q&amp;A is the most common ask. Half-day and full-day workshops are also available.",
  },
  {
    q: "Do you travel for in-person keynotes?",
    a: "Yes. Angie speaks nationwide and is based in Lemoyne, Pennsylvania. Local events (within the Harrisburg / Central PA area) start at $750 with travel included. National events quote travel separately.",
  },
  {
    q: "Can the keynote be customized to our theme?",
    a: "Always. A discovery call before booking lets Angie learn your audience, theme, and desired outcomes. The final keynote is built specifically for that room, not recycled from past events.",
  },
];
---

<ServicesLayout
  title="Christian Keynote Speaker | Angie Pichardo"
  description="Christian keynote speaker Angie Pichardo — inspiring keynotes for women's events, churches, and recovery ministries. Available in-person (nationwide) and virtually, in English and Spanish."
  canonicalPath="/services/keynote-speaking/"
  keywords={[
    "Christian keynote speaker",
    "women's conference speaker",
    "motivational speaker Pennsylvania",
    "church conference speaker",
    "keynote speaker bilingual",
    "faith-based keynote speaker",
    "recovery ministry speaker",
    "women's event speaker",
  ]}
>
  <ServicesHeroLayout
    image="/images/services/keynote.webp"
    alt="Angie Pichardo on stage at a conference, smiling beside a fellow speaker"
    width={864}
    height={1152}
    position="25% 18%"
  >
    Christian Keynote Speaker for Events &amp; Conferences
    <Fragment slot="lead">
      Faith-rooted keynotes that move audiences from "just surviving" to
      leading with purpose, resilience, and courage.
    </Fragment>
  </ServicesHeroLayout>

  <ServicesMainLayout
    whoFor={whoFor}
    steps={steps}
    offers={offers}
    details={details}
    faq={faq}
    whatTitle="An honest talk, built for your room"
  >
    <Fragment slot="mission-intro">
      Audiences don't need another motivational talk. They need an honest one.
    </Fragment>

    <Fragment slot="mission-text">
      <p>
        Angie brings her own story of grief, recovery, and rebuilt purpose to
        every stage, paired with scripture, humor, and practical tools that
        people actually use the next morning.
      </p>
      <p>
        Every keynote is tailored to your audience. Whether you are hosting a
        women's conference, a recovery ministry event, a corporate gathering,
        or a Sunday service, the message is crafted to land in that room and
        keep working long after the closing prayer.
      </p>
      <p>
        Bilingual delivery in English and Spanish. In-person nationwide or
        virtual via Zoom. From 30-minute keynotes to 90-minute workshops.
      </p>
    </Fragment>

    <Fragment slot="investment-note">
      All keynotes available in English and Spanish. Bilingual events
      available upon request. A discovery call is required for all keynote
      bookings.
    </Fragment>
  </ServicesMainLayout>
</ServicesLayout>
