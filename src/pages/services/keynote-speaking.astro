---
import ServicesHeroLayout from "../../layout/ServicesHeroLayout.astro";
import ServicesLayout from "../../layout/ServicesLayout.astro";
import ServicesMainLayout from "../../layout/ServicesMainLayout.astro";
---

<ServicesLayout
  title="Christian Keynote Speaker | Angie Pichardo"
  description="Christian keynote speaker Angie Pichardo — inspiring keynotes for women's events, churches, and recovery ministries. Available in-person (nationwide) and virtually, in English and Spanish."
  canonicalPath="/services/keynote-speaking/"
  keywords={[
    "Christian keynote speaker",
    "women's conference speaker",
    "motivational speaker Pennsylvania",
    "church conference speaker",
    "keynote speaker bilingual",
    "faith-based keynote speaker",
    "recovery ministry speaker",
    "women's event speaker",
  ]}
>
  <ServicesHeroLayout>
    <h1 class="relative bottom-10 animate-slide-in-bottom animate-delay-100">
      Christian Keynote <br />
      Speaker for Events &amp; Conferences
    </h1>
  </ServicesHeroLayout>

  <ServicesMainLayout>
    <!-- ── mission-intro ──────────────────────────────────────── -->
    <Fragment slot="mission-intro">
      Powerful, faith-rooted keynotes that move audiences from "just
      surviving" to leading with purpose, resilience, and courage.
    </Fragment>

    <!-- ── mission-image ──────────────────────────────────────── -->
    <img
      slot="mission-image"
      src="/images/services/keynote.webp"
      alt="Angie Pichardo delivering a faith-based keynote on stage"
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
    />

    <!-- ── mission-text ───────────────────────────────────────── -->
    <Fragment slot="mission-text">
      <p>
        <strong>Audiences don't need another motivational talk. They need an honest one.</strong>
        Angie brings her own story of grief, recovery, and rebuilt purpose
        to every stage — paired with scripture, humor, and practical tools
        that people actually use the next morning.
      </p>
      <p>
        Every keynote is tailored to your audience. Whether you are hosting a
        women's conference, a recovery ministry event, a corporate gathering,
        or a Sunday service, the message is crafted to land in that room and
        keep working long after the closing prayer.
      </p>
      <p>
        Bilingual delivery in English and Spanish. In-person nationwide or
        virtual via Zoom. From 30-minute keynotes to 90-minute workshops.
      </p>
    </Fragment>

    <!-- ── best-for (4 cards) ─────────────────────────────────── -->
    <Fragment slot="best-for">
      <div
        class="group bg-angie-cream p-6 md:p-8 rounded-2xl border border-angie-rose/20 hover:border-angie-rose/60 hover:shadow-xl hover:shadow-angie-rose/20 hover:-translate-y-1 transition-all duration-300 timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <div
          class="w-14 h-14 rounded-full bg-angie-rose/20 group-hover:bg-angie-rose/40 flex items-center justify-center mb-4 text-angie-burgundy group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18"></path>
            <path d="M5 21V7l8-4v18"></path>
            <path d="M19 21V11l-6-4"></path>
          </svg>
        </div>
        <h3 class="font-Frauce text-xl text-angie-noir">Corporate Events</h3>
        <p class="mt-2 text-angie-noir/75 font-Grotesk text-sm leading-relaxed">
          Leadership offsites, women in business summits, employee resilience
          programming. Faith-inclusive, professional, and energizing.
        </p>
      </div>

      <div
        class="group bg-angie-cream p-6 md:p-8 rounded-2xl border border-angie-rose/20 hover:border-angie-rose/60 hover:shadow-xl hover:shadow-angie-rose/20 hover:-translate-y-1 transition-all duration-300 timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <div
          class="w-14 h-14 rounded-full bg-angie-rose/20 group-hover:bg-angie-rose/40 flex items-center justify-center mb-4 text-angie-burgundy group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3 class="font-Frauce text-xl text-angie-noir">Women's Conferences</h3>
        <p class="mt-2 text-angie-noir/75 font-Grotesk text-sm leading-relaxed">
          Main-stage keynotes for Christian women's events, mom conferences,
          and marriage/ministry gatherings. Hope, honesty, and a call forward.
        </p>
      </div>

      <div
        class="group bg-angie-cream p-6 md:p-8 rounded-2xl border border-angie-rose/20 hover:border-angie-rose/60 hover:shadow-xl hover:shadow-angie-rose/20 hover:-translate-y-1 transition-all duration-300 timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <div
          class="w-14 h-14 rounded-full bg-angie-rose/20 group-hover:bg-angie-rose/40 flex items-center justify-center mb-4 text-angie-burgundy group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <h3 class="font-Frauce text-xl text-angie-noir">Churches &amp; Ministries</h3>
        <p class="mt-2 text-angie-noir/75 font-Grotesk text-sm leading-relaxed">
          Women's ministry events, recovery ministries, special services, and
          leadership gatherings. Scripture-anchored and Spirit-led.
        </p>
      </div>

      <div
        class="group bg-angie-cream p-6 md:p-8 rounded-2xl border border-angie-rose/20 hover:border-angie-rose/60 hover:shadow-xl hover:shadow-angie-rose/20 hover:-translate-y-1 transition-all duration-300 timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <div
          class="w-14 h-14 rounded-full bg-angie-rose/20 group-hover:bg-angie-rose/40 flex items-center justify-center mb-4 text-angie-burgundy group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20"></path>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <h3 class="font-Frauce text-xl text-angie-noir">Nonprofits &amp; Community</h3>
        <p class="mt-2 text-angie-noir/75 font-Grotesk text-sm leading-relaxed">
          Fundraising luncheons, awareness events, and community programs
          centered on mental health, recovery, or women's empowerment.
        </p>
      </div>
    </Fragment>

    <!-- ── investment (3 cards pricing) ──────────────────────── -->
    <Fragment slot="investment">
      <div
        class="w-full md:flex-1 md:max-w-md group relative overflow-hidden bg-linear-to-br from-angie-wine to-angie-noir p-7 md:p-8 rounded-2xl border border-angie-burgundy/40 hover:border-angie-rose/70 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-angie-rose/30 timeline-view animate-range-[5%_10%] animate-zoom-in"
      >
        <div
          class="absolute -inset-1 bg-linear-to-br from-angie-rose/30 to-angie-burgundy/30 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-linear-to-r from-transparent via-white/10 to-transparent pointer-events-none"
          aria-hidden="true"
        >
        </div>

        <div class="relative">
          <p class="text-angie-rose uppercase tracking-[0.15em] text-xs font-Grotesk-bold">
            Local — Central PA
          </p>
          <p
            class="font-Frauce text-4xl md:text-5xl text-white mt-3 group-hover:text-angie-rose transition-colors duration-500"
          >
            From $750
          </p>
          <p class="text-white/85 font-Grotesk mt-4 text-sm leading-relaxed">
            In-person keynotes within the Harrisburg / Lemoyne / Central PA
            area. 30–60 minute talks. Travel costs included.
          </p>
          <p class="text-white/60 font-Grotesk text-xs mt-4">
            Best for: regional events, church services, local nonprofits
          </p>
          <!-- CTAs: Book a Call (TidyCal) + Pay Now (Stripe) -->
          <div class="relative flex flex-col sm:flex-row gap-2 mt-6">
            <a
              href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
              rel="noopener"
              class="flex-1 inline-flex items-center justify-center px-4 py-2.5 border border-white/30 text-white font-Grotesk-bold text-sm rounded-full hover:bg-white hover:text-angie-noir hover:border-white transition-all duration-300"
            >
              Book a Call
            </a>
            <a
              href="#"
              data-stripe-link
              rel="noopener"
              class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-angie-rose text-angie-noir font-Grotesk-bold text-sm rounded-full hover:bg-white transition-all duration-300 shadow-md"
            >
              Pay Now
            </a>
          </div>
        </div>
      </div>

      <!-- Card FEATURED — Most Booked -->
      <div
        class="w-full md:flex-1 md:max-w-md group relative overflow-hidden bg-linear-to-br from-angie-wine via-angie-burgundy to-angie-noir p-7 md:p-8 rounded-2xl border-2 border-angie-rose/70 ring-2 ring-angie-rose/20 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-angie-rose/50 hover:scale-[1.02] timeline-view animate-range-[5%_10%] animate-zoom-in"
      >
        <div
          class="absolute -inset-2 bg-linear-to-br from-angie-rose/40 via-angie-burgundy/30 to-angie-rose/40 rounded-3xl blur-2xl opacity-50 group-hover:opacity-100 transition-opacity duration-700 -z-10"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-linear-to-r from-transparent via-white/15 to-transparent pointer-events-none"
          aria-hidden="true"
        >
        </div>

        <span
          class="absolute top-2 right-4 z-20 bg-angie-rose text-angie-noir text-xs font-Grotesk-bold px-3 py-1 rounded-full shadow-lg shadow-angie-rose/40"
        >
          Most Booked
        </span>

        <div class="relative">
          <p class="text-angie-rose uppercase tracking-[0.15em] text-xs font-Grotesk-bold">
            National / Virtual
          </p>
          <p
            class="font-Frauce text-4xl md:text-5xl text-white mt-3 group-hover:text-angie-rose transition-colors duration-500"
          >
            Contact
          </p>
          <p class="text-white/85 font-Grotesk mt-4 text-sm leading-relaxed">
            In-person keynotes nationwide (travel quoted separately) and
            virtual keynotes via Zoom. 30–90 minutes including Q&amp;A.
          </p>
          <p class="text-white/60 font-Grotesk text-xs mt-4">
            Best for: conferences, multi-day events, virtual summits
          </p>
          <!-- CTAs: Book a Call (TidyCal) + Pay Now (Stripe) -->
          <div class="relative flex flex-col sm:flex-row gap-2 mt-6">
            <a
              href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
              rel="noopener"
              class="flex-1 inline-flex items-center justify-center px-4 py-2.5 border border-white/30 text-white font-Grotesk-bold text-sm rounded-full hover:bg-white hover:text-angie-noir hover:border-white transition-all duration-300"
            >
              Book a Call
            </a>
            <a
              href="#"
              data-stripe-link
              rel="noopener"
              class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-angie-rose text-angie-noir font-Grotesk-bold text-sm rounded-full hover:bg-white transition-all duration-300 shadow-md"
            >
              Pay Now
            </a>
          </div>
        </div>
      </div>

      <div
        class="w-full md:flex-1 md:max-w-md group relative overflow-hidden bg-linear-to-br from-angie-wine to-angie-noir p-7 md:p-8 rounded-2xl border border-angie-burgundy/40 hover:border-angie-rose/70 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-angie-rose/30 timeline-view animate-range-[5%_10%] animate-zoom-in"
      >
        <div
          class="absolute -inset-1 bg-linear-to-br from-angie-rose/30 to-angie-burgundy/30 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-linear-to-r from-transparent via-white/10 to-transparent pointer-events-none"
          aria-hidden="true"
        >
        </div>

        <div class="relative">
          <p class="text-angie-rose uppercase tracking-[0.15em] text-xs font-Grotesk-bold">
            Workshop
          </p>
          <p
            class="font-Frauce text-4xl md:text-5xl text-white mt-3 group-hover:text-angie-rose transition-colors duration-500"
          >
            Custom
          </p>
          <p class="text-white/85 font-Grotesk mt-4 text-sm leading-relaxed">
            60–90 minute interactive workshops built around your theme:
            resilience, leadership, A.L.I.G.N. framework, or purpose discovery.
          </p>
          <p class="text-white/60 font-Grotesk text-xs mt-4">
            Best for: leadership teams, breakout sessions, retreats
          </p>
          <!-- CTAs: Book a Call (TidyCal) + Pay Now (Stripe) -->
          <div class="relative flex flex-col sm:flex-row gap-2 mt-6">
            <a
              href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
              rel="noopener"
              class="flex-1 inline-flex items-center justify-center px-4 py-2.5 border border-white/30 text-white font-Grotesk-bold text-sm rounded-full hover:bg-white hover:text-angie-noir hover:border-white transition-all duration-300"
            >
              Book a Call
            </a>
            <a
              href="#"
              data-stripe-link
              rel="noopener"
              class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-angie-rose text-angie-noir font-Grotesk-bold text-sm rounded-full hover:bg-white transition-all duration-300 shadow-md"
            >
              Pay Now
            </a>
          </div>
        </div>
      </div>
    </Fragment>

    <Fragment slot="investment-note">
      All keynotes available in English and Spanish. Bilingual events
      available upon request. A discovery call is required for all keynote
      bookings.
    </Fragment>

    <!-- ── how-to-book (3 pasos) ──────────────────────────────── -->
    <Fragment slot="how-to-book">
      <div
        class="group relative bg-white p-6 md:p-8 rounded-2xl shadow-md hover:shadow-2xl hover:shadow-angie-rose/40 hover:-translate-y-2 transition-all duration-500 border border-angie-rose/20 hover:border-angie-rose/60 z-10 overflow-hidden timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <!-- Watermark decorativo del numero -->
        <span
          class="absolute -right-4 -top-6 font-Frauce text-[8rem] md:text-[10rem] leading-none text-angie-rose/10 group-hover:text-angie-rose/20 transition-colors duration-500 select-none pointer-events-none"
          aria-hidden="true"
        >
          01
        </span>

        <div
          class="relative w-14 h-14 md:w-16 md:h-16 rounded-full bg-angie-rose/15 group-hover:bg-angie-rose/30 flex items-center justify-center mb-5 mx-auto group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <span class="font-Frauce text-2xl md:text-3xl text-angie-burgundy">01</span>
        </div>

        <h3 class="font-Grotesk-bold text-angie-noir text-lg text-center">
          Send an Inquiry
        </h3>
        <p class="text-angie-noir/75 font-Grotesk text-sm mt-2 text-center leading-relaxed">
          Book a free 30-minute discovery call to share your event date,
          audience, and goals. We will talk through fit and format.
        </p>
        <div class="text-center">
          <a
            href="https://tidycal.com/angiepspeaks/30min-purpose-discoverycall"
            rel="noopener"
            class="inline-flex items-center gap-1 mt-4 text-angie-burgundy font-Grotesk-bold text-sm hover:text-angie-noir transition-colors duration-300"
          >
            Start the conversation
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div
        class="group relative bg-white p-6 md:p-8 rounded-2xl shadow-md hover:shadow-2xl hover:shadow-angie-rose/40 hover:-translate-y-2 transition-all duration-500 border border-angie-rose/20 hover:border-angie-rose/60 z-10 overflow-hidden timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <!-- Watermark decorativo del numero -->
        <span
          class="absolute -right-4 -top-6 font-Frauce text-[8rem] md:text-[10rem] leading-none text-angie-rose/10 group-hover:text-angie-rose/20 transition-colors duration-500 select-none pointer-events-none"
          aria-hidden="true"
        >
          02
        </span>

        <div
          class="relative w-14 h-14 md:w-16 md:h-16 rounded-full bg-angie-rose/15 group-hover:bg-angie-rose/30 flex items-center justify-center mb-5 mx-auto group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <span class="font-Frauce text-2xl md:text-3xl text-angie-burgundy">02</span>
        </div>

        <h3 class="font-Grotesk-bold text-angie-noir text-lg text-center">
          Customize the Talk
        </h3>
        <p class="text-angie-noir/75 font-Grotesk text-sm mt-2 text-center leading-relaxed">
          Once confirmed, Angie will craft a tailored keynote for your
          audience — including scripture references, stories, and a closing
          call to action that fits your event theme.
        </p>
      </div>

      <div
        class="group relative bg-white p-6 md:p-8 rounded-2xl shadow-md hover:shadow-2xl hover:shadow-angie-rose/40 hover:-translate-y-2 transition-all duration-500 border border-angie-rose/20 hover:border-angie-rose/60 z-10 overflow-hidden timeline-view animate-range-[5%_10%] animate-slide-in-bottom"
      >
        <!-- Watermark decorativo del numero -->
        <span
          class="absolute -right-4 -top-6 font-Frauce text-[8rem] md:text-[10rem] leading-none text-angie-rose/10 group-hover:text-angie-rose/20 transition-colors duration-500 select-none pointer-events-none"
          aria-hidden="true"
        >
          03
        </span>

        <div
          class="relative w-14 h-14 md:w-16 md:h-16 rounded-full bg-angie-rose/15 group-hover:bg-angie-rose/30 flex items-center justify-center mb-5 mx-auto group-hover:scale-110 transition-all duration-300"
          aria-hidden="true"
        >
          <span class="font-Frauce text-2xl md:text-3xl text-angie-burgundy">03</span>
        </div>

        <h3 class="font-Grotesk-bold text-angie-noir text-lg text-center">
          Deliver &amp; Follow Up
        </h3>
        <p class="text-angie-noir/75 font-Grotesk text-sm mt-2 text-center leading-relaxed">
          Angie arrives early, brings her own mic if needed, and stays after
          the talk to meet attendees. Optional follow-up resources for your
          group are included.
        </p>
      </div>
    </Fragment>

    <!-- ── faq (4 details) ───────────────────────────────────── -->
    <Fragment slot="faq">
      <details
        class="group/bg bg-angie-cream rounded-xl p-5 md:p-6 open:shadow-md transition"
      >
        <summary
          class="font-Grotesk-bold text-angie-noir cursor-pointer list-none flex justify-between items-center gap-4"
        >
          <span>What topics do you speak on?</span>
          <span
            class="text-angie-burgundy text-2xl leading-none transition group-open/bg:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p
          class="mt-4 text-angie-noir/80 font-Grotesk text-sm md:text-base leading-relaxed"
        >
          Core topics include overcoming adversity, resilience after grief,
          discovering purpose, the A.L.I.G.N. framework, faith-based
          leadership, women's empowerment, and recovery. Every talk is
          customized to your audience.
        </p>
      </details>

      <details
        class="group/bg bg-angie-cream rounded-xl p-5 md:p-6 open:shadow-md transition"
      >
        <summary
          class="font-Grotesk-bold text-angie-noir cursor-pointer list-none flex justify-between items-center gap-4"
        >
          <span>How long is a typical keynote?</span>
          <span
            class="text-angie-burgundy text-2xl leading-none transition group-open/bg:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p
          class="mt-4 text-angie-noir/80 font-Grotesk text-sm md:text-base leading-relaxed"
        >
          Keynotes range from 30 to 90 minutes depending on your event
          format. A 45-minute keynote with a 15-minute Q&amp;A is the most
          common ask. Half-day and full-day workshops are also available.
        </p>
      </details>

      <details
        class="group/bg bg-angie-cream rounded-xl p-5 md:p-6 open:shadow-md transition"
      >
        <summary
          class="font-Grotesk-bold text-angie-noir cursor-pointer list-none flex justify-between items-center gap-4"
        >
          <span>Do you travel for in-person keynotes?</span>
          <span
            class="text-angie-burgundy text-2xl leading-none transition group-open/bg:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p
          class="mt-4 text-angie-noir/80 font-Grotesk text-sm md:text-base leading-relaxed"
        >
          Yes. Angie speaks nationwide and is based in Lemoyne, Pennsylvania.
          Local events (within the Harrisburg / Central PA area) start at
          $750 with travel included. National events quote travel
          separately.
        </p>
      </details>

      <details
        class="group/bg bg-angie-cream rounded-xl p-5 md:p-6 open:shadow-md transition"
      >
        <summary
          class="font-Grotesk-bold text-angie-noir cursor-pointer list-none flex justify-between items-center gap-4"
        >
          <span>Can the keynote be customized to our theme?</span>
          <span
            class="text-angie-burgundy text-2xl leading-none transition group-open/bg:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p
          class="mt-4 text-angie-noir/80 font-Grotesk text-sm md:text-base leading-relaxed"
        >
          Always. A discovery call before booking lets Angie learn your
          audience, theme, and desired outcomes. The final keynote is built
          specifically for that room — not recycled from past events.
        </p>
      </details>
    </Fragment>
