  </div>
  <div class="grow-2">
    <img src="/images/yoga/relax.webp" class="object-cover object-center  rounded-l-[40%] " >
  </div>
   
  </hero>
  <section
    title="why us"
    class="bg-gradient-wellness w-full"
  >
    <!-- H2 con su propio padding/centering (NO afecta a la fila edge-to-edge) -->
    <div class="text-center px-4 md:px-8 pt-12 md:pt-20 pb-8 md:pb-12">
   
      <h2 class="font-Frauce font-bold text-4xl md:text-5xl lg:text-6xl text-angie-burgundy leading-tight text-balance max-w-3xl mx-auto">
        A Moment of Peace, Delivered to Your Door
      </h2>
      <div class="mt-5 flex items-center justify-center gap-2" aria-hidden="true">
        <span class="h-px w-10 bg-angie-rose/60"></span>
        <span class="w-2 h-2 rounded-full bg-angie-rose"></span>
        <span class="h-px w-10 bg-angie-rose/60"></span>
      </div>
    </div>

    <!-- Edge-to-edge: imagen 50% + card 50% = 100vw -->
    <div class="flex flex-col md:flex-row w-full">
      <!-- Image: 50% en desktop, full width en mobile, edge-to-edge (sin border-radius externo) -->
      <div class="md:w-1/2 relative order-1">
        <img
          src="/images/yoga/wellnes.webp"
          alt="Zion Lounge wellness experience — woman enjoying a relaxing scalp therapy session"
          class="w-full h-full min-h-75 md:min-h-140 lg:min-h-160 object-cover object-center md:rounded-l-4xl"
        >
      </div>

      <!-- Card derecha: 50% en desktop, full width en mobile, sin border-radius externo -->
      <div class="md:w-1/2 order-2 relative overflow-hidden bg-linear-to-br from-white/95 via-angie-cream/85 to-angie-rose/30 p-6 md:p-10 lg:p-14 xl:p-16 flex flex-col justify-center gap-5 md:gap-6 border-t md:border-t-0 md:border-l border-white/80 shadow-[-20px_0_40px_-20px_rgba(138,38,84,0.25)]">
        <!-- Decorative glows -->
        <div aria-hidden="true" class="absolute -top-10 -right-10 w-40 h-40 md:w-52 md:h-52 rounded-full bg-angie-rose/25 blur-3xl pointer-events-none"></div>
        <div aria-hidden="true" class="absolute -bottom-10 -left-10 w-32 h-32 md:w-44 md:h-44 rounded-full bg-angie-burgundy/20 blur-3xl pointer-events-none"></div>

        <!-- Body / intro -->
        <p class="relative text-angie-noir/85 text-base md:text-lg leading-relaxed text-balance max-w-xl">
          Zion Lounge brings the full wellness experience to your home, office, or private event — anywhere within 20 miles of Lemoyne, PA. No drive, no waiting room, no pressure. Just you, Angie, and an hour to pause, breathe, and reset.
        </p>

       

        <!-- The Zion Experience: 3 value prop cards (Holistic, Personal, Easy Booking) -->
        <div class="relative space-y-3">
          <h3 class="font-Grotesk-bold text-[10px] md:text-xs tracking-[0.3em] uppercase text-angie-rose text-center">
            The Zion Experience
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-3 lg:gap-4">
            <!-- Holistic -->
            <div class="group text-center p-4 md:p-5 rounded-xl bg-white/80 border border-angie-rose/30 hover:bg-white hover:border-angie-rose/60 hover:shadow-lg transition-all duration-300">
              <div class="inline-flex w-12 h-12 md:w-14 md:h-14 rounded-full bg-linear-to-br from-angie-rose/45 to-angie-burgundy/20 items-center justify-center text-angie-burgundy border border-angie-rose/40 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.5c1 1.5.5 7-2.4 9.5-1.8 1.5-3.5 2-5.8 2zM2 21c0-3 1.85-5.36 5.08-6"></path>
                </svg>
              </div>
              <h4 class="font-Frauce font-bold text-base md:text-lg text-angie-burgundy leading-tight mb-1">Holistic Care</h4>
              <p class="text-xs md:text-sm text-angie-noir/70 leading-snug">A reset for mind, body, and spirit — all in one session.</p>
            </div>

            <!-- Personal Service -->
            <div class="group text-center p-4 md:p-5 rounded-xl bg-white/80 border border-angie-rose/30 hover:bg-white hover:border-angie-rose/60 hover:shadow-lg transition-all duration-300">
              <div class="inline-flex w-12 h-12 md:w-14 md:h-14 rounded-full bg-linear-to-br from-angie-rose/45 to-angie-burgundy/20 items-center justify-center text-angie-burgundy border border-angie-rose/40 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <h4 class="font-Frauce font-bold text-base md:text-lg text-angie-burgundy leading-tight mb-1">Personal Service</h4>
              <p class="text-xs md:text-sm text-angie-noir/70 leading-snug">One-on-one with Angie. No rotating staff, no rush.</p>
            </div>

            <!-- Easy Booking -->
            <div class="group text-center p-4 md:p-5 rounded-xl bg-white/80 border border-angie-rose/30 hover:bg-white hover:border-angie-rose/60 hover:shadow-lg transition-all duration-300">
              <div class="inline-flex w-12 h-12 md:w-14 md:h-14 rounded-full bg-linear-to-br from-angie-rose/45 to-angie-burgundy/20 items-center justify-center text-angie-burgundy border border-angie-rose/40 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                  <path d="M9 16l2 2 4-4"></path>
                </svg>
              </div>
              <h4 class="font-Frauce font-bold text-base md:text-lg text-angie-burgundy leading-tight mb-1">Easy Booking</h4>
              <p class="text-xs md:text-sm text-angie-noir/70 leading-snug">$20 deposit. Confirmed within 24 hours.</p>
            </div>
          </div>
        </div>
         <!-- 3 Best For cards en grid 1 col mobile / 3 col desktop -->
         <div class="relative space-y-3">
          <h3 class="font-Grotesk-bold text-[10px] md:text-xs tracking-[0.3em] uppercase text-angie-rose text-center">
            Perfect For
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-3 lg:gap-4">
            <!-- Moms -->
