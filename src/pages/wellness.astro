        aria-controls="phone-reveal"
        aria-label="Reveal Angie's contact number"
        class="group relative inline-flex items-center justify-center gap-2 overflow-hidden px-5 py-3 md:px-6 md:py-3 bg-white text-angie-noir border border-white rounded-full font-Frauce text-base md:text-lg transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-black focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60 cursor-pointer min-w-55 sm:min-w-60"
