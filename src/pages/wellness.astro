    </div>
  </section>

  <!--
		==========================================
		SERVICES SECTION — What's included
		==========================================
		5 componentes del Relaxation Therapy. Grid responsive: 1 col mobile,
		2 col tablet, 3 col desktop (3+2 en última fila), 5 col xl.
	-->
  <section
    title="services"
    id="services"
    aria-labelledby="services-heading"
    class="bg-white w-full py-16 md:py-24"
  >
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <header class="text-center mb-12 md:mb-16">
        <h2
          id="services-heading"
          class="font-Frauce font-bold text-4xl md:text-6xl text-angie-burgundy leading-tight mb-4 text-balance"
        >
          Our Wellness Services
        </h2>
        <p class="text-angie-noir/75 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Every Zion Experience includes these five elements, tailored to what you need that day. You choose what resonates — Angie guides the rest.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 md:gap-5">
