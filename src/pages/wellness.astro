---
import MorphIcon from "morphicons/astro";
import MainLayout from "../layout/MainLayout.astro";

const faqs = [
  {
    question: "What is mobile relaxation therapy?",
    answer:
      "Mobile relaxation therapy is a hands-on wellness session where a certified practitioner comes to your home to help you release tension and reset. At Zion Lounge, Angie Pichardo brings the full experience to you within 20 miles of Lemoyne, PA.",
  },
  {
    question: "How far does Zion Lounge travel?",
    answer:
      "We serve Lemoyne, PA and anywhere within a 20-mile radius, including Harrisburg, Camp Hill, New Cumberland, and Mechanicsburg. Not sure if you're in our service area? Just text Angie at 717-298-0240.",
  },
  {
    question: "What's included in the Relaxation Therapy session?",
    answer:
      "Every session includes Scratch Therapy, Scalp Therapy, relaxing music, a 3-minute guided gratitude moment, and an optional prayer. You choose what you need that day — Angie tailors the experience to you.",
  },
  {
    question: "How much is the deposit?",
    answer:
      "A $20 deposit reserves your appointment. Your booking is only confirmed once you receive a confirmation message from Angie within 24 hours.",
  },
  {
    question: "Do I need to prepare anything at home?",
    answer:
      "Just a quiet space where you can sit or lie down comfortably for about an hour. Angie brings everything else — all you have to do is show up for yourself.",
  },
  {
    question: "Is the prayer part of the session optional?",
    answer:
      "Yes. Prayer is always offered as an option, never required. It is there for guests who want peace, strength, or clarity — and you can decline at any time.",
  },
  {
    question: "How long is a typical session?",
    answer:
      "A standard Zion Experience runs about 60 minutes from arrival to wrap-up. If you have a longer event or want to add services, just let Angie know when you book.",
  },
  {
    question: "Can I book a session for a group or private event?",
    answer:
      "Absolutely. Angie offers group sessions for bridal showers, women's retreats, corporate wellness days, and private events. Reach out to discuss a custom experience for your group.",
  },
  {
    question: "What is your cancellation policy?",
    answer:
      "Life happens. If you need to reschedule, just let us know at least 24 hours in advance and we'll move your deposit to a new date — no fees, no stress.",
  },
  {
    question: "Who is Angie Pichardo?",
    answer:
      "Angie Pichardo is a certified Wellness Practitioner and Life Purpose Coach, and the founder of Zion Lounge. She has been serving women in central Pennsylvania with mobile wellness experiences rooted in peace, faith, and renewal.",
  },
];

// Schema.org FAQPage — Google rich results + AI engine extraction (ChatGPT, Perplexity, Claude)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

// Schema.org HealthAndBeautyBusiness + Service — Local SEO + Google rich results
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: "Zion Lounge",
  url: "https://graceafterthegrave.com/wellness",
  description:
    "Mobile wellness therapy serving women in Lemoyne, PA and within a 20-mile radius. Founded by Angie Pichardo, certified Wellness Practitioner and Life Purpose Coach.",
  telephone: "+1-717-298-0240",
  priceRange: "$20+",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lemoyne",
    addressRegion: "PA",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Lemoyne" },
    { "@type": "City", name: "Harrisburg" },
    { "@type": "City", name: "Camp Hill" },
    { "@type": "City", name: "New Cumberland" },
    { "@type": "City", name: "Mechanicsburg" },
    { "@type": "City", name: "Steelton" },
    { "@type": "City", name: "Shiremanstown" },
    { "@type": "City", name: "Wormleysburg" },
    { "@type": "City", name: "Enola" },
  ],
  founder: {
    "@type": "Person",
    name: "Angie Pichardo",
    jobTitle: "Wellness Practitioner & Life Purpose Coach",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Zion Experience Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Mobile Relaxation Therapy",
          description:
            "Mobile wellness session including Scratch Therapy, Scalp Therapy, Relaxing Music, a 3-minute Guided Gratitude Session, and optional Prayer. Delivered to your home within 20 miles of Lemoyne, PA.",
          provider: { "@type": "HealthAndBeautyBusiness", name: "Zion Lounge" },
          areaServed: { "@type": "City", name: "Lemoyne, PA" },
        },
        price: "20",
        priceCurrency: "USD",
      },
    ],
  },
};

const BOOK_URL = "https://tidycal.com/angiepspeaks/experiencebooking";

const experience = [
  { t: "Holistic Care", d: "A reset for mind, body, and spirit in one session." },
  { t: "Personal Service", d: "One-on-one with Angie." },
  { t: "Easy Booking", d: "$20 deposit. Confirmed within 24 hours." },
];

const perfectFor = [
  { t: "Moms", d: "You've been holding everyone else. Your turn." },
  { t: "Busy Women", d: "Wellness that comes to you." },
  { t: "Leaders", d: "Refill the cup you pour from all day." },
];

const services = [
  { t: "Scratch Therapy", d: "Relieves tension and promotes deep relaxation." },
  { t: "Scalp Therapy", d: "Nourishes the scalp, improves circulation, and supports healthy hair." },
  { t: "Relaxing Music", d: "Soothing sounds to calm your mind and help you unwind." },
  { t: "3-Min Gratitude", d: "A guided moment to reset your mind and uplift your spirit." },
  { t: "Optional Prayer", d: "Available on request for peace, strength, and clarity." },
];

const steps = [
  { t: "Book online", d: "Reserve your spot with a $20 deposit." },
  { t: "Angie reaches out", d: "Within 24 hours, Angie personally contacts you to confirm details." },
  { t: "Confirm location", d: "We verify your address is within our 20-mile Lemoyne service radius." },
  { t: "Your session", d: "Angie arrives at your home and the session begins." },
];

const cities = [
  ["Harrisburg", "~3 mi"], ["Camp Hill", "~3 mi"], ["New Cumberland", "~4 mi"], ["Mechanicsburg", "~8 mi"],
  ["Steelton", "~5 mi"], ["Shiremanstown", "~7 mi"], ["Wormleysburg", "~4 mi"], ["Enola", "~6 mi"],
];
---

<MainLayout
  title="Mobile Wellness in Lemoyne, PA | Zion by Angie Pichardo"
  description="Mobile wellness in Lemoyne, PA and within 20-mile radius. Zion by Angie Pichardo offers scalp therapy, scratch therapy, gratitude sessions, prayer and wellness coaching. $20 deposit."
  canonicalPath="/wellness/"
  keywords={[
    "mobile wellness Lemoyne PA",
    "Zion Lounge wellness experience",
    "Christian wellness practitioner Pennsylvania",
    "scalp therapy Central PA",
    "relaxation therapy near me",
    "wellness coaching for women",
    "prayer and gratitude session PA",
    "women's mobile wellness service",
  ]}
>
  <!-- Leaflet CSS (OpenStreetMap) -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  {/* HERO — copy left, photo bleeding to the section floor on the right.
      Phone button keeps the data-phone-* wiring used by the script below. */}
  <section aria-labelledby="wellness-hero-heading" class="relative isolate overflow-hidden w-full bg-gradient-nocturne text-angie-cream">
    <div class="max-w-7xl mx-auto grid md:grid-cols-12 md:items-stretch">
      <div class="md:col-span-7 px-6 md:pl-10 lg:pl-16 md:pr-12 pt-28 md:pt-44 pb-12 md:pb-24 self-center">
        <h1 id="wellness-hero-heading" class="font-Frauce font-bold leading-[1.02] text-[clamp(2.25rem,6.2vw,4.5rem)] tracking-tight text-balance animate-rise">
          Mobile Wellness Therapy in Lemoyne, PA<span class="sr-only"> | </span><span class="block mt-3 text-[0.45em] leading-tight font-Grotesk-bold tracking-normal text-angie-rose">Zion Lounge</span>
        </h1>
        <p class="mt-6 measure text-angie-cream/85 text-lg md:text-xl leading-relaxed animate-rise" style="animation-delay:120ms">
          A moment of peace, delivered to your door. $20 deposit, confirmed within 24 hours.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3 animate-rise" style="animation-delay:240ms">
          <a
            href={BOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Book your experience (opens in a new tab)"
            class="btn btn-glass hover:animate-tada"
          >
            Book your experience
          </a>

          <button
            type="button"
            data-phone-toggle
            data-phone-number="+17172980240"
            data-phone-display="717-298-0240"
            aria-expanded="false"
            aria-label="Reveal Angie's contact number"
            class="btn btn-glass min-w-52"
          >
            <span class="sr-only" data-phone-sr>Contact number</span>
            <svg data-phone-icon-default class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <svg data-phone-icon-revealed class="hidden w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span data-phone-label>Contact number</span>
          </button>
        </div>
      </div>

      <div class="md:col-span-5 px-6 md:px-0 md:pt-28 animate-zoom-in" style="animation-delay:160ms">
        <div class="relative aspect-[4/3] md:aspect-auto md:h-full md:min-h-[30rem] overflow-hidden rounded-t-lg">
          <img
            src="/images/yoga/relax.webp"
            alt="Woman relaxing during a Zion Lounge mobile wellness session"
            width="683"
            height="1024"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover object-[50%_30%]"
          />
        </div>
      </div>
    </div>
  </section>

  {/* WHY ZION — type-led: statement left, hairline facts right */}
  <section aria-labelledby="why-heading" class="relative isolate overflow-hidden w-full bg-[linear-gradient(160deg,#FFF5FA_0%,#FBC2EB_55%,#E8A0B8_100%)] text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 pt-16 md:pt-28 pb-20 md:pb-24 grid md:grid-cols-12 gap-x-12 gap-y-12">
      <div class="md:col-span-7">
        <h2 id="why-heading" class="font-Frauce font-bold text-[clamp(2rem,4.6vw,3.5rem)] leading-[1.05] text-balance">
          A Moment of Peace, Delivered to Your Door
        </h2>
        <p class="mt-6 measure text-angie-noir/80 text-lg leading-relaxed">
          Zion Lounge brings the full wellness experience to your home, office, or private event, anywhere within 20 miles of Lemoyne, PA. One hour, one-on-one with Angie.
        </p>
        <a
          href={BOOK_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Book Your Experience (opens in a new tab)"
          class="link-arrow mt-8 text-angie-burgundy min-h-11"
        >
          Book Your Experience
        </a>
      </div>

      <div class="md:col-span-5 md:pt-2">
        <h3 class="font-Grotesk-bold text-sm text-angie-burgundy">The Zion Experience</h3>
        <dl class="mt-3 card-glass-light px-6">
          {experience.map((c) => (
            <div class="py-4 border-b border-angie-noir/15">
              <dt class="font-Frauce font-bold text-xl">{c.t}</dt>
              <dd class="mt-1 text-angie-noir/75 leading-relaxed">{c.d}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="md:col-span-12 md:mt-6">
        <h3 class="font-Grotesk-bold text-sm text-angie-burgundy">Perfect For</h3>
        <ul class="mt-3 grid md:grid-cols-3 card-glass-light px-6">
          {perfectFor.map((c) => (
            <li class="py-5 md:pr-8 border-b border-angie-noir/15 md:border-b-0">
              <p class="font-Frauce font-bold text-2xl">{c.t}</p>
              <p class="mt-1 text-angie-noir/75 leading-relaxed">{c.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* SERVICES — hairline list with a cropped detail photo */}
  <section id="services" aria-labelledby="services-heading" class="relative isolate overflow-hidden w-full bg-gradient-nocturne text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-12 gap-x-12 gap-y-10">
      <div class="md:col-span-4">
        <h2 id="services-heading" class="font-Frauce font-bold text-[clamp(2rem,4vw,3rem)] leading-[1.08]">Our Wellness Services</h2>
        <p class="mt-5 text-angie-cream/85 text-lg leading-relaxed">
          Every Zion Experience includes these five elements, tailored to what you need that day. You choose what resonates and Angie guides the rest.
        </p>
        <div class="hidden md:block relative mt-10 w-full max-w-[16rem] aspect-[288/500] overflow-hidden rounded-lg">
          <img
            src="/images/yoga/therapy.webp"
            alt="Close-up of hands during a relaxing scalp therapy session"
            width="960"
            height="1280"
            loading="lazy"
            decoding="async"
            class="absolute max-w-none w-[333%] left-[-173%] top-[-20.4%]"
          />
        </div>
      </div>

      <ul class="md:col-span-8 card-glass px-6 md:px-8">
        {services.map((s) => (
          <li class="grid sm:grid-cols-12 gap-x-6 gap-y-1 py-6 md:py-7 border-b border-angie-cream/20">
            <h3 class="sm:col-span-5 font-Frauce font-bold text-2xl leading-snug">{s.t}</h3>
            <p class="sm:col-span-7 text-angie-cream/85 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* HOW IT WORKS — plain steps, hairline separated */}
  <section id="how-it-works" aria-labelledby="how-heading" class="relative isolate overflow-hidden w-full bg-[linear-gradient(160deg,#FFF5FA_0%,#FBC2EB_55%,#E8A0B8_100%)] text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 py-14 md:py-20 grid md:grid-cols-12 gap-x-12 gap-y-8">
      <div class="md:col-span-4">
        <h2 id="how-heading" class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1]">How the Zion Experience Works</h2>
        <p class="mt-4 text-angie-noir/75 text-lg leading-relaxed">From booking to your session in four steps.</p>
      </div>
      <ol class="md:col-span-8 card-glass-light px-6">
        {steps.map((s, i) => (
          <li class="grid grid-cols-[2rem_1fr] sm:grid-cols-[2.5rem_14rem_1fr] gap-x-4 gap-y-1 py-5 border-b border-angie-noir/15">
            <span class="font-Grotesk-bold text-angie-burgundy tabular-nums">{i + 1}</span>
            <h3 class="font-Grotesk-bold text-lg">{s.t}</h3>
            <p class="col-start-2 sm:col-start-3 text-angie-noir/75 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ABOUT ANGIE — photo + bio (E-E-A-T) */}
  <section id="about-angie" aria-labelledby="about-heading" class="relative isolate overflow-hidden w-full bg-gradient-nocturne text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-28 grid md:grid-cols-12 gap-x-14 gap-y-10 items-center">
      <div class="md:col-span-5 timeline-view animate-range-entry animate-rise">
        <img
          src="/images/angie-practitioner.webp"
          alt="Angie Pichardo — Wellness Practitioner and Life Purpose Coach, founder of Zion Lounge"
          width="1280"
          height="1280"
          loading="lazy"
          decoding="async"
          class="w-full max-w-sm md:max-w-none aspect-[4/5] object-cover object-[62%_15%] rounded-lg"
        />
      </div>
      <div class="md:col-span-7">
        <h2 id="about-heading" class="font-Frauce font-bold text-[clamp(2rem,4.4vw,3.25rem)] leading-[1.05]">Hi, I'm Angie Pichardo.</h2>
        <p class="mt-6 measure text-angie-cream/90 text-lg leading-relaxed">
          I'm a certified <strong>Wellness Practitioner</strong> and <strong>Life Purpose Coach</strong>, and the founder of <strong>Zion Lounge</strong>. I created the Zion Experience to give women in central Pennsylvania a place to exhale, without leaving home.
        </p>
        <p class="mt-4 measure text-angie-cream/90 text-lg leading-relaxed">
          I bring the full wellness experience to your home, office, or private event, anywhere within 20 miles of Lemoyne. My approach is rooted in faith, peace, and the belief that <em>self-care isn't selfish, it's stewardship.</em>
        </p>
        <ul class="mt-7 card-glass px-5 max-w-md">
          {["Certified Wellness Practitioner", "Life Purpose Coach", "Founder, Zion Lounge"].map((b) => (
            <li class="py-3 border-b border-angie-cream/15 font-Grotesk-bold">{b}</li>
          ))}
        </ul>
        <a
          href="tel:+17172980240"
          aria-label="Have a question? Text me directly, 717-298-0240"
          class="btn btn-glass mt-9"
        >
          Have a question? Text me directly
        </a>
      </div>
    </div>
  </section>

  {/* SERVICE AREA + FAQ — one cream spread, split by a hairline */}
  <section id="service-area" aria-labelledby="area-heading" class="relative isolate overflow-hidden w-full bg-[linear-gradient(160deg,#FFF5FA_0%,#FBC2EB_55%,#E8A0B8_100%)] text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 pt-16 md:pt-24 pb-14 md:pb-20">
      <header class="max-w-3xl">
        <h2 id="area-heading" class="font-Frauce font-bold text-[clamp(2rem,4.2vw,3.25rem)] leading-[1.05] text-balance">Serving Lemoyne, PA and Within 20 Miles</h2>
        <p class="mt-5 measure text-angie-noir/80 text-lg leading-relaxed">
          Mobile wellness delivered to your home, office, or private event across central Pennsylvania. Not sure if you're in our area? Just text Angie.
        </p>
      </header>

      <div class="mt-10 grid lg:grid-cols-12 gap-x-10 gap-y-8 items-start">
        <div class="lg:col-span-5">
          <p class="font-Frauce font-bold text-2xl text-angie-burgundy">Lemoyne, PA</p>
          <p class="text-angie-noir/75">Headquarters</p>
          <ul class="mt-5 grid grid-cols-2 gap-x-6 card-glass-light px-5">
            {cities.map(([city, dist]) => (
              <li class="flex items-baseline justify-between gap-3 py-3 border-b border-angie-noir/15">
                <span class="font-Grotesk-bold">{city}</span>
                <span class="text-sm text-angie-noir/70 tabular-nums">{dist}</span>
              </li>
            ))}
          </ul>
          <p class="mt-7 text-angie-noir/80">Not sure if you're in our service area?</p>
          <a
            href="tel:+17172980240"
            class="btn btn-glass-dark mt-3"
          >
            Text Angie: 717-298-0240
          </a>
        </div>

        <div class="lg:col-span-7">
          <div
            id="service-map"
            role="region"
            aria-label="Interactive service area map centered on Lemoyne, PA with a 20-mile radius"
            class="relative z-0 w-full h-[340px] md:h-[480px] rounded-lg overflow-hidden"
          ></div>
          <p class="mt-3 text-sm text-angie-noir/70">
            The red circle marks the 20-mile service radius around Zion Lounge in Lemoyne, PA.
          </p>
        </div>
      </div>
    </div>

    <div id="faq" role="region" aria-labelledby="faq-heading" class="max-w-6xl mx-auto px-6">
      <div class="border-t border-angie-noir/25 pt-14 md:pt-20 pb-16 md:pb-28 grid md:grid-cols-12 gap-x-12 gap-y-8">
        <header class="md:col-span-4">
          <h2 id="faq-heading" class="font-Frauce font-bold text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.1]">Frequently Asked Questions</h2>
          <p class="mt-4 text-angie-noir/75 text-lg leading-relaxed">Before you book your Zion Experience.</p>
          <p class="mt-8 text-angie-noir/80">Still have questions? Angie personally responds within 24 hours.</p>
          <a
            href="tel:+17172980240"
            aria-label="Call or text Angie at 717-298-0240"
            class="link-arrow mt-2 min-h-11 text-angie-burgundy"
          >
            Text Angie at 717-298-0240
          </a>
        </header>

        <div class="md:col-span-8 card-glass-light px-6">
          {faqs.map((faq) => (
            <details class="group/faq border-b border-angie-noir/15">
              <summary class="cursor-pointer list-none flex justify-between items-center gap-4 min-h-14 py-4 font-Frauce font-bold text-lg md:text-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-angie-burgundy [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <svg aria-hidden="true" class="shrink-0 w-5 h-5 text-angie-burgundy transition-transform duration-300 group-open/faq:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </summary>
              <p class="pb-5 pr-9 measure text-angie-noir/80 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ JSON-LD Schema — Google rich results + AI engine citation source -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>

  <!-- Business + Service JSON-LD Schema — Local SEO + Google rich results -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)}></script>

  <!-- Leaflet JS (OpenStreetMap) — carga el mapa interactivo -->
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script is:inline>
    (function () {
      var mapInstance = null;

      // Cleanup helper — destruye el mapa y libera memoria
      function destroyMap() {
        if (mapInstance) {
          try { mapInstance.remove(); } catch (e) { /* noop */ }
          mapInstance = null;
        }
      }

      function initServiceMap() {
        var mapEl = document.getElementById("service-map");

        // Si no hay div de mapa en esta página, limpia cualquier instancia anterior
        if (!mapEl) {
          destroyMap();
          return;
        }

        // Si Leaflet todavía no terminó de cargar (caso client-side nav),
        // reintenta cada 150ms hasta que esté listo (máx ~3s)
        if (typeof L === "undefined") {
          var attempts = (initServiceMap._attempts || 0) + 1;
          initServiceMap._attempts = attempts;
          if (attempts > 20) { initServiceMap._attempts = 0; return; }
          setTimeout(initServiceMap, 150);
          return;
        }
        initServiceMap._attempts = 0;

        // Si ya hay un mapa en este mismo div, destrúyelo antes de crear uno nuevo
        // (pasa si Astro re-monta el componente)
        if (mapInstance) {
          destroyMap();
        }

        // Lemoyne, PA — centro del servicio
        var center = [40.2412, -76.8944];
        var radiusMeters = 32186.88; // 20 millas

        mapInstance = L.map(mapEl, {
          center: center,
          zoom: 9,
          scrollWheelZoom: false,
          zoomControl: true,
        });

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 18,
        }).addTo(mapInstance);

        // Círculo del radio de 20 millas — rojo, opacidad baja (0.15)
        L.circle(center, {
          radius: radiusMeters,
          color: "#dc2626",
          weight: 2,
          opacity: 0.7,
          fillColor: "#dc2626",
          fillOpacity: 0.15,
        })
          .addTo(mapInstance)
          .bindPopup(
            "<div style=\"text-align:center;font-family:serif;\"><strong style=\"color:#8A2654;\">20-Mile Service Radius</strong><br/><span style=\"font-size:12px;color:#1F0612;\">Mobile wellness across central Pennsylvania</span></div>"
          );

        // Marcador personalizado en Lemoyne
        var markerIcon = L.divIcon({
          className: "zion-marker",
          html:
            '<div style="width:28px;height:28px;background:#8A2654;border:3px solid #fff;border-radius:50%;box-shadow:0 3px 10px rgba(0,0,0,0.4);"></div>',
          iconSize: [28, 28],
          iconAnchor: [14, 14],
        });

        L.marker(center, { icon: markerIcon, title: "Zion Lounge — Lemoyne, PA" })
          .addTo(mapInstance)
          .bindPopup(
            "<div style=\"text-align:center;font-family:Georgia,serif;\"><strong style=\"color:#8A2654;font-size:14px;\">Zion Lounge</strong><br/><span style=\"font-size:12px;color:#1F0612;\">Lemoyne, PA &middot; Mobile Wellness</span></div>"
          )
          .openPopup();
      }

      // ── Lifecycle hooks para Astro View Transitions (ClientRouter) ──
      // 1) Initial load (carga directa de la página)
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initServiceMap);
      } else {
        initServiceMap();
      }

      // 2) Navegación desde otra página (ClientRouter) — este era el bug
      document.addEventListener("astro:page-load", initServiceMap);

      // 3) Cleanup antes de salir de /wellness (evita memory leak)
      document.addEventListener("astro:before-swap", destroyMap);
    })();
  </script>

  {/* FINAL CTA — solid burgundy plane */}
