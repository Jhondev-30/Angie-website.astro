              <div class="inline-flex w-12 h-12 md:w-14 md:h-14 rounded-full bg-linear-to-br from-angie-rose/45 to-angie-burgundy/20 items-center justify-center text-angie-burgundy border border-angie-rose/40 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </div>
              <h4 class="font-Frauce font-bold text-base md:text-lg text-angie-burgundy leading-tight mb-1">Moms</h4>
              <p class="text-xs md:text-sm text-angie-noir/70 leading-snug">You've been holding everyone else. Your turn.</p>
            </div>

            <!-- Busy Women -->
            <div class="group text-center p-4 md:p-5 rounded-xl bg-white/80 border border-angie-rose/30 hover:bg-white hover:border-angie-rose/60 hover:shadow-lg transition-all duration-300">
              <div class="inline-flex w-12 h-12 md:w-14 md:h-14 rounded-full bg-linear-to-br from-angie-rose/45 to-angie-burgundy/20 items-center justify-center text-angie-burgundy border border-angie-rose/40 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <h4 class="font-Frauce font-bold text-base md:text-lg text-angie-burgundy leading-tight mb-1">Busy Women</h4>
              <p class="text-xs md:text-sm text-angie-noir/70 leading-snug">Wellness that comes to you. No drive, no waiting.</p>
            </div>

            <!-- Leaders -->
            <div class="group text-center p-4 md:p-5 rounded-xl bg-white/80 border border-angie-rose/30 hover:bg-white hover:border-angie-rose/60 hover:shadow-lg transition-all duration-300">
              <div class="inline-flex w-12 h-12 md:w-14 md:h-14 rounded-full bg-linear-to-br from-angie-rose/45 to-angie-burgundy/20 items-center justify-center text-angie-burgundy border border-angie-rose/40 mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <h4 class="font-Frauce font-bold text-base md:text-lg text-angie-burgundy leading-tight mb-1">Leaders</h4>
              <p class="text-xs md:text-sm text-angie-noir/70 leading-snug">Refill the cup you pour from all day.</p>
            </div>
          </div>
        </div>

        <!-- CTA al final del card -->
        <a
          href="https://tidycal.com/angiepspeaks/experiencebooking"
          target="_blank"
          rel="noopener noreferrer"
          class="group/cta relative inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-angie-burgundy text-white rounded-full font-Frauce text-base md:text-lg font-bold transition-all duration-300 hover:scale-105 hover:bg-angie-wine hover:shadow-2xl hover:shadow-angie-burgundy/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-angie-burgundy/60 w-full sm:w-auto"
          aria-label="Book your Zion Experience on TidyCal (opens in a new tab)"
        >
          <span>Book Your Experience</span>
          <svg class="w-5 h-5 transition-transform duration-300 group-hover/cta:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
