        <span
          aria-hidden="true"
          class="absolute inset-0 bg-angie-rose transition-transform duration-500 ease-out translate-y-full group-hover:translate-y-0"
        ></span>
        <span class="relative inline-flex items-center gap-2 transition-colors duration-300 group-hover:text-white">
          <span>Book your experience</span>
          <svg
            class="w-4 h-4 md:w-5 md:h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
