---
import MorphIcon from "morphicons/astro";
import MainLayout from "../layout/MainLayout.astro";

const faqs = [
  {
    question: "What is mobile relaxation therapy?",
    answer:
      "Mobile relaxation therapy is a hands-on wellness session where a certified practitioner comes to your home to help you release tension and reset. At Zion Lounge, Angie Pichardo brings the full experience to you within 20 miles of Lemoyne, PA.",
  },
  {
    question: "How far does Zion Lounge travel?",
    answer:
      "We serve Lemoyne, PA and anywhere within a 20-mile radius, including Harrisburg, Camp Hill, New Cumberland, and Mechanicsburg. Not sure if you're in our service area? Just text Angie at 717-298-0240.",
  },
  {
    question: "What's included in the Relaxation Therapy session?",
    answer:
      "Every session includes Scratch Therapy, Scalp Therapy, relaxing music, a 3-minute guided gratitude moment, and an optional prayer. You choose what you need that day — Angie tailors the experience to you.",
  },
  {
    question: "How much is the deposit?",
    answer:
      "A $20 deposit reserves your appointment. Your booking is only confirmed once you receive a confirmation message from Angie within 24 hours.",
  },
  {
    question: "Do I need to prepare anything at home?",
    answer:
      "Just a quiet space where you can sit or lie down comfortably for about an hour. Angie brings everything else — all you have to do is show up for yourself.",
  },
  {
    question: "Is the prayer part of the session optional?",
    answer:
      "Yes. Prayer is always offered as an option, never required. It is there for guests who want peace, strength, or clarity — and you can decline at any time.",
  },
  {
    question: "How long is a typical session?",
    answer:
      "A standard Zion Experience runs about 60 minutes from arrival to wrap-up. If you have a longer event or want to add services, just let Angie know when you book.",
  },
  {
    question: "Can I book a session for a group or private event?",
    answer:
      "Absolutely. Angie offers group sessions for bridal showers, women's retreats, corporate wellness days, and private events. Reach out to discuss a custom experience for your group.",
  },
  {
    question: "What is your cancellation policy?",
    answer:
      "Life happens. If you need to reschedule, just let us know at least 24 hours in advance and we'll move your deposit to a new date — no fees, no stress.",
  },
  {
    question: "Who is Angie Pichardo?",
    answer:
      "Angie Pichardo is a certified Wellness Practitioner and Life Purpose Coach, and the founder of Zion Lounge. She has been serving women in central Pennsylvania with mobile wellness experiences rooted in peace, faith, and renewal.",
  },
];

// Schema.org FAQPage — Google rich results + AI engine extraction (ChatGPT, Perplexity, Claude)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

// Schema.org HealthAndBeautyBusiness + Service — Local SEO + Google rich results
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: "Zion Lounge",
  url: "https://graceafterthegrave.com/wellness",
  description:
    "Mobile wellness therapy serving women in Lemoyne, PA and within a 20-mile radius. Founded by Angie Pichardo, certified Wellness Practitioner and Life Purpose Coach.",
  telephone: "+1-717-298-0240",
  priceRange: "$20+",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lemoyne",
    addressRegion: "PA",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Lemoyne" },
    { "@type": "City", name: "Harrisburg" },
    { "@type": "City", name: "Camp Hill" },
    { "@type": "City", name: "New Cumberland" },
    { "@type": "City", name: "Mechanicsburg" },
    { "@type": "City", name: "Steelton" },
    { "@type": "City", name: "Shiremanstown" },
    { "@type": "City", name: "Wormleysburg" },
    { "@type": "City", name: "Enola" },
  ],
  founder: {
    "@type": "Person",
    name: "Angie Pichardo",
    jobTitle: "Wellness Practitioner & Life Purpose Coach",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Zion Experience Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Mobile Relaxation Therapy",
          description:
            "Mobile wellness session including Scratch Therapy, Scalp Therapy, Relaxing Music, a 3-minute Guided Gratitude Session, and optional Prayer. Delivered to your home within 20 miles of Lemoyne, PA.",
          provider: { "@type": "HealthAndBeautyBusiness", name: "Zion Lounge" },
          areaServed: { "@type": "City", name: "Lemoyne, PA" },
        },
        price: "20",
        priceCurrency: "USD",
      },
    ],
  },
};
---

<MainLayout
  title="Mobile Wellness in Lemoyne, PA | Zion by Angie Pichardo"
  description="Mobile wellness in Lemoyne, PA and within 20-mile radius. Zion by Angie Pichardo offers scalp therapy, scratch therapy, gratitude sessions, prayer and wellness coaching. $20 deposit."
  canonicalPath="/wellness/"
  keywords={[
    "mobile wellness Lemoyne PA",
    "Zion Lounge wellness experience",
    "Christian wellness practitioner Pennsylvania",
    "scalp therapy Central PA",
    "relaxation therapy near me",
    "wellness coaching for women",
    "prayer and gratitude session PA",
    "women's mobile wellness service",
  ]}
>
  <!-- Leaflet CSS (OpenStreetMap) -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  {/* ============================================================
      HERO — split layout (copy + photo), mobile-first.
      Phone button keeps the data-phone-* wiring used by the script below.
  ============================================================ */}
  <section aria-labelledby="wellness-hero-heading" class="relative isolate overflow-hidden w-full bg-angie-noir text-angie-cream">
    <div aria-hidden="true" class="absolute -top-32 -right-24 w-[26rem] h-[26rem] rounded-full bg-angie-rose/25 blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute -bottom-40 -left-24 w-[28rem] h-[28rem] rounded-full bg-angie-burgundy/40 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-28 md:pt-36 pb-16 md:pb-24 grid md:grid-cols-12 gap-10 md:gap-12 items-center">
      <div class="md:col-span-7 text-center md:text-left">
        <p class="inline-flex items-center gap-2 text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold animate-rise">
          <span aria-hidden="true" class="hidden md:block h-px w-8 bg-angie-rose"></span>
          Zion Lounge · Mobile wellness
        </p>
        <h1 id="wellness-hero-heading" class="mt-5 font-Frauce font-bold leading-[1] text-[clamp(2.25rem,7vw,4.5rem)] tracking-tight text-balance animate-rise" style="animation-delay:120ms">
          Mobile Wellness Therapy in <span class="text-angie-rose">Lemoyne, PA</span> | Zion Lounge
        </h1>
        <p class="mt-6 max-w-xl mx-auto md:mx-0 text-angie-cream/85 text-base md:text-xl leading-relaxed animate-rise" style="animation-delay:240ms">
          A moment of peace, delivered to your door. $20 deposit, confirmed within 24 hours.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3 items-center justify-center md:justify-start animate-rise" style="animation-delay:360ms">
          <a
            href="https://tidycal.com/angiepspeaks/experiencebooking"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Book your experience on TidyCal (opens in a new tab)"
            class="group inline-flex items-center gap-2 px-8 py-4 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold shadow-xl shadow-black/30 transition-all duration-300 hover:bg-white hover:scale-[1.03] active:scale-[0.98]"
          >
            <span>Book your experience</span>
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>

          <button
            type="button"
            data-phone-toggle
            data-phone-number="+17172980240"
            data-phone-display="717-298-0240"
            aria-expanded="false"
            aria-controls="phone-reveal"
            aria-label="Reveal Angie's contact number"
            class="inline-flex items-center justify-center gap-2 min-w-52 px-7 py-4 rounded-full border border-angie-cream/40 text-angie-cream font-Grotesk-bold cursor-pointer transition-all duration-300 hover:bg-angie-cream hover:text-angie-noir"
          >
            <span class="sr-only" data-phone-sr>Contact number</span>
            <svg data-phone-icon-default class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <svg data-phone-icon-revealed class="hidden w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span data-phone-label>Contact number</span>
          </button>
        </div>
      </div>

      <div class="md:col-span-5 animate-zoom-in" style="animation-delay:200ms">
        <div class="relative mx-auto max-w-sm md:max-w-none">
          <div aria-hidden="true" class="absolute inset-4 rounded-[2rem] bg-angie-rose/40 blur-2xl"></div>
          <img
            src="/images/yoga/relax.webp"
            alt="Woman relaxing during a Zion Lounge mobile wellness session"
            width="800"
            height="1000"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative w-full aspect-[4/5] object-cover rounded-[2rem] border border-white/15 shadow-2xl shadow-black/50"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      WHY US — intro + three pillars + "perfect for"
  ============================================================ */}
  <section aria-labelledby="why-heading" class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-5 timeline-view animate-range-entry animate-zoom-in">
        <img
          src="/images/yoga/wellnes.webp"
          alt="Zion Lounge wellness experience — woman enjoying a relaxing scalp therapy session"
          width="800"
          height="900"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[4/5] object-cover rounded-[2rem] shadow-2xl shadow-angie-burgundy/20"
        />
      </div>
      <div class="md:col-span-7">
        <div class="timeline-view animate-range-entry animate-rise">
          <p class="text-angie-burgundy uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">Why Zion</p>
          <h2 id="why-heading" class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-[1.05] text-balance">A Moment of Peace, <span class="text-angie-burgundy">Delivered to Your Door</span></h2>
          <p class="mt-5 text-angie-noir/75 text-base md:text-lg leading-relaxed">
            Zion Lounge brings the full wellness experience to your home, office, or private event — anywhere within 20 miles of Lemoyne, PA. No drive, no waiting room, no pressure. Just you, Angie, and an hour that belongs to you.
          </p>
        </div>

        <h3 class="mt-10 font-Frauce font-bold text-xl">The Zion Experience</h3>
        <ul class="mt-4 grid sm:grid-cols-3 gap-3">
          {[
            { t: "Holistic Care", d: "A reset for mind, body, and spirit — all in one session." },
            { t: "Personal Service", d: "One-on-one with Angie. No rotating staff, no rush." },
            { t: "Easy Booking", d: "$20 deposit. Confirmed within 24 hours." },
          ].map((c) => (
            <li class="rounded-2xl bg-white border border-angie-burgundy/10 shadow-lg shadow-angie-burgundy/5 p-5 timeline-view animate-range-entry animate-rise">
              <h4 class="font-Grotesk-bold text-angie-burgundy">{c.t}</h4>
              <p class="mt-1 text-sm text-angie-noir/70 leading-relaxed">{c.d}</p>
            </li>
          ))}
        </ul>

        <h3 class="mt-8 font-Frauce font-bold text-xl">Perfect For</h3>
        <ul class="mt-4 grid sm:grid-cols-3 gap-3">
          {[
            { t: "Moms", d: "You've been holding everyone else. Your turn." },
            { t: "Busy Women", d: "Wellness that comes to you. No drive, no waiting." },
            { t: "Leaders", d: "Refill the cup you pour from all day." },
          ].map((c) => (
            <li class="rounded-2xl bg-angie-noir text-angie-cream p-5 timeline-view animate-range-entry animate-rise">
              <h4 class="font-Grotesk-bold text-angie-rose">{c.t}</h4>
              <p class="mt-1 text-sm text-angie-cream/75 leading-relaxed">{c.d}</p>
            </li>
          ))}
        </ul>

        <a
          href="https://tidycal.com/angiepspeaks/experiencebooking"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Book your Zion Experience on TidyCal (opens in a new tab)"
          class="group mt-10 inline-flex items-center gap-2 px-8 py-4 rounded-full bg-angie-noir text-angie-cream font-Grotesk-bold transition-all duration-300 hover:bg-angie-burgundy hover:scale-[1.03]"
        >
          <span>Book Your Experience</span>
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ============================================================
      SERVICES — five included elements
  ============================================================ */}
  <section id="services" aria-labelledby="services-heading" class="w-full bg-angie-wine text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <header class="max-w-2xl timeline-view animate-range-entry animate-rise">
        <p class="text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">What's included</p>
        <h2 id="services-heading" class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-tight">Our Wellness Services</h2>
        <p class="mt-4 text-angie-cream/80 text-base md:text-lg leading-relaxed">
          Every Zion Experience includes these five elements, tailored to what you need that day. You choose what resonates — Angie guides the rest.
        </p>
      </header>

      <div class="mt-12 grid gap-4 md:gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { t: "Scratch Therapy", d: "Relieves tension and promotes deep relaxation." },
          { t: "Scalp Therapy", d: "Nourishes the scalp, improves circulation, and supports healthy hair." },
          { t: "Relaxing Music", d: "Soothing sounds to calm your mind and help you unwind." },
          { t: "3-Min Gratitude", d: "A guided moment to reset your mind and uplift your spirit." },
          { t: "Optional Prayer", d: "Available on request for peace, strength, and clarity." },
        ].map((s, i) => (
          <article class="group rounded-3xl border border-white/10 bg-white/5 p-7 transition-all duration-300 hover:-translate-y-1 hover:bg-white/10 hover:border-angie-rose/50 timeline-view animate-range-entry animate-rise">
            <span class="text-angie-rose/80 text-xs font-Grotesk-bold tracking-[0.25em]">0{i + 1}</span>
            <h3 class="mt-3 font-Frauce font-bold text-2xl">{s.t}</h3>
            <p class="mt-2 text-angie-cream/75 leading-relaxed">{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      HOW IT WORKS — four numbered steps
  ============================================================ */}
  <section id="how-it-works" aria-labelledby="how-heading" class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <header class="max-w-2xl mx-auto text-center timeline-view animate-range-entry animate-rise">
        <h2 id="how-heading" class="font-Frauce font-bold text-3xl md:text-5xl leading-tight">How the Zion Experience Works</h2>
        <p class="mt-4 text-angie-noir/70 text-base md:text-lg">From booking to relaxation in four simple steps. No stress, no surprises.</p>
      </header>

      <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { n: "01", t: "Book Online", d: "Reserve your spot with a $20 deposit. Takes about 2 minutes." },
          { n: "02", t: "Angie Reaches Out", d: "Within 24 hours, Angie personally contacts you to confirm details." },
          { n: "03", t: "Confirm Location", d: "We verify your address is within our 20-mile Lemoyne service radius." },
          { n: "04", t: "Experience Peace", d: "Angie arrives at your home. You breathe. You reset. You deserve it." },
        ].map((s) => (
          <li class="timeline-view animate-range-entry animate-rise">
            <p class="font-Frauce italic font-bold text-6xl text-angie-burgundy/30 leading-none">{s.n}</p>
            <h3 class="mt-3 font-Frauce font-bold text-xl">{s.t}</h3>
            <p class="mt-2 text-angie-noir/70 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ============================================================
      ABOUT ANGIE — bio + credentials (E-E-A-T)
  ============================================================ */}
  <section id="about-angie" aria-labelledby="about-heading" class="w-full bg-angie-burgundy text-angie-cream">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-5 timeline-view animate-range-entry animate-zoom-in">
        <img
          src="/images/angie-practitioner.webp"
          alt="Angie Pichardo — Wellness Practitioner and Life Purpose Coach, founder of Zion Lounge"
          width="1280"
          height="1280"
          loading="lazy"
          decoding="async"
          class="w-full max-w-sm mx-auto aspect-square object-cover rounded-[2rem] border border-white/20 shadow-2xl shadow-black/40"
        />
      </div>
      <div class="md:col-span-7 timeline-view animate-range-entry animate-rise">
        <p class="text-angie-rose uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">Meet Your Practitioner</p>
        <h2 id="about-heading" class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-tight">Hi, I'm Angie Pichardo.</h2>
        <p class="mt-5 text-angie-cream/85 text-base md:text-lg leading-relaxed">
          I'm a certified <strong>Wellness Practitioner</strong> and <strong>Life Purpose Coach</strong>, and the founder of <strong>Zion Lounge</strong>. I created the Zion Experience to give women in central Pennsylvania a place to exhale — without leaving home.
        </p>
        <p class="mt-4 text-angie-cream/85 text-base md:text-lg leading-relaxed">
          I bring the full wellness experience to your home, office, or private event — anywhere within 20 miles of Lemoyne. My approach is rooted in faith, peace, and the belief that <em>self-care isn't selfish — it's stewardship.</em>
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {["Certified Wellness Practitioner", "Life Purpose Coach", "Founder, Zion Lounge"].map((b) => (
            <li class="px-4 py-2 rounded-full border border-white/25 bg-white/10 text-sm font-Grotesk-bold">{b}</li>
          ))}
        </ul>
        <a
          href="tel:+17172980240"
          aria-label="Call or text Angie at 717-298-0240"
          class="mt-8 inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-angie-cream text-angie-noir font-Grotesk-bold transition-all duration-300 hover:bg-white hover:scale-[1.03]"
        >
          <span>Have a question? Text me directly</span>
        </a>
      </div>
    </div>
  </section>

  {/* ============================================================
      SERVICE AREA — cities + interactive Leaflet map
  ============================================================ */}
  <section id="service-area" aria-labelledby="area-heading" class="w-full bg-angie-cream text-angie-noir">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <header class="max-w-2xl timeline-view animate-range-entry animate-rise">
        <p class="text-angie-burgundy uppercase tracking-[0.3em] text-[11px] md:text-xs font-Grotesk-bold">Where We Come to You</p>
        <h2 id="area-heading" class="mt-3 font-Frauce font-bold text-3xl md:text-5xl leading-tight">Serving Lemoyne, PA and Within 20 Miles</h2>
        <p class="mt-4 text-angie-noir/70 text-base md:text-lg leading-relaxed">
          Mobile wellness delivered to your home, office, or private event across central Pennsylvania. Not sure if you're in our area? Just text Angie.
        </p>
      </header>

      <div class="mt-12 grid lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-5">
          <p class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-angie-burgundy text-angie-cream text-sm font-Grotesk-bold">
            <span aria-hidden="true">●</span> Lemoyne, PA — Headquarters
          </p>
          <ul class="mt-5 grid grid-cols-2 gap-3">
            {[
              ["Harrisburg", "~3 mi"], ["Camp Hill", "~3 mi"], ["New Cumberland", "~4 mi"], ["Mechanicsburg", "~8 mi"],
              ["Steelton", "~5 mi"], ["Shiremanstown", "~7 mi"], ["Wormleysburg", "~4 mi"], ["Enola", "~6 mi"],
            ].map(([city, dist]) => (
              <li class="rounded-2xl bg-white border border-angie-burgundy/10 px-4 py-3">
                <p class="font-Grotesk-bold">{city}</p>
                <p class="text-sm text-angie-noir/60">{dist}</p>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-angie-noir/70">Not sure if you're in our service area?</p>
          <a
            href="tel:+17172980240"
            aria-label="Text Angie at 717-298-0240 to check your service area"
            class="mt-3 inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-angie-noir text-angie-cream font-Grotesk-bold transition-all duration-300 hover:bg-angie-burgundy"
          >
            <span>Text Angie: 717-298-0240</span>
          </a>
        </div>

        <div class="lg:col-span-7">
          <div
            id="service-map"
            role="region"
            aria-label="Interactive service area map centered on Lemoyne, PA with a 20-mile radius"
            class="relative z-0 w-full h-[340px] md:h-[480px] rounded-3xl overflow-hidden border border-angie-burgundy/15 shadow-xl shadow-angie-burgundy/10"
          ></div>
          <p class="mt-3 text-xs text-angie-noir/60 flex flex-wrap gap-x-5 gap-y-1">
            <span>● 20-mile service radius</span>
            <span>● Zion Lounge — Lemoyne, PA</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      FAQ
  ============================================================ */}
  <section id="faq" aria-labelledby="faq-heading" class="w-full bg-angie-noir text-angie-cream">
    <div class="max-w-3xl mx-auto px-6 py-20 md:py-28">
      <header class="mb-10 timeline-view animate-range-entry animate-rise">
