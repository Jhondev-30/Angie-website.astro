<script>
  // Phone reveal: 1er click → muestra el número, 2do click → marca
  const phoneBtn = document.querySelector<HTMLButtonElement>('[data-phone-toggle]');
  if (phoneBtn) {
    const label = phoneBtn.querySelector<HTMLSpanElement>('[data-phone-label]');
    const sr = phoneBtn.querySelector<HTMLSpanElement>('[data-phone-sr]');
    const iconDefault = phoneBtn.querySelector<SVGElement>('[data-phone-icon-default]');
    const iconRevealed = phoneBtn.querySelector<SVGElement>('[data-phone-icon-revealed]');
    const phoneE164 = phoneBtn.dataset.phoneNumber ?? '';
    const phoneDisplay = phoneBtn.dataset.phoneDisplay ?? '';

    phoneBtn.addEventListener('click', () => {
      const expanded = phoneBtn.getAttribute('aria-expanded') === 'true';

      if (!expanded) {
        if (label) label.textContent = phoneDisplay;
        if (sr) sr.textContent = `Call ${phoneDisplay}`;
        iconDefault?.classList.add('hidden');
        iconRevealed?.classList.remove('hidden');
        phoneBtn.setAttribute('aria-expanded', 'true');
        phoneBtn.setAttribute('aria-label', `Call ${phoneDisplay}`);
      } else {
        // Segundo click: abre el dialer
        if (phoneE164) window.location.href = `tel:${phoneE164}`;
      }
    });
  }
</script>