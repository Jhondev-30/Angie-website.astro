---
import MainHead from "../components/MainHead.astro";
import "../styles/global.css";
import MainFooter from "../components/MainFooter.astro";
import NavBar from "../components/NavBar.astro";
import ClientRouter from "astro/components/ClientRouter.astro";

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  keywords = [],
  image,
  type = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <MainHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      keywords={keywords}
      image={image}
      type={type}
    />
    <ClientRouter />
  </head>
  <body
    class="body-fixed-gradient flex flex-col items-center font-Grotesk min-h-dvh overflow-x-hidden"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-1000 btn btn-light focus:outline-3 focus:outline-offset-2 focus:outline-angie-rose"
    >
      Skip to content
    </a>
    <NavBar />
    <main id="main" tabindex="-1" class="flex w-full flex-col items-center outline-none">
      <slot />
    </main>
    <MainFooter />
  </body>
</html>
